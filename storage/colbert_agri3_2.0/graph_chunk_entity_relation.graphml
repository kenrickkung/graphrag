      <data key="d0">Providence, Rhode Island</data>
      <data key="d1">geo</data>
      <data key="d2">"The capital city of Rhode Island, mentioned as a location in the text."&gt;&lt;SEP&gt;Providence, Rhode Island, is the city where the Southside Community Land Trust (SCLT) was founded in 1981 and operates its urban agriculture programs.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82&lt;SEP&gt;chunk-60121fd34d6b068a55f53ef625e1f266</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Urban Edge Farm">
      <data key="d0">Urban Edge Farm</data>
      <data key="d1">organization</data>
      <data key="d2">Urban Edge Farm is a 50-acre state-preserved farm managed by the Southside Community Land Trust (SCLT). It serves as an incubator for new farmers, hosting seven farm businesses that use a collaborative model for the farm's management and upkeep.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
