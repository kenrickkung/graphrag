      <data key="d1">organization</data>
      <data key="d2">"The magazine where Chuck DeCourley worked as a promotions director before he left his job to pursue a full-time career in farming."&gt;</data>
      <data key="d3">chunk-7e2a281158355949bfa9c35a51c5622a</data>
