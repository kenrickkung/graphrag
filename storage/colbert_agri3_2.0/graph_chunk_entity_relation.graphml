      <data key="d11">1753740472</data>
    </edge>
    <edge source="Foraging" target="Flowers">
      <data key="d6">10.0</data>
      <data key="d7">The event of Foraging is centered on exploiting Flowers (and other crops) to gather nectar, the primary resource sought.</data>
      <data key="d8">environment interaction,objective,resource source</data>
