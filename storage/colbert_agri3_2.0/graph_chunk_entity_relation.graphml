    <node id="Farm and Migrant Labor">
      <data key="d0">Farm and Migrant Labor</data>
      <data key="d1">category</data>
      <data key="d2">A specific social issue within the food system. The Food Project teaches teens that advocating for the rights and conditions of farm and migrant laborers is a way to create positive change.</data>
      <data key="d3">chunk-88b887765fabe568d174cfa581723af5</data>
