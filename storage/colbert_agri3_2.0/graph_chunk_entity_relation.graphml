    </edge>
    <edge source="Pesticides" target="Beekeeping Community">
      <data key="d6">9.0</data>
      <data key="d7">The beekeeping community must actively defend their honey bees from the threat of pesticides, with avoidance of sprayed areas being a primary strategy.</data>
      <data key="d8">agricultural conflict,protection,threat management</data>
      <data key="d9">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740508</data>
    </edge>
    <edge source="Pesticides" target="Beekeeper">
      <data key="d6">9.0</data>
      <data key="d7">The beekeeper must constantly defend against the threat of pesticides by choosing hive locations carefully and taking emergency measures like confinement when necessary.</data>
      <data key="d8">defense strategy,mitigation,risk management</data>
      <data key="d9">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
