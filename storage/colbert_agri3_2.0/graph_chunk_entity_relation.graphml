      <data key="d0">Sally Eason's Husband</data>
      <data key="d1">person</data>
      <data key="d2">A member of the Eason family who works at Sunburst Trout Farm as part of its core family staff.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Sally Eason's Two Sons">
      <data key="d0">Sally Eason's Two Sons</data>
      <data key="d1">person</data>
      <data key="d2">Members of the Eason family's third generation who work alongside their parents at the Sunburst Trout Farm.</data>
