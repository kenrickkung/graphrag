      <data key="d11">1753740472</data>
    </edge>
    <edge source="Nectar Flow" target="Syrup">
      <data key="d6">8.0</data>
      <data key="d7">Syrup is described as an artificial substitute for a natural nectar flow, triggering the same productive responses from the bees.</data>
      <data key="d8">food source,simulation,substitute</data>
      <data key="d9">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
