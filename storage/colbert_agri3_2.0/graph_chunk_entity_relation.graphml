      <data key="d11">1753740472</data>
    </edge>
    <edge source="Pollen" target="Food Stores">
      <data key="d6">9.0</data>
      <data key="d7">"Pollen is a critical component of the winter food stores, alongside honey, as it is a necessary part of the bees' diet required for brood rearing."&gt;</data>
      <data key="d8">colony nutrition,winter survival</data>
      <data key="d9">chunk-59970fe46f1c3b11508247730ae6145d</data>
