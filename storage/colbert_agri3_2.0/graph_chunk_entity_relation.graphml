      <data key="d1">category</data>
      <data key="d2">A type of chemical mentioned alongside insecticides, fungicides, and miticides, which can have varied effects on honey bees.</data>
      <data key="d3">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
      <data key="d4">unknown_source</data>
