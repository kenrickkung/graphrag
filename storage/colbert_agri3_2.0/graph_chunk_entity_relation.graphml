      <data key="d0">CSA subscription farm</data>
      <data key="d1">category</data>
      <data key="d2">"A farm business model (Community Supported Agriculture) that is mentioned as one of the concepts that a 'Food Circle' is based on."&gt;</data>
      <data key="d3">chunk-3eba3a070130b55e2912440d8aaca3d2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740814</data>
    </node>
    <node id="Cooperative">
      <data key="d0">Cooperative</data>
      <data key="d1">category</data>
      <data key="d2">"A business organization where members pool resources. It is mentioned in comparison to Food Circles, which have an advantage over traditional cooperatives by not requiring a farmer to produce a set volume of goods."&gt;&lt;SEP&gt;"A business structure that is mentioned as one of the concepts that a 'Food Circle' is based on, where a group pools produce and resources."&gt;&lt;SEP&gt;A Cooperative is a business model where multiple small-scale farmers pool their products to market them under a single brand. This model helps farmers access larger markets by centralizing logistics, marketing, and transportation.</data>
      <data key="d3">chunk-3eba3a070130b55e2912440d8aaca3d2&lt;SEP&gt;chunk-4fa81fea1066bfc4f1fbbd063489245c&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
