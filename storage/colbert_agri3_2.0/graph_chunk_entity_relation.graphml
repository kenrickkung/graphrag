    <node id="Cuenta Con Migo">
      <data key="d0">Cuenta Con Migo</data>
      <data key="d1">organization</data>
      <data key="d2">A youth gardening program for children ages 7 to 12, started by Rivera. It grew from 12 to 25 children in its first year, with graduates now teaching younger kids about gardening.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
