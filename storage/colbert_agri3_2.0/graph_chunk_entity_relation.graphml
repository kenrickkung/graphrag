      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Eggmobile" target="Pastured Poultry System">
      <data key="d6">9.0</data>
      <data key="d7">The Eggmobile is the key invention that makes the Pastured Poultry System possible, serving as the portable henhouse for chickens on pasture.</data>
      <data key="d8">enabling technology,system component</data>
      <data key="d9">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Eggmobile" target="Feathernet">
      <data key="d6">8.0</data>
      <data key="d7">The Feathernet is an improved successor to the Eggmobile, representing an evolution in Joel Salatin's poultry housing designs.</data>
      <data key="d8">innovation,technological succession</data>
      <data key="d9">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Eggmobile" target="Cows">
      <data key="d6">10.0</data>
      <data key="d7">The Polyface Farm system is defined by the relationship where chickens in the Eggmobile follow the cows in pasture rotation to sanitize the fields by eating fly larvae from manure.</data>
      <data key="d8">ecological system,symbiotic rotation</data>
      <data key="d9">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d10">unknown_source</data>
