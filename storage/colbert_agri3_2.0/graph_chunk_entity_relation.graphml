    <node id="Fukuoka, Masanobu">
      <data key="d0">Fukuoka, Masanobu</data>
      <data key="d1">person</data>
      <data key="d2">Masanobu Fukuoka is a person mentioned in the text, likely a notable figure in the field of farming or agriculture.</data>
      <data key="d3">chunk-a464eab8eee71e80f3498a79e8163ee7</data>
      <data key="d4">unknown_source</data>
