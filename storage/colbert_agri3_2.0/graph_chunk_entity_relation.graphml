    </edge>
    <edge source="Jonathan Yazzie" target="Cultural Heritage">
      <data key="d6">9.0</data>
      <data key="d7">Jonathan Yazzie's efforts to restore farming are a direct response to the threat against his cultural heritage, aiming to bring a vital tradition 'forward into our future'.</data>
      <data key="d8">community activism,heritage restoration</data>
      <data key="d9">chunk-51fe95d161b4f1f67e45381ccbc2d83e</data>
      <data key="d10">unknown_source</data>
