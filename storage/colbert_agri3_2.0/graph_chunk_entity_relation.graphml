      <data key="d0">Food Guide Pyramid</data>
      <data key="d1">category</data>
      <data key="d2">A well-known model representing the dietary guidelines established by U.S. government health departments. The text notes that very few children's diets align with these guidelines.</data>
      <data key="d3">chunk-04be01c6169d0bdd92b10dca615a3936</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Parent Education">
      <data key="d0">Parent Education</data>
      <data key="d1">category</data>
      <data key="d2">A component of the Farm to School program designed to extend learning into the home. It ensures health messages are reinforced by parents and caregivers through shopping and cooking tips.</data>
      <data key="d3">chunk-04be01c6169d0bdd92b10dca615a3936</data>
