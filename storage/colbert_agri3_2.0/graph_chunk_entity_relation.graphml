    <edge source="Pesticides" target="Honey Bees">
      <data key="d6">18.0</data>
      <data key="d7">Pesticides are identified as a significant threat to honey bee health and survival.&lt;SEP&gt;Pesticides represent a significant threat to the health and survival of honey bee populations, even through unintentional exposure.</data>
      <data key="d8">bee mortality,chemical exposure,chemical risk,colony threat,environmental hazard,environmental threat</data>
      <data key="d9">chunk-ee2dbfbb5c1a5664034bad31b4143c62&lt;SEP&gt;chunk-4ff2a1270133813dbf92927fcbf14a3c</data>
