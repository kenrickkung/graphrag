    </edge>
    <edge source="Package Lid" target="Tools">
      <data key="d6">8.0</data>
      <data key="d7">A tool, implied to be a prying instrument, is used to remove the package lid from its fasteners.</data>
      <data key="d8">access,manipulation</data>
      <data key="d9">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
