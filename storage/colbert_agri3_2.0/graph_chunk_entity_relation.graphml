    <node id="Ward Cheney">
      <data key="d0">Ward Cheney</data>
      <data key="d1">person</data>
      <data key="d2">An individual mentioned in the index.&lt;SEP&gt;The founder of The Food Project in 1991. Described as a farmer, organizer, educator, and activist, he created the organization based on his vision to connect isolated teens from different backgrounds with the land and meaningful work.</data>
      <data key="d3">chunk-07d81959e2e7dfd429fb34ce74beae5e&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
