    <node id="ForageSF">
      <data key="d0">ForageSF</data>
      <data key="d1">organization</data>
      <data key="d2">Based in San Francisco, ForageSF is a wild-foods advocacy group founded by Iso Rabins in 2008. The organization's mission is to educate people and connect Bay Area residents with wild foods, aiming to establish foraging as a viable commercial and backyard endeavor. To achieve this, ForageSF organizes various activities, including tours, wild-food walks, classes, and workshops. It also operates a community-supported foraging (CSF) delivery service and The Underground Market.</data>
      <data key="d3">chunk-d6db795582f52e35a0bb9aea86e66f7f&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-7b79b32f16bacae95e48f2f51ab5dee0&lt;SEP&gt;chunk-3dbce12e45fe13ef4f6973f92e57e779</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740810</data>
    </node>
    <node id="The Underground Market">
      <data key="d0">The Underground Market</data>
      <data key="d1">organization</data>
      <data key="d2">"A private, members-only club created by ForageSF. It serves as a marketplace for foragers and at-home food producers to sell their goods."&gt;&lt;SEP&gt;An entity, likely an alternative or informal food market.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-3dbce12e45fe13ef4f6973f92e57e779</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740812</data>
    </node>
    <node id="Iso Rabins">
      <data key="d0">Iso Rabins</data>
      <data key="d1">person</data>
      <data key="d2">"A representative for ForageSF."&gt;&lt;SEP&gt;"An entrepreneur who founded the wild-foods advocacy group ForageSF in 2008 with the goal of reestablishing foraging in the San Francisco Bay Area food system."&gt;&lt;SEP&gt;Iso Rabins is the founder of ForageSF and the creator of the Underground Market in San Francisco. He is an advocate for foraging wild foods, aiming to build a local food economy and establish foraging as a sustainable occupation.</data>
      <data key="d3">chunk-d6db795582f52e35a0bb9aea86e66f7f&lt;SEP&gt;chunk-f188db350c6a6f2fdb22a9e9283e4dc3&lt;SEP&gt;chunk-3dbce12e45fe13ef4f6973f92e57e779</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740812</data>
    </node>
