    </edge>
    <edge source="Brood Nest" target="Hive Inspection">
      <data key="d6">9.0</data>
      <data key="d7">A key purpose of an internal hive inspection is to examine the brood nest to confirm it is expanding, which indicates a healthy, growing colony.</data>
