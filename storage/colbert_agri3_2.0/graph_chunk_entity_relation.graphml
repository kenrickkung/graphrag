      <data key="d5">1753740833</data>
    </node>
    <node id="Market-gardening project">
      <data key="d0">Market-gardening project</data>
      <data key="d1">category</data>
      <data key="d2">A program model, exemplified by a pilot project at Marra Farm in Seattle, designed to allow low-income individuals to use public land to grow food on a larger scale than a typical community garden plot and sell the produce for supplemental income.</data>
      <data key="d3">chunk-959e33ece6a9fc720452b33659ca7996</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740833</data>
    </node>
