    <node id="Greater Providence Urban Agriculture Task Force">
      <data key="d0">Greater Providence Urban Agriculture Task Force</data>
      <data key="d1">organization</data>
      <data key="d2">The Greater Providence Urban Agriculture Task Force is a 50-member citywide coalition founded by SCLT in 2004. It assists SCLT with its goal of expanding its garden network.&lt;SEP&gt;The Greater Providence Urban Agriculture Task Force is a 50-member citywide coalition in Providence that was founded by the Southside Community Land Trust (SCLT) to support and share information about urban agriculture.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82&lt;SEP&gt;chunk-603aed086b5eda0ec62eae7fa8c0f1b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Eminent Domain">
      <data key="d0">Eminent Domain</data>
      <data key="d1">category</data>
      <data key="d2">Eminent Domain is a legal principle allowing a government to seize private property for public use with compensation. The text presents it as a significant, ongoing threat to the permanent protection of community gardens, even when they are owned by a land trust.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Redevelopment Plan of 1986">
      <data key="d0">Redevelopment Plan of 1986</data>
      <data key="d1">event</data>
      <data key="d2">A plan initiated by the City of Boston in 1986 for redevelopment that included bulldozing a community garden, which sparked organized community opposition.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Public Meeting">
      <data key="d0">Public Meeting</data>
      <data key="d1">event</data>
      <data key="d2">A key public meeting where approximately 300 community gardeners and public housing advocates gathered to protest the City of Boston's redevelopment plans, compelling city officials to reconsider.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="1991 Land Transfer">
      <data key="d0">1991 Land Transfer</data>
      <data key="d1">event</data>
      <data key="d2">The 1991 agreement in which the City of Boston transferred ownership of eight community gardens to the newly formed South End/Lower Roxbury Open Space Land Trust for a nominal fee of $1 each.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="SCLT City Farm">
      <data key="d0">SCLT City Farm</data>
      <data key="d1">organization</data>
      <data key="d2">A ¾-acre commercial and educational farm located in the city center of Providence, managed by the Southside Community Land Trust. It models biointensive agriculture, producing over 4,000 pounds of food annually.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Urban Agriculture Resource Center">
      <data key="d0">Urban Agriculture Resource Center</data>
      <data key="d1">organization</data>
      <data key="d2">A website and resource hub established by the Southside Community Land Trust to share information and best practices on topics relevant to urban agriculture, such as high-yield gardening and lead testing.&lt;SEP&gt;An informational website established by SCLT to share knowledge on high-yield urban gardening, lead testing, and other challenges specific to growing food in urban environments.</data>
      <data key="d3">chunk-a170afca78fc7741f470417682836f82&lt;SEP&gt;chunk-603aed086b5eda0ec62eae7fa8c0f1b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
