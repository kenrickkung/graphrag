    <node id="North Portland">
      <data key="d0">North Portland</data>
      <data key="d1">geo</data>
      <data key="d2">North Portland is a district that contains both the St. Johns Woods community and the New Columbia development. It is a key geographical area for Janus Youth's community gardening projects.</data>
