    <node id="Community-supported Agriculture (CSA)">
      <data key="d0">Community-supported Agriculture (CSA)</data>
      <data key="d1">category</data>
      <data key="d2">"Community-Supported Agriculture (CSA) is a food production and distribution model where community members buy 'shares' in a farm's produce. The model got its start in North America in 1986 and aims to build relationships between consumers and farmers."&gt;</data>
      <data key="d3">chunk-951f3a20705ad68da0aafd6377f51f52</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740817</data>
