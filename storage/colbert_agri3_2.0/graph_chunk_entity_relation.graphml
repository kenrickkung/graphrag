      <data key="d10">unknown_source</data>
      <data key="d11">1753740867</data>
    </edge>
    <edge source="New Zealand" target="Alfalfa">
      <data key="d6">7.0</data>
      <data key="d7">The text mentions that on irrigated alfalfa in New Zealand, management-intensive grazing has achieved yields close to 2,000 pounds of beef per acre.</data>
