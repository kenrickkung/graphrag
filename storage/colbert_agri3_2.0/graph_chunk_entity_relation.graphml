    </edge>
    <edge source="Lynchburg Grows" target="Composting Program">
      <data key="d6">9.0</data>
      <data key="d7">Lynchburg Grows established its Composting Program to solve a soil quality problem, turning it into a successful, large-scale operation.</data>
      <data key="d8">problem-solving,resource creation</data>
      <data key="d9">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
