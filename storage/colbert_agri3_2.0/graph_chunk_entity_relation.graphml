    <node id="The Trust For Public Land (Tpl)">
      <data key="d0">The Trust For Public Land (Tpl)</data>
      <data key="d1">organization</data>
      <data key="d2">A national organization that played a key role in saving 62 community gardens in New York City from auction in 1999. It later created three separate nonprofits to own and manage these gardens.</data>
      <data key="d3">chunk-c0b1f6adc63dbe7f3160ab5bd7b25233</data>
