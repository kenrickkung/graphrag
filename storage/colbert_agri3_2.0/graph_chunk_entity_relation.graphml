    <node id="American Community Gardening Association (ACGA)">
      <data key="d0">American Community Gardening Association (ACGA)</data>
      <data key="d1">organization</data>
      <data key="d2">An association created in 1979 as a result of the grassroots, community-driven gardening movement of the 1970s to exert political and social influence.&lt;SEP&gt;An association dedicated to promoting and supporting community gardening across the nation.</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-43ebc646508b0f93fb43f529856b4d56</data>
