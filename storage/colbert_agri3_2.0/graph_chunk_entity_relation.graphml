      <data key="d10">unknown_source</data>
      <data key="d11">1753740499</data>
    </edge>
    <edge source="Inspecting The Hive" target="Bottom Board Inserts">
      <data key="d6">10.0</data>
      <data key="d7">Bottom board inserts are the primary tool used for the method of inspecting the hive, as they collect mites for detection without requiring direct handling of bees.</data>
