      <data key="d11">1753740508</data>
    </edge>
    <edge source="Honey Bee" target="African Honey Bee">
      <data key="d6">8.0</data>
      <data key="d7">The African Honey Bee is identified as a specific subspecies of the Honey Bee.</data>
      <data key="d8">species classification,taxonomy</data>
