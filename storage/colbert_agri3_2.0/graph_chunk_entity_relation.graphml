      <data key="d3">chunk-b52b5200e77354191139029d689fb62d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740807</data>
    </node>
    <node id="Vancouver">
      <data key="d0">Vancouver</data>
      <data key="d1">geo</data>
      <data key="d2">"A city in British Columbia that is home to the Rain City Grill, a restaurant that promotes local food sourcing."&gt;&lt;SEP&gt;A Canadian city that installed a demonstration hive on its city hall roof in 2010 as part of its goal to become the 'greenest city in the world'.&lt;SEP&gt;A city where 'bee condos' have been placed in parks to support urban bee colonies and where City Hall has become a 'hive of activity'.</data>
      <data key="d3">chunk-b52b5200e77354191139029d689fb62d&lt;SEP&gt;chunk-0ae240ee8f1e0681df991703ff2ca94b&lt;SEP&gt;chunk-475015ec5f08648d774910da2fb23967</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740807</data>
    </node>
    <node id="Allen Garr">
      <data key="d0">Allen Garr</data>
      <data key="d1">person</data>
      <data key="d2">The official beekeeper for the city of Vancouver, who tends hives across the city, including at the Vancouver Convention Centre.</data>
      <data key="d3">chunk-b52b5200e77354191139029d689fb62d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740807</data>
