    </edge>
    <edge source="Pollen" target="Fall Hive Inspections">
      <data key="d6">8.0</data>
      <data key="d7">"During fall hive inspections, the beekeeper must specifically look for and confirm the presence of a minimum of three or four frames of pollen to ensure the colony is prepared for winter."&gt;</data>
      <data key="d8">management task,resource check</data>
      <data key="d9">chunk-59970fe46f1c3b11508247730ae6145d</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Pollen" target="Frames">
