    <node id="Pastures and Cover Crops">
      <data key="d0">Pastures and Cover Crops</data>
      <data key="d1">category</data>
      <data key="d2">A subject category for books focused on the management of forages, pastures, grazing systems, and the profitable use of cover crops.</data>
