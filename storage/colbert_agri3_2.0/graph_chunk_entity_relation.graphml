      <data key="d11">1753740472</data>
    </edge>
    <edge source="Bottom Board" target="Spring Chores">
      <data key="d6">8.0</data>
      <data key="d7">Cleaning the bottom board of debris is a specific and essential task included in the list of spring chores.</data>
      <data key="d8">hive cleaning,maintenance task</data>
