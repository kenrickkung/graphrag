      <data key="d0">Chuck Decourley</data>
      <data key="d1">person</data>
      <data key="d2">"A former promotions director for _Small Farm Today_ magazine from Columbia, Missouri. He is featured as a success story for starting a profitable farm by raising emus, which he bought at low prices after the ratite market collapsed, and selling add-on value products."&gt;</data>
      <data key="d3">chunk-7e2a281158355949bfa9c35a51c5622a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740810</data>
    </node>
