    <node id="Strength-Based Approach">
      <data key="d0">Strength-Based Approach</data>
      <data key="d1">category</data>
      <data key="d2">A methodology applied to community gardening that focuses on identifying and utilizing a community's existing strengths, skills, and assets, rather than focusing on its problems or needs.</data>
      <data key="d3">chunk-1a815073ae837fa29833af41e55990ca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
