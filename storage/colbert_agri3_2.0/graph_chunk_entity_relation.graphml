    </edge>
    <edge source="Local Food System" target="Industrialized System of Aggregation and Distribution">
      <data key="d6">9.0</data>
      <data key="d7">The local food system is presented as a direct alternative to the industrialized system, aiming to support small farmers who are excluded from or challenged by the large-scale network.</data>
      <data key="d8">alternative model,economic opposition,systemic contrast</data>
      <data key="d9">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d10">unknown_source</data>
