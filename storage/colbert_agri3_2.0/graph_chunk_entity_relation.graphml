    </node>
    <node id="Higher-Education Curricula">
      <data key="d0">Higher-Education Curricula</data>
      <data key="d1">category</data>
      <data key="d2">Refers to the integration of the food movement into academic programs at colleges and universities, training students to think critically about food systems, agriculture, nutrition, and social justice.</data>
      <data key="d3">chunk-a80590371c3ba416132df035a1f48358</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740851</data>
    </node>
    <node id="Institutional Change">
      <data key="d0">Institutional Change</data>
      <data key="d1">category</data>
      <data key="d2">The concept that the adoption of local food purchasing by colleges represents a deep, systemic shift in how institutions operate, rather than a temporary trend. It requires perseverance, new relationships, and patience.</data>
      <data key="d3">chunk-a80590371c3ba416132df035a1f48358</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740851</data>
    </node>
