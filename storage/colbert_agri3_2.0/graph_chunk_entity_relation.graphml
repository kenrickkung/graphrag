    <edge source="Gardening" target="Food System">
      <data key="d6">9.0</data>
      <data key="d7">Gardening is presented as a personal and community-based response and alternative to the perceived failings of the large-scale industrial food system.</data>
      <data key="d8">alternative,critique,solution</data>
      <data key="d9">chunk-727af20c5834776e4c44ee5e64fd02aa</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Gardening" target="Dan Barker">
      <data key="d6">10.0</data>
      <data key="d7">Dan Barker is a passionate advocate and practitioner of home gardening, having been responsible for the creation of thousands of free gardens for those in need.</data>
      <data key="d8">activism,advocacy,community service</data>
      <data key="d9">chunk-727af20c5834776e4c44ee5e64fd02aa</data>
