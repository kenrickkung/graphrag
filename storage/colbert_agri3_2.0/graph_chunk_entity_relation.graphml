      <data key="d10">unknown_source</data>
      <data key="d11">1753740514</data>
    </edge>
    <edge source="Honey" target="USDA, National Agricultural Statistics Service">
      <data key="d6">10.0</data>
      <data key="d7">The USDA, National Agricultural Statistics Service published a statistical report on the topic of Honey.</data>
      <data key="d8">agricultural statistics,data publication</data>
