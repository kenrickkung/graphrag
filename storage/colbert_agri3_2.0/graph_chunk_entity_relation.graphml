      <data key="d11">1753740869</data>
    </edge>
    <edge source="Forage" target="Forage Information System">
      <data key="d6">10.0</data>
      <data key="d7">The Forage Information System is a resource specifically dedicated to providing information on Forage.</data>
      <data key="d8">content focus,subject matter expertise</data>
      <data key="d9">chunk-66bbc17b9fd4fb132a3a76abd2df0690</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Stings" target="Honey Bees">
      <data key="d6">10.0</data>
      <data key="d7">Honey bees sting as a fundamental defensive behavior to protect their colony and their stored honey from predators and other threats.</data>
      <data key="d8">behavior,defense mechanism,survival</data>
