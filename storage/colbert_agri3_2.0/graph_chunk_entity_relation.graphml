      <data key="d1">person</data>
      <data key="d2">An author of influential essays on sustainable agriculture, with two books, 'The Gift of Good Land' and 'The Unsettling of America', listed in the 'Inspirational' category.</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Marketing Methods">
      <data key="d0">Marketing Methods</data>
      <data key="d1">category</data>
      <data key="d2">A subject category for books on agricultural business models, including rural businesses, farm diversification, and Community Supported Agriculture (CSA).</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
