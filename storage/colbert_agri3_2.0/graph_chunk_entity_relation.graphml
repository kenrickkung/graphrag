      <data key="d11">1753740472</data>
    </edge>
    <edge source="Hive Frames" target="Hive Body">
      <data key="d6">10.0</data>
      <data key="d7">A hive body is the box that contains the set of hive frames where the colony lives and works.</data>
      <data key="d8">component relationship,containment,hive structure</data>
      <data key="d9">chunk-a2b5f69931d3a60795392f1cd07c4c3a</data>
