    </edge>
    <edge source="Honey Bee" target="Absconding">
      <data key="d6">9.0</data>
      <data key="d7">Absconding is a behavioral event in which an entire honey bee colony leaves its hive.</data>
      <data key="d8">colony behavior,survival strategy</data>
      <data key="d9">chunk-13ca632d7241d4efd7901ef6c477cffc</data>
      <data key="d10">unknown_source</data>
