    <node id="National Farm to School Network (NFSN)">
      <data key="d0">National Farm to School Network (NFSN)</data>
      <data key="d1">organization</data>
      <data key="d2">A national advocacy group that supports and promotes Farm to School programs. The NFSN facilitates training, develops and shares information, advocates for policy, and builds networks at local, state, and national levels.</data>
      <data key="d3">chunk-fef6f9e3cdaa27cfe32361bcab20e464</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
