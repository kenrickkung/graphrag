      <data key="d1">person</data>
      <data key="d2">A local beekeeper who installed hives on Chicago's city hall and went on to found the Chicago Honey Co-op in 2004.&lt;SEP&gt;An individual named in the text.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-b52b5200e77354191139029d689fb62d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740807</data>
    </node>
    <node id="Chicago Honey Co-op">
      <data key="d0">Chicago Honey Co-op</data>
      <data key="d1">organization</data>
      <data key="d2">A beekeeping operation founded in Chicago by Michael Thompson that manages over 60 hives, runs a honey CSA, and provides jobs to underemployed people.&lt;SEP&gt;A honey co-op with a listed website, profiled as a key organization in the text.</data>
      <data key="d3">chunk-b52b5200e77354191139029d689fb62d&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e</data>
