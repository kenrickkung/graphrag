      <data key="d0">Economic Development Commission</data>
      <data key="d1">organization</data>
      <data key="d2">The Economic Development Commission is a local government agency suggested as a resource for farmers needing help to develop a business plan and marketing tools.</data>
      <data key="d3">chunk-626a48dbfe67b1f55d1d46c5b8d30097</data>
      <data key="d4">unknown_source</data>
