      <data key="d10">unknown_source</data>
      <data key="d11">1753740857</data>
    </edge>
    <edge source="The Author" target="Author's Farm">
      <data key="d6">10.0</data>
      <data key="d7">The author owns and operates an 80-acre farm, using it for research to demonstrate the potential profitability of small-scale agriculture.</data>
      <data key="d8">ownership,research site</data>
