    <node id="Voltaire">
      <data key="d0">Voltaire</data>
      <data key="d1">person</data>
      <data key="d2">A philosopher whose character, Candide, is mentioned as an example of someone who, when despairing over the human condition, decided to 'cultivate his own garden' as a solution.</data>
      <data key="d3">chunk-727af20c5834776e4c44ee5e64fd02aa</data>
