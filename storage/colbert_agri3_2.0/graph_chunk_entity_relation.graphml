    </edge>
    <edge source="Diablo Burger" target="Ranching">
      <data key="d6">10.0</data>
      <data key="d7">The entire business concept of Diablo Burger is to support local ranching by providing a direct, value-added market for their beef.</data>
      <data key="d8">economic support,supply chain</data>
