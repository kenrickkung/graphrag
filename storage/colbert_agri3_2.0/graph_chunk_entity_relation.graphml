    </node>
    <node id="Mcclendon's Select">
      <data key="d0">Mcclendon's Select</data>
      <data key="d1">organization</data>
      <data key="d2">McClendon's Select is an organic farm located in Peoria, near Phoenix. It supplies produce to restaurants in Flagstaff and participates in a pooled delivery system by preparing a preordered pallet for them.</data>
