    </node>
    <node id="Internet">
      <data key="d0">Internet</data>
      <data key="d1">category</data>
      <data key="d2">"The Internet is identified as a tool for farmers, enabling email communication and access to downloadable information like grazing tips, recipes, and site plans."&gt;</data>
      <data key="d3">chunk-f6b34a5b7dc86e95b65f36512f72980b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740829</data>
    </node>
    <node id="Equipment Rental And Leasing">
      <data key="d0">Equipment Rental And Leasing</data>
      <data key="d1">category</data>
      <data key="d2">"Equipment Rental and Leasing is a strategy discussed for small farmers to access necessary machinery without the high cost of ownership. The text suggests considering availability and logistics."&gt;</data>
      <data key="d3">chunk-f6b34a5b7dc86e95b65f36512f72980b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740829</data>
