    <node id="Cornell University">
      <data key="d0">Cornell University</data>
      <data key="d1">organization</data>
      <data key="d2">Cornell University is an educational institution that is home to the Northeast Regional Agricultural Engineering Services, which published a guide on farm equipment.&lt;SEP&gt;The university that houses and operates the Cornell Farm to School Program.</data>
      <data key="d3">chunk-9d20bcb040d48598530ec2b7c42edba7&lt;SEP&gt;chunk-9e716e5bd5f06009e0468b77709b834d</data>
