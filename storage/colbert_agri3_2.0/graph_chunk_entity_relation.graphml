    </edge>
    <edge source="Small Farms" target="Tractor">
      <data key="d6">9.0</data>
      <data key="d7">The text explicitly recommends a 30- to 50-horsepower tractor as suitable for most small farms.</data>
      <data key="d8">equipment recommendation,farm scale</data>
