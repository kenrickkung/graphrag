    </edge>
    <edge source="Comb" target="Nectar/Syrup">
      <data key="d6">8.0</data>
      <data key="d7">A steady supply of Nectar/Syrup is a prerequisite for building Comb, as it stimulates the wax glands of worker bees.</data>
      <data key="d8">fuel,production,resource requirement</data>
      <data key="d9">chunk-6706ffd7485284387c77b1f38a66ce9c</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Comb" target="Frame">
      <data key="d6">10.0</data>
      <data key="d7">Bees build their comb directly onto the frames, which provide the structure for the honeycomb.</data>
      <data key="d8">construction,structural support</data>
      <data key="d9">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Comb" target="Foundation">
      <data key="d6">9.0</data>
      <data key="d7">Bees build their wax comb onto the foundation provided within the frames.</data>
      <data key="d8">construction,structural base</data>
      <data key="d9">chunk-50100ec9bbd638fb693fc24eeb2b3110</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Comb" target="Hive Frames">
      <data key="d6">10.0</data>
      <data key="d7">Hive frames serve as the foundation upon which the bees build their comb.</data>
      <data key="d8">foundation,hive component,structure</data>
