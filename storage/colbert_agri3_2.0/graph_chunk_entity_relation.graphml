    </edge>
    <edge source="Pupa" target="Brood">
      <data key="d6">10.0</data>
      <data key="d7">The pupa is the third developmental stage of the brood, immediately preceding the emergence of the adult bee.</data>
      <data key="d8">development,life cycle</data>
