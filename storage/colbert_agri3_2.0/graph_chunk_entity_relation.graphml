    <edge source="Researchers" target="Africanized Bees">
      <data key="d6">7.0</data>
      <data key="d7">Researchers are actively studying Africanized bees to provide new, crucial information that helps beekeepers, officials, and the public understand and deal with the problem.</data>
      <data key="d8">information discovery,knowledge generation,scientific study</data>
      <data key="d9">chunk-4ff2a1270133813dbf92927fcbf14a3c</data>
