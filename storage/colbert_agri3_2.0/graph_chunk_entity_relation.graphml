      <data key="d1">category</data>
      <data key="d2">A core operational strategy highlighted in the text, used by organizations like The Food Project and SEEDS Inc. to attract and retain teenage workers, especially from low-income backgrounds, while teaching valuable life skills like responsibility and financial management.</data>
      <data key="d3">chunk-8965f3e3965322fdf5c53aebddde1e14</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740840</data>
    </node>
