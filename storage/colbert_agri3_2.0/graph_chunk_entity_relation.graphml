    </edge>
    <edge source="Foraging" target="Receiving and Processing Nectar">
      <data key="d6">9.0</data>
      <data key="d7">The nectar gathered during foraging by field bees is brought back to the hive to be handled by house bees who perform the task of receiving and processing it.</data>
      <data key="d8">supply chain,task interdependence</data>
      <data key="d9">chunk-78182a0a75dac1ecf9d9f1cc16f3a0ff</data>
