    <node id="Farmers' markets">
      <data key="d0">Farmers' markets</data>
      <data key="d1">category</data>
      <data key="d2">Farmers' markets are cited as a major indicator of the grassroots food movement's growth, having increased threefold in the United States since 1995.</data>
      <data key="d3">chunk-51cfeabc3f21e3329484ec062ac1c4b2</data>
