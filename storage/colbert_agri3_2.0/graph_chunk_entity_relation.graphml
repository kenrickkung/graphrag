    </node>
    <node id="Conservation Commission">
      <data key="d0">Conservation Commission</data>
      <data key="d1">organization</data>
      <data key="d2">A local government body in Lincoln, Massachusetts, that has been a pioneer in wetlands regulation and land acquisition. It supports The Food Project by leasing two farms to the organization for a nominal fee.</data>
      <data key="d3">chunk-07d81959e2e7dfd429fb34ce74beae5e</data>
      <data key="d4">unknown_source</data>
