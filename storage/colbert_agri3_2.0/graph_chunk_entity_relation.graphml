      <data key="d11">1753740472</data>
    </edge>
    <edge source="Swarming" target="Swarm Impulse">
      <data key="d6">10.0</data>
      <data key="d7">The swarm impulse is the direct and compelling force that causes a colony to initiate the swarming event.</data>
