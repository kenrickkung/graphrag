    <edge source="Fossil Fuels" target="Industrial Food System">
      <data key="d6">10.0</data>
      <data key="d7">The industrial food system is characterized by its immense consumption of fossil fuels, requiring 10 calories of fossil fuel energy to produce one calorie of food.</data>
      <data key="d8">energy dependency,resource consumption</data>
      <data key="d9">chunk-0e066d43dafd3f92b15fb06eb4836e7c</data>
      <data key="d10">unknown_source</data>
