    <edge source="Diablo Burger" target="Derrick Widmark">
      <data key="d6">10.0</data>
      <data key="d7">Derrick Widmark is the founder and owner of the Diablo Burger restaurant. He created it to fulfill a specific mission related to local food systems.</data>
