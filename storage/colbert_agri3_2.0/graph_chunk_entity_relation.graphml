      <data key="d11">1753740472</data>
    </edge>
    <edge source="Bee Sting" target="Tolerance">
      <data key="d6">8.0</data>
      <data key="d7">For some people, repeated bee stings lead to the development of a tolerance, reducing the severity of their reaction.</data>
      <data key="d8">cause and effect,physiological response</data>
