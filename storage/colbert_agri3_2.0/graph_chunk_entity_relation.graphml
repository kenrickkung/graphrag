      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Knowledge" target="Extension Bulletins">
      <data key="d6">8.0</data>
      <data key="d7">Extension bulletins from the early-to-mid 20th century are identified as a valuable source of knowledge about diversified farming practices that are central to the author's philosophy.</data>
      <data key="d8">historical practice,information source</data>
