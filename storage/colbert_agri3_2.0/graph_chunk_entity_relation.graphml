      <data key="d11">1753740886</data>
    </edge>
    <edge source="Nonprofit" target="Focused Core Mission">
      <data key="d6">9.0</data>
      <data key="d7">Staying focused on a core mission is presented as a vital strategy for nonprofits to avoid running themselves ragged and to ensure impactful work.</data>
      <data key="d8">best practice,strategic principle</data>
