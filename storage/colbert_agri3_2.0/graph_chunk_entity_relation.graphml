    <node id="Brix">
      <data key="d0">Brix</data>
      <data key="d1">organization</data>
      <data key="d2">Brix is a high-end restaurant in Flagstaff, owned by Paul Moir, that partners with other local restaurants like Diablo Burger to share the task of picking up produce deliveries.</data>
