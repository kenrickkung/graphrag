    </node>
    <node id="Soil Safety">
      <data key="d0">Soil Safety</data>
      <data key="d1">category</data>
      <data key="d2">An environmental health topic related to urban gardening. Interns in The Food Project lead workshops on soil safety, addressing issues like lead and pesticide contamination.</data>
      <data key="d3">chunk-88b887765fabe568d174cfa581723af5</data>
