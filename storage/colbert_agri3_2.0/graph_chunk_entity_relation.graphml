    <node id="Whole Hog Sausage">
      <data key="d0">Whole Hog Sausage</data>
      <data key="d1">category</data>
      <data key="d2">"A value-added product created by processing a whole hog. It's an example of marketing a finished product instead of a raw commodity (livestock)."&gt;</data>
      <data key="d3">chunk-df880ab4353881f2fe1a61ec533c5679</data>
      <data key="d4">unknown_source</data>
