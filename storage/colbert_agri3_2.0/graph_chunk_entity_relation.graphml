      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Brood" target="Bee Colony">
      <data key="d6">9.0</data>
      <data key="d7">The Bee Colony collectively cares for the Brood, which represents the next generation of bees and signals its needs for care to the worker bees.</data>
