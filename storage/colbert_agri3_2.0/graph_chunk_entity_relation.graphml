      <data key="d11">1753740508</data>
    </edge>
    <edge source="Pesticides" target="Herbicides">
      <data key="d6">8.0</data>
      <data key="d7">Herbicides are listed as a specific category of pesticide, among others, that pose a varied threat to honey bees.</data>
