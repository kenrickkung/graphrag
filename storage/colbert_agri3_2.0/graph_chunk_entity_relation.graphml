      <data key="d1">event</data>
      <data key="d2">A recurring public event hosted by the Intervale Center during the summer, featuring live music, food, and various activities.</data>
      <data key="d3">chunk-c977e0c22629a3b90f1214c2370c4394</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
