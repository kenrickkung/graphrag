    <node id="Community-Based Food Organization">
      <data key="d0">Community-Based Food Organization</data>
      <data key="d1">category</data>
      <data key="d2">A type of organization that uses food as a means to generate numerous localized benefits, such as new jobs, youth education, business incubation, farmland preservation, and improved community health. The text cites Nuestras Raíces and Gateway Greening as examples.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="City Seeds Urban Farm">
      <data key="d0">City Seeds Urban Farm</data>
      <data key="d1">organization</data>
      <data key="d2">An urban agriculture initiative created by Gateway Greening in 2005 in downtown St. Louis. It provides job training and therapeutic horticulture to homeless and underserved individuals, serving as a key program for rehabilitation and empowerment.&lt;SEP&gt;An urban farm that is also referred to as 'Gateway Greening'.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="St. Patrick Center">
      <data key="d0">St. Patrick Center</data>
      <data key="d1">organization</data>
      <data key="d2">A local, faith-based service agency in St. Louis that works with individuals who are homeless or at risk of homelessness. It collaborates with City Seeds Urban Farm by referring its clients to the program.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
