    <node id="The Food Revolution">
      <data key="d0">The Food Revolution</data>
      <data key="d1">event</data>
      <data key="d2">'The Food Revolution' is a TV show from 2010 featuring Jamie Oliver that exposed the unhealthiness of school food. It is mentioned as a parallel effort that brought national attention to the issues JVUF was tackling locally in Birmingham.</data>
      <data key="d3">chunk-6c15e66cc3147bff35c99fe3e874a056</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740849</data>
    </node>
    <node id="School Board">
      <data key="d0">School Board</data>
      <data key="d1">organization</data>
      <data key="d2">The governing body for Birmingham schools. It initially resisted but ultimately approved the removal of all fryers from school cafeterias following a campaign by the Obesity Task Force.</data>
      <data key="d3">chunk-6c15e66cc3147bff35c99fe3e874a056</data>
      <data key="d4">unknown_source</data>
