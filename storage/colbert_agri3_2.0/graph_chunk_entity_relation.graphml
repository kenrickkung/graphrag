    </edge>
    <edge source="Pollen" target="Foragers">
      <data key="d6">9.0</data>
      <data key="d7">Forager bees collect pollen from flowers and transport it back to the hive on their hind legs.</data>
      <data key="d8">food gathering,foraging,resource collection</data>
