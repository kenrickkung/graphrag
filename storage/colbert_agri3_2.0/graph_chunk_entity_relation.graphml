      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Stings" target="Beekeepers">
      <data key="d6">9.0</data>
      <data key="d7">Beekeepers are the people who experience bee stings, which is presented as an unavoidable 'down side' and 'minor irritation' of the hobby.</data>
      <data key="d8">interaction,occupational hazard,risk</data>
      <data key="d9">chunk-f3025455da6b06dabe347fe4878bb963</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="History Of Beekeeping" target="Fourth Era Of Beekeeping">
      <data key="d6">9.0</data>
      <data key="d7">The Fourth Era is presented as the current, modern stage in the History of Beekeeping, defined by contemporary challenges and advancements.</data>
      <data key="d8">historical progression,modern era</data>
      <data key="d9">chunk-96f78f364d74eca8b91a5a10f5f9de4b</data>
