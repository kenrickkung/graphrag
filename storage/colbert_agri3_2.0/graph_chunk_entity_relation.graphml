    </node>
    <node id="Mickey Martin">
      <data key="d0">Mickey Martin</data>
      <data key="d1">person</data>
      <data key="d2">A resident who participates in People's Grocery's initiatives by assisting in the gardens and at markets.</data>
      <data key="d3">chunk-bb8186cf72c91110756ec67bcc379a67</data>
