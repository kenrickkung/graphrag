      <data key="d11">1753740508</data>
    </edge>
    <edge source="Bears" target="Electric Fence">
      <data key="d6">10.0</data>
      <data key="d7">The electric fence is the primary recommended defense to deter bears from attacking and destroying beehives.</data>
      <data key="d8">defense mechanism,deterrent,predator control</data>
