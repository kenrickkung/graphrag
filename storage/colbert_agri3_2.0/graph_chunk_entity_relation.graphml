      <data key="d10">unknown_source</data>
      <data key="d11">1753740503</data>
    </edge>
    <edge source="Comb" target="Mice">
      <data key="d6">9.0</data>
      <data key="d7">Mice cause extensive damage by chewing a large hole through several frames of comb to build their nests for the winter.</data>
      <data key="d8">destruction,nesting</data>
