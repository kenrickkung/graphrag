    <node id="Seed 2 Plate">
      <data key="d0">Seed 2 Plate</data>
      <data key="d1">event</data>
      <data key="d2">'Seed 2 Plate' is a half-day workshop offered by JVUF for school classes. It provides a comprehensive 'farm-to-fork' experience, including a hands-on agriculture lesson, a nutrition class, and a culinary lesson.</data>
      <data key="d3">chunk-6c15e66cc3147bff35c99fe3e874a056</data>
