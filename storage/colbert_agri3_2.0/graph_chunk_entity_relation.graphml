      <data key="d1">person</data>
      <data key="d2">Co-author, with Lee Sturdivant, of the book 'Medicinal Herbs in the Garden, Field, and Marketplace'.</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="San Juan Naturals">
      <data key="d0">San Juan Naturals</data>
      <data key="d1">organization</data>
      <data key="d2">A publisher based in Friday Harbor, Washington, that released books by Lee Sturdivant and Tim Blakley about growing and marketing herbs.</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8</data>
