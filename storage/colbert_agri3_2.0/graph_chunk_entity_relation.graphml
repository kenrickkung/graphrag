      <data key="d0">Apis Dorsata</data>
      <data key="d1">category</data>
      <data key="d2">Known as the giant honey bee, Apis dorsata is a species of honey bee found primarily in Southeast Asia.</data>
      <data key="d3">chunk-f2a11bfe1dc62c3ee867b5e29138914b</data>
      <data key="d4">unknown_source</data>
