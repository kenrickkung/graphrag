    </edge>
    <edge source="Researchers" target="Educators">
      <data key="d6">6.0</data>
      <data key="d7">Researchers and educators are both identified as key groups working to understand the Africanized bee problem and disseminate information to all affected parties.</data>
      <data key="d8">collaboration,expert groups,knowledge dissemination</data>
      <data key="d9">chunk-4ff2a1270133813dbf92927fcbf14a3c</data>
