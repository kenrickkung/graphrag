      <data key="d11">1753740886</data>
    </edge>
    <edge source="Walking Fish" target="Community-Supported Agriculture (CSA) Model">
      <data key="d6">9.0</data>
      <data key="d7">Walking Fish's business model is based on the principles of the Community-Supported Agriculture (CSA) model, which it adapted for a fishery.</data>
      <data key="d8">conceptual origin,model adaptation</data>
      <data key="d9">chunk-bf0fadd2de5cdd877a432eba713a59ce</data>
      <data key="d10">unknown_source</data>
