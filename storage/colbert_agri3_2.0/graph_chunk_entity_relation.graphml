    </edge>
    <edge source="Foraging" target="Kevin Feinstein">
      <data key="d6">10.0</data>
      <data key="d7">Kevin Feinstein is an expert practitioner and educator of foraging, leading walks and teaching others how to safely identify and use wild foods.</data>
      <data key="d8">education,expertise,professional practice</data>
