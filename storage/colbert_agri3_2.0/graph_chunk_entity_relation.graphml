    <edge source="The Author" target="Firewood">
      <data key="d6">8.0</data>
      <data key="d7">The author demonstrates a key management principle by turning leftover treetops into valuable firewood, personally cutting and selling it for a significant profit.</data>
      <data key="d8">economic activity,resource conversion</data>
