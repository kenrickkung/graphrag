      <data key="d4">unknown_source</data>
      <data key="d5">1753740879</data>
    </node>
    <node id="Gleaning Network">
      <data key="d0">Gleaning Network</data>
      <data key="d1">organization</data>
      <data key="d2">A program established by the Society of St. Andrew in 1988. It coordinates 30,000 to 40,000 volunteers each year to glean 15 to 20 million pounds of fresh produce from fields.</data>
      <data key="d3">chunk-347d33c4b812366f78a72782c922f5f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740879</data>
    </node>
