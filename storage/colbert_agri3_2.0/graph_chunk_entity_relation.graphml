    <node id="Jams And Jellies">
      <data key="d0">Jams And Jellies</data>
      <data key="d1">category</data>
      <data key="d2">"Value-added products that can be made from surplus or lower-quality berries from U-pick operations. This strategy increases revenue from the same crop."&gt;</data>
      <data key="d3">chunk-df880ab4353881f2fe1a61ec533c5679</data>
