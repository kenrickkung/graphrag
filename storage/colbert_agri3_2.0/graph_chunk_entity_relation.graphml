      <data key="d11">1753740863</data>
    </edge>
    <edge source="Earthworms" target="New Zealand">
      <data key="d6">8.0</data>
      <data key="d7">The introduction of earthworms to soils in New Zealand resulted in a 30 to 50 percent increase in pasture production.</data>
      <data key="d8">agricultural benefit,ecological impact</data>
