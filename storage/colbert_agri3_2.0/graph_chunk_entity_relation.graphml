      <data key="d11">1753740886</data>
    </edge>
    <edge source="Corn" target="Carl">
      <data key="d6">9.0</data>
      <data key="d7">As a farmer, Carl has a deep spiritual and practical relationship with corn, viewing the plants as his children and their life cycle as a metaphor for human life.</data>
      <data key="d8">agriculture,cultural metaphor,spirituality</data>
      <data key="d9">chunk-0875465d0b75e1a7aada73d20c5bbe6b</data>
