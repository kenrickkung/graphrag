      <data key="d10">unknown_source</data>
      <data key="d11">1753740508</data>
    </edge>
    <edge source="Honey Bee" target="European Honey Bee">
      <data key="d6">8.0</data>
      <data key="d7">The European Honey Bee is identified as the specific species of Honey Bee commonly kept by beekeepers, making it a primary example of the broader category.</data>
      <data key="d8">apiculture focus,species classification</data>
