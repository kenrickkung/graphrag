    </edge>
    <edge source="Package Lid" target="Fasteners">
      <data key="d6">8.0</data>
      <data key="d7">The package lid is held in place by fasteners (nails or staples) that must be removed.</data>
      <data key="d8">assembly,component</data>
      <data key="d9">chunk-3c3e0c4c99d600e81552689af79afdcd</data>
