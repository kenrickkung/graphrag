    <node id="Lowell Forman">
      <data key="d0">Lowell Forman</data>
      <data key="d1">person</data>
      <data key="d2">Lowell Forman is one of the fourteen founding members of the Country Natural Beef cooperative.</data>
      <data key="d3">chunk-09e000817f207794412f1a62763dda17</data>
