    <node id="Lincoln Land Conservation Trust (LLCT)">
      <data key="d0">Lincoln Land Conservation Trust (LLCT)</data>
      <data key="d1">organization</data>
      <data key="d2">A private land trust established in Lincoln, Massachusetts, in 1957. It has been instrumental in conserving thousands of acres of agricultural and forest lands in the town.&lt;SEP&gt;The Lincoln Land Conservation Trust (LLCT) is an organization focused on land conservation in Lincoln.</data>
      <data key="d3">chunk-07d81959e2e7dfd429fb34ce74beae5e&lt;SEP&gt;chunk-8c9669112f71f37c0273243e8cc59e05</data>
      <data key="d4">unknown_source</data>
