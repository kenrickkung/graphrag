    <node id="Farm Business Planning">
      <data key="d0">Farm Business Planning</data>
      <data key="d1">category</data>
      <data key="d2">A comprehensive management process for farming operations that includes goal setting, resource and labor allocation, and financial budgeting. The text references guides on this topic as sources for its data.</data>
      <data key="d3">chunk-8448fec2abb01962b8a2c019dd0efd50</data>
      <data key="d4">unknown_source</data>
