    <node id="Lehman's">
      <data key="d0">Lehman's</data>
      <data key="d1">organization</data>
      <data key="d2">Lehman's, located in Kidron, Ohio, is a company that specializes in selling homesteading equipment.</data>
      <data key="d3">chunk-57c24510274e9c9fcb046e6b604285fd</data>
