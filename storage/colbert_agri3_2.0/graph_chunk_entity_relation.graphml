    <node id="Bee Havers">
      <data key="d0">Bee Havers</data>
      <data key="d1">category</data>
      <data key="d2">"Bee Havers are individuals who acquire bees but lose interest or never develop the necessary knowledge to care for them properly. They are contrasted with true 'bee keepers' as they passively own bees rather than actively managing them."&gt;</data>
