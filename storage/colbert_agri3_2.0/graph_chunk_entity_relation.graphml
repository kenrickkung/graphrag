    <node id="The Adults">
      <data key="d0">The Adults</data>
      <data key="d1">category</data>
      <data key="d2">"The adult facilitators in the Food Works program who guide the youth participants by asking questions rather than providing answers, thereby fostering community ownership."&gt;</data>
