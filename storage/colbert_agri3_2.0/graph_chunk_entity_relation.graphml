    <node id="Spring Management">
      <data key="d0">Spring Management</data>
      <data key="d1">event</data>
      <data key="d2">Spring Management refers to a specific period of beekeeping activities conducted in the spring, such as reversing hive bodies, to manage colony growth.</data>
      <data key="d3">chunk-ee2dbfbb5c1a5664034bad31b4143c62</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
