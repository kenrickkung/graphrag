      <data key="d0">Feeding America</data>
      <data key="d1">organization</data>
      <data key="d2">A major nonprofit organization in the U.S. that fights hunger by distributing over 2.5 billion pounds of food annually.</data>
      <data key="d3">chunk-347d33c4b812366f78a72782c922f5f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740879</data>
    </node>
    <node id="Hunters for the Hungry">
      <data key="d0">Hunters for the Hungry</data>
      <data key="d1">organization</data>
      <data key="d2">A program providing meat to the hungry, which was piloted by SoSA in 1991 and later spun off into an independent organization.</data>
      <data key="d3">chunk-347d33c4b812366f78a72782c922f5f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740879</data>
    </node>
