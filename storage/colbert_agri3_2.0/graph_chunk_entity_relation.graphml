      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Honey Bee" target="Pesticides">
      <data key="d6">9.0</data>
      <data key="d7">Pesticides are discussed as a significant problem and external threat to the well-being and survival of honey bees.</data>
      <data key="d8">chemical hazard,environmental threat</data>
      <data key="d9">chunk-0a5bf9269446157b7f585b574d80342a</data>
