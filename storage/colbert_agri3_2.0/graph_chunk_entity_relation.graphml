      <data key="d1">organization</data>
      <data key="d2">A research and extension program at Langston University that provides information on aquaculture and goats.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690</data>
      <data key="d4">unknown_source</data>
