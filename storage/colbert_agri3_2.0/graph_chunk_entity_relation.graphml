      <data key="d1">organization</data>
      <data key="d2">A company that hired Doanes Agricultural Service in 1996 to conduct a study on why farmers farm and the practices they use.</data>
      <data key="d3">chunk-0f1ce27dcb115879ec30587ba69b4095</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
