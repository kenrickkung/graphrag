      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Worker Bee" target="Nurse Bees">
      <data key="d6">8.0</data>
      <data key="d7">'Nurse bee' is a role performed by young worker bees during their 'house bee' phase.</data>
      <data key="d8">labor,life stage,sub-role</data>
      <data key="d9">chunk-14c389aa55b6d5b4c773f2c917b36e7a</data>
      <data key="d10">unknown_source</data>
