    </edge>
    <edge source="Beekeeper" target="Universities">
      <data key="d6">7.0</data>
      <data key="d7">The text identifies Universities as a source of research and new knowledge that a Beekeeper should access to stay informed and successful.</data>
      <data key="d8">education,knowledge transfer,research</data>
