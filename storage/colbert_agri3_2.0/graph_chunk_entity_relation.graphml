    <node id="Guiding Principles">
      <data key="d0">Guiding Principles</data>
      <data key="d1">category</data>
      <data key="d2">A set of seven principles created in 1999 by the Troy Gardens Advisory Council to help the coalition maintain its focus on the original project goals, even as membership changed.</data>
