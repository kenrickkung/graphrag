      <data key="d11">1753740472</data>
    </edge>
    <edge source="Bee Sting" target="Anaphylactic Shock">
      <data key="d6">9.0</data>
      <data key="d7">Anaphylactic shock is presented as the most severe and life-threatening allergic reaction that can be triggered by a bee sting in susceptible individuals.</data>
