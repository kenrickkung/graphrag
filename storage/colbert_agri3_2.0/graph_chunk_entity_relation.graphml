    <node id="Reclaiming Our Food">
      <data key="d0">Reclaiming Our Food</data>
      <data key="d1">category</data>
      <data key="d2">'Reclaiming Our Food' is the title of the book and represents the central theme of communities taking back control of their food systems from industrial agriculture.</data>
      <data key="d3">chunk-51cfeabc3f21e3329484ec062ac1c4b2</data>
