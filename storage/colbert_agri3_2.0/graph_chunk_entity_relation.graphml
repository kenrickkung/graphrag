      <data key="d11">1753740472</data>
    </edge>
    <edge source="Frames" target="Drawn Comb">
      <data key="d6">8.0</data>
      <data key="d7">Drawn comb is a developed state of the frames, where bees have already built the wax honeycomb structure.</data>
      <data key="d8">bee habitat,frame content</data>
      <data key="d9">chunk-f6b1093c60c117041d669d3950218419</data>
