      <data key="d0">Low-income Communities</data>
      <data key="d1">category</data>
      <data key="d2">Low-income Communities is a category describing the multigenerational and diverse populations that Janus Youth works with through its garden initiatives.</data>
      <data key="d3">chunk-45291ea55455adae718c5031c0e8dfff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Community Advisory Council">
      <data key="d0">Community Advisory Council</data>
      <data key="d1">organization</data>
      <data key="d2">A formal mechanism for accountability with the community that Tera Wick plans to establish for the Janus Youth programs. The council's purpose is to provide a pathway for community members to give feedback and ensure the organization remains humble and responsive.</data>
      <data key="d3">chunk-45291ea55455adae718c5031c0e8dfff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="One Woman">
      <data key="d0">One Woman</data>
      <data key="d1">person</data>
      <data key="d2">A woman in the garden program at St. Johns Woods who told Rosalie Karp that her experience working with Janus Youth changed her negative perception of white people.</data>
      <data key="d3">chunk-45291ea55455adae718c5031c0e8dfff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="African-American Man">
      <data key="d0">African-American Man</data>
      <data key="d1">person</data>
      <data key="d2">A man who observed the Janus Youth program, approached the program director, and expressed his approval, noting that unlike other groups, Janus Youth listened to the community and worked alongside them.</data>
      <data key="d3">chunk-45291ea55455adae718c5031c0e8dfff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
