      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Hive Frames" target="You (The Beekeeper)">
      <data key="d6">8.0</data>
      <data key="d7">The beekeeper actively manages the hive frames by shifting them within the hive bodies to encourage the bees to draw out comb evenly across all frames.</data>
      <data key="d8">hive management,intervention,manipulation</data>
