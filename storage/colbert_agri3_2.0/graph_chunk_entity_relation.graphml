    <node id="Therapeutic Horticulture">
      <data key="d0">Therapeutic Horticulture</data>
      <data key="d1">category</data>
      <data key="d2">A specific program provided by City Seeds Urban Farm for individuals who are homeless, underserved, or recovering from addiction. It uses gardening as a form of therapy to teach skills, improve nutrition, and foster recovery.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
      <data key="d4">unknown_source</data>
