      <data key="d0">Herman Reid</data>
      <data key="d1">person</data>
      <data key="d2">A war veteran who participated in the City Seeds program. Through the training, he gained skills and appreciation for gardening and was subsequently hired by a landscaping company.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Jason Smith">
      <data key="d0">Jason Smith</data>
      <data key="d1">person</data>
      <data key="d2">A City Seeds trainee with a criminal record who discovered a passion for outdoor work. The skills he gained at the farm inspired him to plan his own tree-trimming and gardening business.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740838</data>
