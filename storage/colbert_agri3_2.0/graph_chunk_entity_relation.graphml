      <data key="d11">1753740472</data>
    </edge>
    <edge source="Bee Sting" target="Local Reaction">
      <data key="d6">9.0</data>
      <data key="d7">A local reaction, involving pain and swelling at the sting site, is described as the most common outcome for most people who experience a bee sting.</data>
      <data key="d8">common outcome,medical reaction,physical symptoms</data>
      <data key="d9">chunk-5a4a1a431b94a27a92d263b7dde5aa5a</data>
