      <data key="d0">ASFA</data>
      <data key="d1">organization</data>
      <data key="d2">ASFA is a school whose students, particularly those in math and science, participate in and enjoy the ASAP course offered by JVUF.</data>
      <data key="d3">chunk-6c15e66cc3147bff35c99fe3e874a056</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
