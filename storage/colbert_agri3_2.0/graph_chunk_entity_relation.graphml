      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Neighbors" target="Small Farmer">
      <data key="d6">9.0</data>
      <data key="d7">The text suggests a Small Farmer can collaborate with Neighbors by exchanging or bartering for machine use as an alternative to ownership or rental.</data>
      <data key="d8">community collaboration,resource sharing</data>
