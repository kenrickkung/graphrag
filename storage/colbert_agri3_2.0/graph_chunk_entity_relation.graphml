    </edge>
    <edge source="Tools" target="Machinery">
      <data key="d6">8.0</data>
      <data key="d7">Tools and machinery are grouped together as items that need to be protected in a shed. Tools are used to work on and repair machinery, enhancing its lifespan.</data>
      <data key="d8">equipment dependency,maintenance</data>
      <data key="d9">chunk-8c12c90d0c9b0f56b008795013b9e85a</data>
      <data key="d10">unknown_source</data>
