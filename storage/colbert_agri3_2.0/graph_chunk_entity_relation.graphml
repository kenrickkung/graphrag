    </edge>
    <edge source="The Author" target="Crop Rotation">
      <data key="d6">10.0</data>
      <data key="d7">The author provides a detailed, personal example of implementing a multi-year crop rotation system on their farm in Missouri, integrating field crops, vegetables, and cover crops.</data>
      <data key="d8">farming practice,personal implementation,practical application</data>
      <data key="d9">chunk-ee261677ef65b4f0bf53fae46bfcfb75</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="The Author" target="Winter Rye">
      <data key="d6">9.0</data>
      <data key="d7">The author plants winter rye as a cover crop after corn to prevent erosion, retain nutrients, and create a mulch for the following year's tomatoes.</data>
      <data key="d8">cover cropping,farming practice,specific application</data>
      <data key="d9">chunk-ee261677ef65b4f0bf53fae46bfcfb75</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="The Author" target="Hairy Vetch">
      <data key="d6">9.0</data>
      <data key="d7">The author plants hairy vetch as a legume cover crop specifically to provide nitrogen for the subsequent tomato crop in their rotation.</data>
      <data key="d8">crop synergy,farming practice,nitrogen fixation</data>
      <data key="d9">chunk-ee261677ef65b4f0bf53fae46bfcfb75</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="The Author" target="Hogs">
      <data key="d6">9.0</data>
      <data key="d7">The author uses their personal experience of selling hogs as sausage to provide a concrete, profitable example of direct marketing principles in action.</data>
