    <node id="Gardens of Park Place">
      <data key="d0">Gardens of Park Place</data>
      <data key="d1">geo</data>
      <data key="d2">The Gardens of Park Place is a 3-acre urban site in Birmingham, Alabama, managed by the Jones Valley Urban Farm. It is being developed into a model urban agricultural center with community gardens, a farm center, and educational facilities.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Alabama School of Fine Arts">
      <data key="d0">Alabama School of Fine Arts</data>
      <data key="d1">organization</data>
      <data key="d2">The Alabama School of Fine Arts (ASFA) is a public school in Birmingham for grades 7 through 12 that partnered with the Jones Valley Urban Farm to create a state-accredited, hands-on science course.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="The Arts and Science of Agriculture">
      <data key="d0">The Arts and Science of Agriculture</data>
      <data key="d1">category</data>
      <data key="d2">'The Arts and Science of Agriculture' (ASAP) is a state-accredited, interdisciplinary course developed by the Jones Valley Urban Farm and the Alabama School of Fine Arts. It combines classroom study with hands-on farming experience.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Fat Tax">
      <data key="d0">Fat Tax</data>
      <data key="d1">category</data>
      <data key="d2">The 'Fat Tax' is a policy announced by the state of Alabama where state employees would pay a $25 monthly insurance fee if they did not meet certain fitness goals. It is mentioned as a radical action to combat obesity.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Hope IV Housing Development">
      <data key="d0">Hope IV Housing Development</data>
      <data key="d1">organization</data>
      <data key="d2">The Hope IV housing development is a residential community located next to the Gardens of Park Place, an urban farm site in Birmingham.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
