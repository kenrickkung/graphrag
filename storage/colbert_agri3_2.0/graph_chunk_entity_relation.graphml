      <data key="d11">1753740472</data>
    </edge>
    <edge source="North America" target="Apis Mellifera">
      <data key="d6">7.0</data>
      <data key="d7">Apis mellifera was not native to North America but was introduced to the continent by settlers, and it is now the only honey bee species found there.</data>
      <data key="d8">geographical distribution,introduction</data>
