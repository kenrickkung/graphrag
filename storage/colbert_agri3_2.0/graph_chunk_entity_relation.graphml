    </edge>
    <edge source="Pollen" target="Nucleus Hive">
      <data key="d6">8.0</data>
      <data key="d7">The presence of stored pollen in a nucleus hive is an advantage, providing the new colony with essential nutrition for a strong start.</data>
      <data key="d8">colony resources,nutrition</data>
