      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="The Author" target="Small Farmers">
      <data key="d6">9.0</data>
      <data key="d7">The author, an experienced small farmer himself, is writing to provide advice and principles to other small farmers, especially newcomers.</data>
      <data key="d8">knowledge sharing,mentorship</data>
