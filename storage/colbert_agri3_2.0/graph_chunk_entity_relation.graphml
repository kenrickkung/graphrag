    </edge>
    <edge source="New Colony" target="Worker Bees">
      <data key="d6">8.0</data>
      <data key="d7">The original Worker Bees from the package constitute the initial population of the New Colony, but their natural life cycle causes a population decline in the first month.</data>
      <data key="d8">population dynamics,workforce</data>
      <data key="d9">chunk-6706ffd7485284387c77b1f38a66ce9c</data>
