    <node id="Allan Callahan">
      <data key="d0">Allan Callahan</data>
      <data key="d1">person</data>
      <data key="d2">An African-American pastor and Harvard divinity professor who was a major influence on The Food Project's early development. He helped establish the core principles of offering paid jobs and intentionally mixing teens from diverse backgrounds.</data>
      <data key="d3">chunk-07d81959e2e7dfd429fb34ce74beae5e</data>
