    <node id="Sheep, Milk">
      <data key="d0">Sheep, Milk</data>
      <data key="d1">category</data>
      <data key="d2">A dairy sheep enterprise involving milking for 160 days per year and lambing 1.5 times per year. It generates income from milk, lamb, wool, hides, and cull animals, resulting in the highest net profit among the sheep categories at $143.44, with 15 hours of labor per ewe.</data>
      <data key="d3">chunk-a6d072f41d662cb326c1c528ac3c5c51</data>
