      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Minnesota State Legislature" target="Minnesota Department of Natural Resources">
      <data key="d6">8.0</data>
      <data key="d7">The Minnesota State Legislature mandated that the Minnesota Department of Natural Resources conduct a study on environmental threats to wild rice and present recommendations.</data>
      <data key="d8">environmental study,governmental mandate,state governance</data>
