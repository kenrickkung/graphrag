      <data key="d0">Healthy Homes Workshops</data>
      <data key="d1">event</data>
      <data key="d2">A series of 35 workshops conducted by Rivera in spring 2009. The workshops aimed to educate community members on how to improve indoor air quality and manage health issues like asthma without using harmful chemicals.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
