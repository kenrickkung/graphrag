      <data key="d11">1753740472</data>
    </edge>
    <edge source="Brood" target="Pheromones">
      <data key="d6">8.0</data>
      <data key="d7">The Brood releases specific pheromones that act as signals to worker bees, indicating their developmental stage and needs like feeding or cell capping.</data>
      <data key="d8">brood care,chemical signal,resource request</data>
