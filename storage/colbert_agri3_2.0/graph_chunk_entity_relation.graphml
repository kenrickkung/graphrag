    <node id="Talk by the Vermont Beekeepers Association">
      <data key="d0">Talk by the Vermont Beekeepers Association</data>
      <data key="d1">event</data>
      <data key="d2">An educational talk given by the Vermont Beekeepers Association during a July event at the Intervale Center.</data>
      <data key="d3">chunk-c977e0c22629a3b90f1214c2370c4394</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="McRae">
      <data key="d0">McRae</data>
      <data key="d1">person</data>
      <data key="d2">An individual associated with the Intervale who acknowledges the model's limitations, such as the lack of a food processing component, and believes developing this area is an important future direction.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Intervale Food Enterprise Center">
      <data key="d0">Intervale Food Enterprise Center</data>
      <data key="d1">organization</data>
      <data key="d2">A planned future development at the Intervale. It is designed to be a 40,000-square-foot facility with food-processing capabilities and greenhouses, heated by waste heat from the nearby McNeil power station.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Bernie Sanders">
      <data key="d0">Bernie Sanders</data>
      <data key="d1">person</data>
      <data key="d2">A current congressman who, as a former mayor of Burlington, was a key early supporter of the Intervale.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="McNeil Power Station">
      <data key="d0">McNeil Power Station</data>
      <data key="d1">organization</data>
      <data key="d2">A power station located near the Intervale. Its waste heat is planned to be used to heat the future Intervale Food Enterprise Center.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Tom Sereduk">
      <data key="d0">Tom Sereduk</data>
      <data key="d1">person</data>
      <data key="d2">A chef who co-founded Greensgrow Farm with Mary Seton Corboy in 1997.&lt;SEP&gt;Co-founder of Greensgrow with Mary Corboy. He was a partner in the early, difficult stages of the farm but left the 'arranged marriage gone bad' after three years due to the intense stress.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9&lt;SEP&gt;chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Thomas Jefferson">
      <data key="d0">Thomas Jefferson</data>
      <data key="d1">person</data>
      <data key="d2">An early American politician and farmer who, like George Washington, had large landholdings where he experimented with agricultural practices and crops.</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Appalachian">
      <data key="d0">Appalachian</data>
      <data key="d1">geo</data>
      <data key="d2">A region where farmers continue to practice traditional subsistence farming, illustrating a farm type that is remote from population centers.</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Rural Crisis of the 1980s">
      <data key="d0">Rural Crisis of the 1980s</data>
      <data key="d1">event</data>
      <data key="d2">A period of economic turmoil in American agriculture caused by high land prices and a drop in commodity prices. It led to farm failures, personal tragedies, and a shift in agricultural thinking towards diversification and improved marketing.</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Consolidation of Agricultural Processing">
      <data key="d0">Consolidation of Agricultural Processing</data>
      <data key="d1">category</data>
      <data key="d2">A market trend where a few large companies dominate the processing of agricultural commodities like beef, as well as the seed and chemical industries, giving them significant market control.</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Farming in the Midwest 1840–1900">
      <data key="d0">Farming in the Midwest 1840–1900</data>
      <data key="d1">category</data>
      <data key="d2">"A book edited by James Whitaker, which is cited as a source stating that farms retaining a 'pioneer atmosphere' are those most remote from population centers."&gt;</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Terminator Gene">
      <data key="d0">Terminator Gene</data>
      <data key="d1">category</data>
      <data key="d2">"A genetic technology developed by the USDA and Delta Land and Pine Company to create sterile seeds that cannot be saved for replanting. It represents an attempt by companies to control seed supply."&gt;</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Land-grant institutions">
      <data key="d0">Land-grant institutions</data>
      <data key="d1">organization</data>
      <data key="d2">"A group of agricultural and educational institutions that farmers began to question following the Rural Crisis of the 1980s. They are also identified as a key group that needs to be educated for sustainable agriculture to succeed."&gt;</data>
      <data key="d3">chunk-fbeff72000d21039cdbac6ba65f75077</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="The Big Picture Principle">
      <data key="d0">The Big Picture Principle</data>
      <data key="d1">category</data>
      <data key="d2">A core principle of good farming described in the text. It involves the way a farmer conceptualizes their farm, its goals, and the relationships and balance between crops and livestock, both locally and globally.</data>
      <data key="d3">chunk-473f8348a15ba74f2e21ca4cc96c583e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Kensington">
      <data key="d0">Kensington</data>
      <data key="d1">geo</data>
      <data key="d2">A low-income, 'rough' urban neighborhood where the contaminated Superfund site was located. It is now the home of the Greensgrow farm.&lt;SEP&gt;One of Philadelphia's oldest and lowest-income neighborhoods, which was historically an industrial center. It is the location of the abandoned Superfund site where Greensgrow Farm was established.&lt;SEP&gt;The Philadelphia neighborhood where Mary Corboy and Sereduk first established the Greensgrow nursery after acquiring a greenhouse.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-e6fd2b31420a632f31dfe7120da040d9&lt;SEP&gt;chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Land Conservation">
      <data key="d0">Land Conservation</data>
      <data key="d1">category</data>
      <data key="d2">A community or movement mentioned as having a growing belief that simply saving land is not enough, and that it is also essential to train and nurture the next generation of farmers, an approach reflected by the Intervale.&lt;SEP&gt;The professional field of expertise for Van Ness, one of the founders of Lynchburg Grows. His 'deep roots in land conservation' as an environmental lawyer were instrumental in structuring the successful purchase of the Schenkel property.</data>
      <data key="d3">chunk-9189adec7b34964ca2342aea2d2b666e&lt;SEP&gt;chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Superfund Site">
      <data key="d0">Superfund Site</data>
      <data key="d1">category</data>
      <data key="d2">"A specific type of heavily contaminated brownfield site, one of which is leased by Greensgrow Farm, demonstrating that even such locations can be used for urban farming."&gt;&lt;SEP&gt;A classification for a heavily contaminated, abandoned industrial location. Greensgrow Farm is a prime example of how a Superfund site can be successfully rehabilitated to become a productive urban farm and community asset.&lt;SEP&gt;A legal designation for polluted locations in the United States requiring long-term cleanup of hazardous material contamination. The land Greensgrow was built on was a former Superfund site contaminated by a factory with lead, cadmium, zinc, and arsenic.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9&lt;SEP&gt;chunk-cd762b4d6c9647db05924d3e745a6991&lt;SEP&gt;chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="New Jersey">
      <data key="d0">New Jersey</data>
      <data key="d1">geo</data>
      <data key="d2">The state where Mary Seton Corboy and Tom Sereduk first started their farming venture before relocating to Philadelphia.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Twentieth-century Industrial Agriculture">
      <data key="d0">Twentieth-century Industrial Agriculture</data>
      <data key="d1">category</data>
      <data key="d2">A system of agriculture described as the cause of the degraded soil and lost fertility at the Intervale site. The Intervale's composting operation was a direct response to reverse this damage.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Delaware River">
      <data key="d0">Delaware River</data>
      <data key="d1">geo</data>
      <data key="d2">A river that borders the Kensington neighborhood, which is described as having a heritage as a fishing village on its edge.&lt;SEP&gt;The Delaware River is a waterway where the city's 'green' boat operates to remove garbage. The use of biodiesel is a protective measure to prevent petrochemical pollution in the river.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2&lt;SEP&gt;chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Stetson Hats">
      <data key="d0">Stetson Hats</data>
      <data key="d1">organization</data>
      <data key="d2">A company mentioned as an example of the industrial milling that was historically part of the Kensington neighborhood's economy.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Dutch Boy Paint">
      <data key="d0">Dutch Boy Paint</data>
      <data key="d1">organization</data>
      <data key="d2">A paint company mentioned as an example of the light industry that was historically part of the Kensington neighborhood's economy.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Machinery and Hand Tools">
      <data key="d0">Machinery and Hand Tools</data>
      <data key="d1">category</data>
      <data key="d2">Described as essential labor-saving devices on a farm. Their purpose is to enable farmers to accomplish more work in less time or to perform tasks in a timely manner, such as harvesting.</data>
      <data key="d3">chunk-473f8348a15ba74f2e21ca4cc96c583e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Price Cycle">
      <data key="d0">Price Cycle</data>
      <data key="d1">category</data>
      <data key="d2">An economic pattern affecting traditional agricultural commodities like corn, wheat, cattle, and hogs. It involves fluctuations between periods of low supply and high prices and periods of high supply and low prices.</data>
      <data key="d3">chunk-473f8348a15ba74f2e21ca4cc96c583e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Environmentally Controlled Housing">
      <data key="d0">Environmentally Controlled Housing</data>
      <data key="d1">category</data>
      <data key="d2">A modern agricultural technology, particularly for poultry and hogs. The text notes that this technology has disrupted or 'played havoc with' the traditional seasonal price cycles for livestock.</data>
      <data key="d3">chunk-473f8348a15ba74f2e21ca4cc96c583e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Small Farm Today Magazine">
      <data key="d0">Small Farm Today Magazine</data>
      <data key="d1">organization</data>
      <data key="d2">A bimonthly 'how-to' magazine started by the author in 1984. It provides information on alternative and traditional crops, livestock, and direct marketing for small farmers and landowners.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Iowa State University Press">
      <data key="d0">Iowa State University Press</data>
      <data key="d1">organization</data>
      <data key="d2">A publisher located in Ames, Iowa, that released the 'Manual of Exotic Pets'.&lt;SEP&gt;The publisher of 'Forages, 2nd ed.', located in Ames.&lt;SEP&gt;The publisher of the book 'Manual of Exotic Pets', located in Ames, Iowa.</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8&lt;SEP&gt;chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Peter H. Benyon">
      <data key="d0">Peter H. Benyon</data>
      <data key="d1">person</data>
      <data key="d2">A co-author of the book 'Manual of Exotic Pets', which is listed as a resource.&lt;SEP&gt;Co-author of the 'Manual of Exotic Pets', a guide to mammals, birds, and reptiles.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="John E. Cooper">
      <data key="d0">John E. Cooper</data>
      <data key="d1">person</data>
      <data key="d2">A co-author of the book 'Manual of Exotic Pets', which is listed as a resource.&lt;SEP&gt;Co-author of the 'Manual of Exotic Pets', a guide to exotic animals.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Gale Birutta">
      <data key="d0">Gale Birutta</data>
      <data key="d1">person</data>
      <data key="d2">Author of 'Storey's Guide to Raising Llamas'.&lt;SEP&gt;The author of 'Storey's Guide to Raising Llamas', published by Storey Publishing and recommended as a resource.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="I-95 Traffic Corridor">
      <data key="d0">I-95 Traffic Corridor</data>
      <data key="d1">geo</data>
      <data key="d2">A major highway mentioned as being just minutes away from Greensgrow Farm, emphasizing its urban location.</data>
      <data key="d3">chunk-bd12c93ca420ae0dfd8107f51eec1886</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Mary Corboy">
      <data key="d0">Mary Corboy</data>
      <data key="d1">person</data>
      <data key="d2">Co-founder and leader of Greensgrow. She invested her own money, secured loans, and managed the farm's growth and diversification. Corboy is the primary voice in the text, articulating the farm's history, challenges, and strategies for financial sustainability.&lt;SEP&gt;The founder and visionary leader of Greensgrow. A former chef, she applies counterintuitive business strategies and is passionate about educating consumers, promoting local food systems, and legitimizing urban farms.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Environmental Protection Agency (EPA)">
      <data key="d0">Environmental Protection Agency (EPA)</data>
      <data key="d1">organization</data>
      <data key="d2">"A federal agency of the United States government tasked with environmental protection matters, including the regulation of agricultural operations like CAFOs."&gt;&lt;SEP&gt;A US government agency that initially declared the contaminated Kensington lot a Superfund site, removed hazardous tanks, and capped the area with concrete. Years later, it awarded Greensgrow a $50,000 Sustainable Development Challenge Grant.&lt;SEP&gt;The U.S. federal agency that funds the brownfields remediation program which Lynchburg Grows participated in, enabling the costly assessment and cleanup of the site.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9&lt;SEP&gt;chunk-7b79b32f16bacae95e48f2f51ab5dee0&lt;SEP&gt;chunk-9189adec7b34964ca2342aea2d2b666e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Community Development Corporation (CDC)">
      <data key="d0">Community Development Corporation (CDC)</data>
      <data key="d1">organization</data>
      <data key="d2">A local city organization that facilitated the purchase of the contaminated lot for the neighborhood. It now acts as Greensgrow's landlord, leasing the property to the farm for a low monthly rate as part of its 'Clean Green' project.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Sustainable Development Challenge Grant">
      <data key="d0">Sustainable Development Challenge Grant</data>
      <data key="d1">event</data>
      <data key="d2">A $50,000 grant awarded by the U.S. Environmental Protection Agency to Greensgrow. The purpose of the grant was to assist the farm in developing a model that could be replicated by others.&lt;SEP&gt;A specific grant program designed to fund projects that address challenges in sustainable development.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Venture Capital Group">
      <data key="d0">Venture Capital Group</data>
      <data key="d1">organization</data>
      <data key="d2">An unnamed financial group that provided a crucial $47,000 loan to Mary Corboy and Tom Sereduk, enabling them to start Greensgrow.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Greensgrow CSA">
      <data key="d0">Greensgrow CSA</data>
      <data key="d1">organization</data>
      <data key="d2">The Community Supported Agriculture program operated by Greensgrow. In 2010, it served approximately 500 households through 375 shares and is a key part of the farm's business model. Participants are referred to as 'co-owners' by Mary Corboy.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Greensgrow Farmers' Market">
      <data key="d0">Greensgrow Farmers' Market</data>
      <data key="d1">event</data>
      <data key="d2">A market hosted by Greensgrow that was opened up to other farmers and producers. This counterintuitive strategy by Mary Corboy, designed to increase competition, successfully attracted more customers to the farm.&lt;SEP&gt;A twice-weekly market hosted at the Greensgrow site. In a strategic move by Mary Corboy, the market was opened to 80 other producers in 2009 to increase variety and customer traffic.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Ozark">
      <data key="d0">Ozark</data>
      <data key="d1">geo</data>
      <data key="d2">A geographical region mentioned as an example of a place that will produce regional products, specifically 'Ozark wines'.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Boone County">
      <data key="d0">Boone County</data>
      <data key="d1">geo</data>
      <data key="d2">A geographical region mentioned as an example of a place that will produce regional products, specifically 'Boone County hams'.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Washington">
      <data key="d0">Washington</data>
      <data key="d1">geo</data>
      <data key="d2">Washington is a U.S. state located in the Pacific Northwest region. It is home to a farmer cooperative that supplies certified flour to the Cascade Baking Company, and is known for producing regional products such as Washington apples. The state is also where the city of Seattle is located. Several organizations operate in Washington, including the antipoverty nonprofit Solid Ground, which is based there and runs a fruit-gleaning program. Janus Youth Programs, Inc. also operates some of its 40 programs in Washington, providing services to high-risk youth.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-05be2e4c27c7eabe9de8d2ff56b840a5&lt;SEP&gt;chunk-347d33c4b812366f78a72782c922f5f8&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d&lt;SEP&gt;chunk-8fa6369dd0584465f07387131c6d28e6&lt;SEP&gt;chunk-d6db795582f52e35a0bb9aea86e66f7f&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Small Sustainable Farms">
      <data key="d0">Small Sustainable Farms</data>
      <data key="d1">category</data>
      <data key="d2">The central concept of the text. It's presented as the future of agriculture, characterized by being localized, processing their own products, fostering community, reconnecting people with the land, and being an increasing segment in American agriculture.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Agriculture Industry">
      <data key="d0">Agriculture Industry</data>
      <data key="d1">category</data>
      <data key="d2">The broader economic sector related to farming. The author argues that everyone involved in agriculture must become a spokesperson for this industry to educate politicians and the public.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Regional Products">
      <data key="d0">Regional Products</data>
      <data key="d1">category</data>
      <data key="d2">A type of product, such as Ozark wines or Washington apples, that the author sees as a significant part of the future of a decentralized, seasonal, and sustainable agricultural system.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Jim Johnson">
      <data key="d0">Jim Johnson</data>
      <data key="d1">person</data>
      <data key="d2">An individual listed in the 'Books' resource section, presumably an author, although the text is cut off before providing the title of his work.&lt;SEP&gt;Co-author of 'Husbandry and Medical Management of Ostriches, Emus, and Rheas'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Contract Grower">
      <data key="d0">Contract Grower</data>
      <data key="d1">category</data>
      <data key="d2">A type of farmer within the traditional agriculture system who makes no management decisions and bears a significant portion of the financial risk. The author advises readers against becoming one.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Steel-Galvanizing Factory">
      <data key="d0">Steel-Galvanizing Factory</data>
      <data key="d1">organization</data>
      <data key="d2">The industrial facility that previously operated on the Kensington lot. It abandoned tanks of lead, cadmium, zinc, and arsenic, causing the contamination that led to the area being declared a Superfund site.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Financial Stability">
      <data key="d0">Financial Stability</data>
      <data key="d1">category</data>
      <data key="d2">A key strategic goal for Greensgrow, described by Mary Corboy as one leg of sustainability. It is pursued through strategies like diversification and season extension.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Diversification">
      <data key="d0">Diversification</data>
      <data key="d1">category</data>
      <data key="d2">A business strategy championed by Mary Corboy to ensure Greensgrow's financial stability. Examples include starting a nursery business, which provides 30% of income, hosting a large farmers' market, and managing beehives.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Hydroponics">
      <data key="d0">Hydroponics</data>
      <data key="d1">category</data>
      <data key="d2">A soil-less farming technique that was the initial method planned by Corboy and Sereduk to grow vegetables on the concrete-capped Superfund site. The idea was initially seen as 'ludicrous' by city officials.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Clean Green Project">
      <data key="d0">Clean Green Project</data>
      <data key="d1">event</data>
      <data key="d2">A project run by the local Community Development Corporation (CDC) to clean up neglected lots in Kensington. This initiative motivated the CDC's involvement in acquiring the site that became Greensgrow.</data>
      <data key="d3">chunk-e6fd2b31420a632f31dfe7120da040d9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Cody Richter">
      <data key="d0">Cody Richter</data>
      <data key="d1">person</data>
      <data key="d2">"A representative for Greensgrow Farm."&gt;&lt;SEP&gt;A 21-year-old who manages biodiesel production at Greensgrow. He built the system and produces fuel from used vegetable oil sourced from city restaurants, championing it as a form of 'negative pollution'.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-f188db350c6a6f2fdb22a9e9283e4dc3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Sereduk">
      <data key="d0">Sereduk</data>
      <data key="d1">person</data>
      <data key="d2">The co-founder of Greensgrow, who worked alongside Mary Corboy in the early stages of the business. He was involved in the decision to use a rescued greenhouse to grow flowers.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Horticulture Clubs">
      <data key="d0">Horticulture Clubs</data>
      <data key="d1">organization</data>
      <data key="d2">Described as major opinion leaders in Philadelphia's gardening community. They initially disrespected Greensgrow, prompting the farm to start growing flowers to earn their respect and patronage.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Marketing System for Commodities">
      <data key="d0">Marketing System for Commodities</data>
      <data key="d1">category</data>
      <data key="d2">A system for price discovery based on supply and demand, which the author claims has failed due to the consolidation of agriculture.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Decentralized Agriculture">
      <data key="d0">Decentralized Agriculture</data>
      <data key="d1">category</data>
      <data key="d2">A key component of the author's vision for the future, characterized by localized, seasonal food production, which contrasts with consolidated, conventional agriculture.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Seasonal Diet">
      <data key="d0">Seasonal Diet</data>
      <data key="d1">category</data>
      <data key="d2">A dietary pattern based on consuming foods that are in season locally. The author connects this shift to the rise of a decentralized agricultural system.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Storey's Guide to Raising Llamas">
      <data key="d0">Storey's Guide to Raising Llamas</data>
      <data key="d1">category</data>
      <data key="d2">A book written by Gale Birutta and published by Storey Publishing. It is recommended as an in-depth guide on its topic.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Manual of Exotic Pets">
      <data key="d0">Manual of Exotic Pets</data>
      <data key="d1">category</data>
      <data key="d2">A resource book co-authored by Peter H. Benyon and John E. Cooper, published by Iowa State University Press, which serves as a guide to exotic mammals, birds, and reptiles.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Storey's Guide to Raising Farm Animals Series">
      <data key="d0">Storey's Guide to Raising Farm Animals Series</data>
      <data key="d1">category</data>
      <data key="d2">A series of books published by Storey Publishing that the author particularly recommends to aspiring farmers.</data>
      <data key="d3">chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Ames, Ia">
      <data key="d0">Ames, Ia</data>
      <data key="d1">geo</data>
      <data key="d2">The city and state in Iowa where the Iowa State University Press is located.&lt;SEP&gt;The city in Iowa where Iowa State University Press is located.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="North Adams, Ma">
      <data key="d0">North Adams, Ma</data>
      <data key="d1">geo</data>
      <data key="d2">North Adams, Ma is a city in Massachusetts that serves as the location of the publisher Storey Publishing. It is also the publication city for several books by the company, and this location is often indicated in book citations.</data>
      <data key="d3">chunk-a25021ab306ceaf5d58e192cc6fc0a84&lt;SEP&gt;chunk-e410bfae74fb6896e8e0079e060cf83d&lt;SEP&gt;chunk-f19adc067f85e17ae856f88441c8e7d8&lt;SEP&gt;chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-ea1bfb736a960a0ceee22d5eb6f8e955</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Greensgrow Csa">
      <data key="d0">Greensgrow Csa</data>
      <data key="d1">organization</data>
      <data key="d2">The Community Supported Agriculture program run by Greensgrow, which grew from 25 to 375 shareholders by 2010. It is noted for offering a diverse weekly basket with products from a wide range of regional growers and businesses.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Biodiesel Production">
      <data key="d0">Biodiesel Production</data>
      <data key="d1">category</data>
      <data key="d2">A key sustainability initiative at Greensgrow Farm. The farm produces its own biodiesel from waste vegetable oil to power its vehicles, serving as an educational example of a 'green' farm system.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Hydroponic Greens">
      <data key="d0">Hydroponic Greens</data>
      <data key="d1">category</data>
      <data key="d2">The initial primary product grown by Greensgrow, specifically production-level hydroponic lettuce. The focus on this single crop led to an initial lack of respect from the local horticulture community.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="City Restaurants">
      <data key="d0">City Restaurants</data>
      <data key="d1">organization</data>
      <data key="d2">A group of three local restaurants that supply Greensgrow with used vegetable oil, which is then used to create biodiesel for the farm's vehicles.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Rural Areas">
      <data key="d0">Rural Areas</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic and cultural concept representing the countryside. Mary Corboy actively tries to change the negative perceptions that people from rural areas hold about cities and urban farms.&lt;SEP&gt;Geographic and community areas, like those with farms and ranches, that Widmark believes should be valued by urban communities as essential sources of food and a healthy landscape, rather than just land for subdivisions.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-087cef03c5ab256c59a3f536c4533b6d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Gourmet">
      <data key="d0">Gourmet</data>
      <data key="d1">organization</data>
      <data key="d2">A magazine mentioned to characterize the target demographic for the Greensgrow CSA. The ideal customer is described as a young urban person who subscribes to such publications but may lack cooking skills.&lt;SEP&gt;Gourmet is a publication that has featured Sunburst Trout Farm's golden-orange trout caviar, contributing to its national recognition.</data>
      <data key="d3">chunk-2e143d750d8e9b45fec3f4d1a9ec2a04&lt;SEP&gt;chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Richter">
      <data key="d0">Richter</data>
      <data key="d1">person</data>
      <data key="d2">Richter is an innovator who single-handedly built and operates an efficient biodiesel production system at Greensgrow. He converts used vegetable oil from local restaurants into biodiesel and also purifies the glycerin by-product to be made into 'local' soap.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="James Harvey Johnson">
      <data key="d0">James Harvey Johnson</data>
      <data key="d1">person</data>
      <data key="d2">Co-author of 'Husbandry and Medical Management of Ostriches, Emus, and Rheas'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Stanley T. Weiner">
      <data key="d0">Stanley T. Weiner</data>
      <data key="d1">person</data>
      <data key="d2">Co-author of 'Husbandry and Medical Management of Ostriches, Emus, and Rheas'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Wildlife and Exotic Animal Consultants">
      <data key="d0">Wildlife and Exotic Animal Consultants</data>
      <data key="d1">organization</data>
      <data key="d2">The publisher of the guide to raising ratites (ostriches, emus, and rheas), located in College Station, Texas.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="College Station, Tx">
      <data key="d0">College Station, Tx</data>
      <data key="d1">geo</data>
      <data key="d2">The city in Texas where Wildlife and Exotic Animal Consultants is located.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Russell Kyle">
      <data key="d0">Russell Kyle</data>
      <data key="d1">person</data>
      <data key="d2">Author of 'A Feast in the Wild', which examines the food use of exotic species.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Kudu Publishing">
      <data key="d0">Kudu Publishing</data>
      <data key="d1">organization</data>
      <data key="d2">A publisher based in Oxford, UK, that released 'A Feast in the Wild'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Oxford, Uk">
      <data key="d0">Oxford, Uk</data>
      <data key="d1">geo</data>
      <data key="d2">The city in the United Kingdom where Kudu Publishing is located.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Josef Von Kerckerinck">
      <data key="d0">Josef Von Kerckerinck</data>
      <data key="d1">person</data>
      <data key="d2">Author of 'Deer Farming in North America', a guide to raising fallow deer.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Corboy">
      <data key="d0">Corboy</data>
      <data key="d1">person</data>
      <data key="d2">Corboy is a key leader at Greensgrow, described as a creative and driving force. She develops the 'agri-edu-tainment' strategy, manages crop selection, plans community events like farm-to-table dinners, and is the keeper of the farm's beehives.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="City's Water Department">
      <data key="d0">City's Water Department</data>
      <data key="d1">organization</data>
      <data key="d2">A municipal department in Philadelphia that purchases refined, cleaner-grade biodiesel from Greensgrow. It uses the fuel for its 'green' boat that cleans garbage from the Delaware River, opting for a non-toxic fuel source.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Biodiesel">
      <data key="d0">Biodiesel</data>
      <data key="d1">category</data>
      <data key="d2">A renewable fuel derived from biological sources, listed as a topic.&lt;SEP&gt;A renewable fuel used by Seeds of Solidarity's family car and farm truck. It is a key part of their strategy to reduce reliance on petroleum-based fossil fuels.&lt;SEP&gt;Biodiesel is a biodegradable fuel produced from used vegetable oil. The text details its production process at Greensgrow, its cost-effectiveness compared to gasoline, and its use in farm vehicles and a municipal boat.</data>
      <data key="d3">chunk-bf0fadd2de5cdd877a432eba713a59ce&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Agri-Edu-Tainment">
      <data key="d0">Agri-Edu-Tainment</data>
      <data key="d1">category</data>
      <data key="d2">A concept created by Corboy to describe Greensgrow's mission of combining agriculture, education, and entertainment. It includes activities like children's farm tours, demonstrative crop planting, and community dinners.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Blanche">
      <data key="d0">Blanche</data>
      <data key="d1">person</data>
      <data key="d2">Blanche is the black farm cat at Greensgrow who serves as a mascot. She is the ostensible 'author' of the hand-painted interpretive signs for the children's farm tour, making education fun and engaging.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Summer Farm-To-Table Dinner">
      <data key="d0">Summer Farm-To-Table Dinner</data>
      <data key="d1">event</data>
      <data key="d2">An event held at Greensgrow in 2009 as part of its 'agri-edu-tainment' initiative. It featured a 50-person dinner set in the middle of the farm and was designed to engage the community.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Glycerin">
      <data key="d0">Glycerin</data>
      <data key="d1">category</data>
      <data key="d2">A by-product from the biodiesel production process. Richter collects glycerin from his own operation and from others in the city, purifies it, and explains it can be made into 'local' soap, thus preventing waste from polluting the storm-water system.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="CSA Market">
      <data key="d0">CSA Market</data>
      <data key="d1">category</data>
      <data key="d2">Greensgrow's Community Supported Agriculture market. It is a significant part of the farm's operation, involving 80 producers, and serves as a source for produce like corn, complementing what is grown on-site.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Phanter Press">
      <data key="d0">Phanter Press</data>
      <data key="d1">organization</data>
      <data key="d2">A publisher based in Rhinebeck, New York, that released 'Deer Farming in North America'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Rhinebeck, Ny">
      <data key="d0">Rhinebeck, Ny</data>
      <data key="d1">geo</data>
      <data key="d2">The city in New York where Phanter Press is located.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="David Yerex">
      <data key="d0">David Yerex</data>
      <data key="d1">person</data>
      <data key="d2">Co-author of 'Modern Deer Farm Management'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Ian Spiers">
      <data key="d0">Ian Spiers</data>
      <data key="d1">person</data>
      <data key="d2">Co-author of 'Modern Deer Farm Management'.</data>
      <data key="d3">chunk-2920f4362eb05a4692fa915ca812b425</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Ampersand Publishing">
      <data key="d0">Ampersand Publishing</data>
