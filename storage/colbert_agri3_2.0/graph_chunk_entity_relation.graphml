      <data key="d1">organization</data>
      <data key="d2">An agricultural service that was contracted by the DuPont Company to perform a study in 1996 about farmer motivations and practices.</data>
      <data key="d3">chunk-0f1ce27dcb115879ec30587ba69b4095</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Henry Ford">
      <data key="d0">Henry Ford</data>
      <data key="d1">person</data>
      <data key="d2">An influential historical figure quoted by the author to support the idea that being close to the land provides security.</data>
      <data key="d3">chunk-0f1ce27dcb115879ec30587ba69b4095</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
