    <node id="Wallace Genetics Foundation">
      <data key="d0">Wallace Genetics Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">The Wallace Genetics Foundation is a philanthropic organization that provided funding to Barker in 2003, enabling him to support garden projects in Boston, Portland, and Flint.</data>
      <data key="d3">chunk-82372fd5a606e148caa2a0647673892b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740785</data>
