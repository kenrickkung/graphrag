      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Complete Two-Story Hive" target="Outer Cover">
      <data key="d6">9.0</data>
      <data key="d7">The Outer Cover is the top protective layer of a Complete Two-Story Hive, shielding it from weather.</data>
