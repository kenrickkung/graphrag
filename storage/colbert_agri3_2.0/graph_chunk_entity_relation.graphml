    </edge>
    <edge source="Western Hemisphere" target="Africanized Bees">
      <data key="d6">6.0</data>
      <data key="d7">The Western Hemisphere is the broad geographical area where Africanized bees were introduced and have been spreading north for over three decades.</data>
