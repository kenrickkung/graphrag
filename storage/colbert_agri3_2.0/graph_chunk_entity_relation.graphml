    </edge>
    <edge source="Frames" target="Bridge Comb">
      <data key="d6">9.0</data>
      <data key="d7">Bridge Comb is a problematic structure that connects and fuses two adjacent Frames, making them impossible to handle separately during an inspection.</data>
