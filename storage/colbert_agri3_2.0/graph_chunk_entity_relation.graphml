    <node id="South End/Lower Roxbury Open Space Land Trust (SELROSLT)">
      <data key="d0">South End/Lower Roxbury Open Space Land Trust (SELROSLT)</data>
      <data key="d1">organization</data>
      <data key="d2">A land trust that manages the Worcester Street Garden. The organization's director is Betsy Johnson, and it successfully secured a donation from a local business to replace toxic railroad ties in the garden.</data>
      <data key="d3">chunk-07f097aee6be0e05076e0e695419438a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740821</data>
    </node>
    <node id="Janus Youth Farm And Gardens">
      <data key="d0">Janus Youth Farm And Gardens</data>
      <data key="d1">organization</data>
      <data key="d2">A farm and garden organization focused on youth development. It prioritizes safety and emotional growth by requiring all members to sign a 'community contract' that functions as a code of conduct.</data>
      <data key="d3">chunk-07f097aee6be0e05076e0e695419438a</data>
      <data key="d4">unknown_source</data>
