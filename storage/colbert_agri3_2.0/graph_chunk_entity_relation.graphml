      <data key="d10">unknown_source</data>
      <data key="d11">1753740508</data>
    </edge>
    <edge source="The Africanized Bee" target="Beehive">
      <data key="d6">8.0</data>
      <data key="d7">The Africanized bee threatens existing beehives through interbreeding (when virgin queens mate with Africanized drones) and aggressive behavior, altering the colony's characteristics.</data>
      <data key="d8">colony threat,genetic takeover,hybridization</data>
