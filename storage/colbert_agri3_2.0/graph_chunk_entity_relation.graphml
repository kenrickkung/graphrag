    <node id="Vancouver Convention Centre">
      <data key="d0">Vancouver Convention Centre</data>
      <data key="d1">geo</data>
      <data key="d2">A location in Vancouver featuring a nearly 6-acre green roof, the largest in Canada, which is home to four beehives and about 60,000 bees.</data>
      <data key="d3">chunk-b52b5200e77354191139029d689fb62d</data>
