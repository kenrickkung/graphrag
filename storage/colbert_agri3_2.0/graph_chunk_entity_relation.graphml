      <data key="d0">Harvard Graduate School Of Design</data>
      <data key="d1">organization</data>
      <data key="d2">An academic institution that has integrated food systems into its curriculum by introducing a course called 'Food Forms: Agriculture in Urban Systems'.</data>
      <data key="d3">chunk-a80590371c3ba416132df035a1f48358</data>
      <data key="d4">unknown_source</data>
