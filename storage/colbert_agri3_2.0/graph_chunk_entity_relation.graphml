      <data key="d6">6.0</data>
      <data key="d7">Greensgrow and Lynchburg Grows are presented together as examples of successful urban farms whose customers come from all sections of their respective cities, not just the immediate neighborhoods.</data>
      <data key="d8">case study,market reach</data>
      <data key="d9">chunk-626a48dbfe67b1f55d1d46c5b8d30097</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
