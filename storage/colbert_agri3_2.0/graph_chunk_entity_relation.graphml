    <edge source="Walking Fish" target="Community-Supported Fishery (Csf)">
      <data key="d6">10.0</data>
      <data key="d7">Walking Fish is a direct implementation of the Community-Supported Fishery (CSF) model, applying its principles to connect local fishermen with consumers.</data>
      <data key="d8">business model,implementation</data>
      <data key="d9">chunk-bf0fadd2de5cdd877a432eba713a59ce</data>
