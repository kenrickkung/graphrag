    </node>
    <node id="Doc Hatfield">
      <data key="d0">Doc Hatfield</data>
      <data key="d1">person</data>
      <data key="d2">A member of the Hatfield family, whose ranch is part of the Country Natural Beef cooperative. He is pictured participating in the hands-on work of ranching, specifically walking cows and calves into a corral.</data>
      <data key="d3">chunk-09e000817f207794412f1a62763dda17</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740879</data>
    </node>
    <node id="Travis Hatfield">
      <data key="d0">Travis Hatfield</data>
      <data key="d1">person</data>
      <data key="d2">A member of the Hatfield family involved in the daily operations of their ranch. He is shown working with cattle, replacing diesel-powered pumps with solar panels, and his family works with the Audubon Society on conservation efforts.</data>
      <data key="d3">chunk-09e000817f207794412f1a62763dda17</data>
      <data key="d4">unknown_source</data>
