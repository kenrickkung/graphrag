      <data key="d0">Chefs A' Field</data>
      <data key="d1">organization</data>
      <data key="d2">'Chefs A' Field' is a national TV show that visited and filmed at Sunburst Trout Farm, contributing to its national publicity and reputation.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Food Nation">
      <data key="d0">Food Nation</data>
      <data key="d1">organization</data>
      <data key="d2">'Food Nation' is a national TV show that featured Sunburst Trout Farm, filming on-site and increasing the farm's national exposure.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Sally Eason's Father">
      <data key="d0">Sally Eason's Father</data>
      <data key="d1">person</data>
      <data key="d2">The founder of Sunburst Trout Farm in 1948. He was an honors engineering student at Yale who dropped out to pioneer the first commercial trout farm in the South.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
