    <node id="Peaceful Valley Farm Supply">
      <data key="d0">Peaceful Valley Farm Supply</data>
      <data key="d1">organization</data>
      <data key="d2">Located in Grass Valley, California, Peaceful Valley Farm Supply sells natural supplies for farming and gardening, including irrigation equipment.</data>
