    </edge>
    <edge source="Mie N Yu" target="Molovinsky">
      <data key="d6">10.0</data>
      <data key="d7">Molovinsky is the leader at Mie N Yu who drove the implementation of its whole-animal program, including menu engineering and rethinking kitchen processes like making stock.</data>
      <data key="d8">leadership,program implementation,strategy</data>
      <data key="d9">chunk-65dc312cbeeaa82060b27a69060e671d</data>
      <data key="d10">unknown_source</data>
