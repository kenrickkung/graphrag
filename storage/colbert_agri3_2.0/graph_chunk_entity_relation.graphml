      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Winter" target="Farm Labor">
      <data key="d6">9.0</data>
      <data key="d7">The author's entire farm management strategy is built around minimizing Farm Labor during the Winter, which is described as a period of harsh weather and high operational costs.</data>
