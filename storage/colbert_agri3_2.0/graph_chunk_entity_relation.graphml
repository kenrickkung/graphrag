    <node id="Federal Emergency Relief Administration">
      <data key="d0">Federal Emergency Relief Administration</data>
      <data key="d1">organization</data>
      <data key="d2">A U.S. federal agency that funded community gardens during the Depression of the 1930s as a form of relief.</data>
      <data key="d3">chunk-43ebc646508b0f93fb43f529856b4d56</data>
      <data key="d4">unknown_source</data>
