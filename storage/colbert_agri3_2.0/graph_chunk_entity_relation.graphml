      <data key="d1">category</data>
      <data key="d2">An agricultural enterprise focused on raising sheep for meat, based on a model achieving 5 lbs. at 10 weeks. This enterprise generates a gross income of $2,800.00 and a net profit of $1,271.00, with expenses primarily from feed, and requires 200 hours of labor.</data>
      <data key="d3">chunk-a6d072f41d662cb326c1c528ac3c5c51</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740821</data>
    </node>
    <node id="Sheep (Ewe And Lamb)">
      <data key="d0">Sheep (Ewe And Lamb)</data>
      <data key="d1">category</data>
      <data key="d2">A sheep farming enterprise based on one ewe with a spring lamb, yielding a 150% lamb crop. It generates income from the sale of the lamb, a cull ewe, and added-value wool. The net profit is calculated at $90.25 with a labor requirement of 6 hours.</data>
      <data key="d3">chunk-a6d072f41d662cb326c1c528ac3c5c51</data>
      <data key="d4">unknown_source</data>
