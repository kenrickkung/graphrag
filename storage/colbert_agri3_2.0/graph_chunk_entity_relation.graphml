    <node id="Ché Madyun">
      <data key="d0">Ché Madyun</data>
      <data key="d1">person</data>
      <data key="d2">The president of Boston's Dudley Street Neighborhood Initiative. She was a key influencer, along with Allan Callahan, in shaping The Food Project's foundational principles, ensuring youths work together in both suburban and inner-city settings.</data>
      <data key="d3">chunk-07d81959e2e7dfd429fb34ce74beae5e</data>
