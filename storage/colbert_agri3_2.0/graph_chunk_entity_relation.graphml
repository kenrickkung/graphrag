      <data key="d11">1753740472</data>
    </edge>
    <edge source="Honey Bee" target="Wasp">
      <data key="d6">8.0</data>
      <data key="d7">The text explicitly distinguishes the honey bee from the wasp, noting they are different insects that are frequently confused by the public.</data>
      <data key="d8">biological distinction,comparison,public perception</data>
