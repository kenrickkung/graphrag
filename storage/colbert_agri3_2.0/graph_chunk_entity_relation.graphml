      <data key="d11">1753740508</data>
    </edge>
    <edge source="Pesticides" target="Fungicides">
      <data key="d6">8.0</data>
      <data key="d7">Fungicides are identified as a specific category of pesticide whose effects on honey bees can range from benign to lethal.</data>
      <data key="d8">chemical type,classification,threat profile</data>
      <data key="d9">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
