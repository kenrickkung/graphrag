    <node id="Janus Youth Village Gardens Program">
      <data key="d0">Janus Youth Village Gardens Program</data>
      <data key="d1">organization</data>
      <data key="d2">A program run by Janus Youth that establishes and supports community gardens, such as the Seeds of Harmony garden. It focuses on empowering communities through relationship-building and a strength-based approach.</data>
      <data key="d3">chunk-1a815073ae837fa29833af41e55990ca</data>
