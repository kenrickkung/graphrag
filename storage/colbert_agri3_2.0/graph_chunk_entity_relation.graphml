      <data key="d1">organization</data>
      <data key="d2">A university that hosts the Idaho College of Agricultural Life Sciences and provides new-farmer packets.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690</data>
      <data key="d4">unknown_source</data>
