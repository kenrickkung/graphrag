      <data key="d10">unknown_source</data>
      <data key="d11">1753740878</data>
    </edge>
    <edge source="The Author" target="Sausage hogs">
      <data key="d6">7.0</data>
      <data key="d7">The author raises sausage hogs, feeding them with corn grown on the farm, as a component of their overall farming operation.</data>
      <data key="d8">feed system,livestock management</data>
      <data key="d9">chunk-551c4a3f4f76cd87581e1acc8d4a5d71</data>
