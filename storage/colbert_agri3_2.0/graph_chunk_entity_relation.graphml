    <edge source="Bottom Board Inserts" target="Tobacco Smoke">
      <data key="d6">9.0</data>
      <data key="d7">Tobacco smoke is used in conjunction with bottom board inserts as a non-chemical method to stun mites and cause them to fall onto the insert for detection.</data>
