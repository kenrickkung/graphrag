    <edge source="Nonprofit" target="Mission Drift">
      <data key="d6">9.0</data>
      <data key="d7">The text identifies 'mission drift' as a common danger for nonprofits, often caused by 'chasing the money' from grants instead of focusing on core services.</data>
      <data key="d8">organizational risk,strategic management</data>
      <data key="d9">chunk-e0adcf3a18e5a064a6ed2b9d46dff75f</data>
