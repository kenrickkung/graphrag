      <data key="d0">Langston University</data>
      <data key="d1">organization</data>
      <data key="d2">A university that hosts a Research &amp; Extension program focusing on topics like aquaculture and goats.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740838</data>
    </node>
