      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Hive Debris" target="Skimming">
      <data key="d6">9.0</data>
      <data key="d7">Skimming is a purification technique used to remove hive debris from honey after allowing it to settle and rise to the top.</data>
      <data key="d8">purification method,separation</data>
