    <edge source="Comb Honey" target="Hive Products">
      <data key="d6">10.0</data>
      <data key="d7">Comb honey is a primary product from a beehive and is a central topic of the text, fitting into the broader category of materials produced by bees.</data>
      <data key="d8">beekeeping harvest,product classification,source</data>
