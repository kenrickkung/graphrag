      <data key="d11">1753740878</data>
    </edge>
    <edge source="The Author" target="Poultry">
      <data key="d6">7.0</data>
      <data key="d7">The author raises poultry as part of their farm, noting that pasturing them reduces feed costs and improves the final product.</data>
      <data key="d8">livestock management,production method</data>
