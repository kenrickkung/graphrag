      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Pollen" target="Minerals">
      <data key="d6">7.0</data>
      <data key="d7">Pollen is a key source of minerals for bees, which they collect as part of their diet.</data>
