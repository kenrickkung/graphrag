    <node id="The Housing Authority">
      <data key="d0">The Housing Authority</data>
      <data key="d1">organization</data>
      <data key="d2">A public authority that initiated the New Columbia garden project and provides significant support for the community-run store, including leasing the building at no cost and underwriting utilities.</data>
      <data key="d3">chunk-16d7d0c8754f5ccddfb78068c25f0fa0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Seeds of Harmony">
      <data key="d0">Seeds of Harmony</data>
      <data key="d1">organization</data>
      <data key="d2">A community garden project within the Janus Youth Village Gardens program, located in the New Columbia housing development. It serves a diverse, mixed-income community, fostering social integration and empowerment, with gardeners setting their own guidelines.&lt;SEP&gt;The community garden in New Columbia, established with mentorship from Village Gardens. It is a hub for residents like Eca Etabo Wasongolo, Agnes Sola, and Michelle Hanna to grow food, build community, and develop skills.</data>
      <data key="d3">chunk-16d7d0c8754f5ccddfb78068c25f0fa0&lt;SEP&gt;chunk-1a815073ae837fa29833af41e55990ca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Northwest Health Foundation">
      <data key="d0">Northwest Health Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that provided a grant to fund community-based research into the long-term health impacts of the community gardens.&lt;SEP&gt;The Northwest Health Foundation is a grant-making organization that provided funding to plan for community-based research into the long-term health impacts of working in community gardens like those run by Janus Youth.</data>
      <data key="d3">chunk-45291ea55455adae718c5031c0e8dfff&lt;SEP&gt;chunk-16d7d0c8754f5ccddfb78068c25f0fa0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
