      <data key="d0">Sisters, Or</data>
      <data key="d1">geo</data>
      <data key="d2">The city in Oregon where Farmers Book Service is located.&lt;SEP&gt;The location of Farmer's Book Service, the publisher of 'Ten Acres Enough'.&lt;SEP&gt;The location of the publisher Farmer's Book Service.</data>
      <data key="d3">chunk-f19adc067f85e17ae856f88441c8e7d8&lt;SEP&gt;chunk-2920f4362eb05a4692fa915ca812b425&lt;SEP&gt;chunk-ea1bfb736a960a0ceee22d5eb6f8e955</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740833</data>
    </node>
    <node id="Maurice Telleen">
      <data key="d0">Maurice Telleen</data>
      <data key="d1">person</data>
      <data key="d2">Author of 'The Draft Horse Primer', a guide to work horses and mules.</data>
