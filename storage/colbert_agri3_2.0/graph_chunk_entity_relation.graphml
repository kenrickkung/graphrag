    </edge>
    <edge source="Installing A Package Of Bees" target="Package Container">
      <data key="d6">9.0</data>
      <data key="d7">The process of installing a package of bees involves shaking the bees from the package container into their new hive.</data>
      <data key="d8">bee transfer,process tool</data>
