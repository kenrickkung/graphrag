      <data key="d11">1753740880</data>
    </edge>
    <edge source="Stinging" target="Bee Sting">
      <data key="d6">10.0</data>
      <data key="d7">Stinging is the action performed by a bee, while a bee sting is the resulting event that causes a physical reaction in a person.</data>
      <data key="d8">action-event,cause and effect,trigger</data>
