    </node>
    <node id="Puerto Rican Culture">
      <data key="d0">Puerto Rican Culture</data>
      <data key="d1">category</data>
      <data key="d2">A central theme in the work of Nuestras Raíces, particularly at La Finca. It is celebrated through traditional crops like 'ajies dulces', Paso Fino horses, community pig roasts ('lechonaria'), and music festivals.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Mercury Contamination">
      <data key="d0">Mercury Contamination</data>
      <data key="d1">category</data>
      <data key="d2">A specific environmental pollutant found in the Connecticut River, making fish caught there unsafe to eat and requiring public education for Holyoke residents.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Poor Air Quality">
      <data key="d0">Poor Air Quality</data>
      <data key="d1">category</data>
      <data key="d2">A city-wide environmental health issue in Holyoke, identified by the EPA, that exacerbates chronic pulmonary problems and prompted educational workshops on healthy home environments.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Ajies Dulces">
      <data key="d0">Ajies Dulces</data>
      <data key="d1">category</data>
      <data key="d2">A type of sweet pepper described as the 'prize of Puerto Rican cuisine.' It is grown by farmers at La Finca and is a key ingredient for 'sofrito'.</data>
      <data key="d3">chunk-8dfe2a17435f059c92535241799795b4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Andaluz">
      <data key="d0">Andaluz</data>
      <data key="d1">person</data>
      <data key="d2">Andaluz is a representative of Nuestras Raíces who discusses the challenges farmers face, such as seasonal planning and marketing, and provides details on the organization's farmer training course.</data>
      <data key="d3">chunk-7ee782c1d8a631cff4fafc639994eb42</data>
      <data key="d4">unknown_source</data>
