    <node id="Brownfield site">
      <data key="d0">Brownfield site</data>
      <data key="d1">category</data>
      <data key="d2">A type of contaminated land, such as a former industrial site. Mentioned by Mary Seton Corboy as a significant liability risk for landowners, reinforcing her advice for urban farmers to lease rather than purchase land.</data>
      <data key="d3">chunk-959e33ece6a9fc720452b33659ca7996</data>
