    <node id="Shrimp">
      <data key="d0">Shrimp</data>
      <data key="d1">category</data>
      <data key="d2">A type of crustacean that accounts for 25% of fresh and frozen seafood consumed in the United States, with farm-raised shrimp making up a significant portion of the supply.&lt;SEP&gt;An example of an unconventional alternative crop (aquaculture) that a farmer could potentially raise.</data>
      <data key="d3">chunk-db06dd0bc574d59f7ffa8848b9ae23fd&lt;SEP&gt;chunk-fb9d28e4a28ca972c9e289441c78c0be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Tilapia">
      <data key="d0">Tilapia</data>
      <data key="d1">category</data>
      <data key="d2">A type of meat fish specifically mentioned as being suitable for use in recirculating aquaculture systems.&lt;SEP&gt;A warm-water fish species raised by Growing Power in tanks inside its greenhouses. The process of heating the water for the tilapia also provides a heat source for the plants.</data>
      <data key="d3">chunk-fa54079f022f9b869fe9a285cb16fa6a&lt;SEP&gt;chunk-fb9d28e4a28ca972c9e289441c78c0be</data>
