    <node id="Beekeeping Books">
      <data key="d0">Beekeeping Books</data>
      <data key="d1">category</data>
      <data key="d2">A category of publications providing knowledge on bee biology and management. The text emphasizes the importance of recent books over older ones due to significant advances in the understanding of bee biology.</data>
      <data key="d3">chunk-d711f27560f7987b017b85fa9c8a2e56</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Southern United States">
      <data key="d0">Southern United States</data>
      <data key="d1">geo</data>
      <data key="d2">A geographical region in the U.S. where a common 5-year, long-term crop rotation is practiced.&lt;SEP&gt;A region characterized by milder winters and greater soil leaching, where a fall crop like rye is recommended after a green manure to hold nutrients until spring planting.&lt;SEP&gt;A specific region in the United States where incidents involving bees could lead to public panic and subsequent restrictive regulations on beekeeping.</data>
      <data key="d3">chunk-b66ffae2696b4f9024085ef90af5320a&lt;SEP&gt;chunk-d711f27560f7987b017b85fa9c8a2e56&lt;SEP&gt;chunk-5b320d4bf5bae3f28f4bca97246cd735</data>
