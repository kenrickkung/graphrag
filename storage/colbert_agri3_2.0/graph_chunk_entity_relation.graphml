      <data key="d2">"A prestigious horse racing event whose winning horses were crowned with roses that originated from the Schenkel's greenhouse complex."&gt;</data>
      <data key="d3">chunk-5b97e15a0b1c4d19efdaa6af5f597519</data>
      <data key="d4">unknown_source</data>
