      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Pollen" target="Vitamins">
      <data key="d6">9.0</data>
      <data key="d7">Pollen is described as having an exceptionally high content of vitamins, which are essential for the growth and development of bees.</data>
