    <edge source="Chipotle Mexican Grill" target="Polyface">
      <data key="d6">9.0</data>
      <data key="d7">Polyface acts as a pork supplier to Chipotle Mexican Grill. This partnership required extensive collaboration to integrate Polyface's locally-raised product into Chipotle's national food-service system, including recipe and logistical adjustments.</data>
      <data key="d8">business collaboration,supplier partnership,supply chain integration</data>
      <data key="d9">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d10">unknown_source</data>
