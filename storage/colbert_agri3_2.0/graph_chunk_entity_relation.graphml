    </edge>
    <edge source="Bee Sting" target="Allergic Reaction">
      <data key="d6">10.0</data>
      <data key="d7">Successive bee stings can cause an individual to develop a true allergic reaction, where they become increasingly intolerant to the venom.</data>
      <data key="d8">cause and effect,health risk,sensitization</data>
      <data key="d9">chunk-fc749ae5b6e2c5fae540d31c52a16691</data>
