    </edge>
    <edge source="Worker Bee" target="Brood Rearing">
      <data key="d6">9.0</data>
      <data key="d7">Brood rearing is identified as a primary activity of the colony that is carried out by the worker bees.</data>
      <data key="d8">colony maintenance,labor</data>
