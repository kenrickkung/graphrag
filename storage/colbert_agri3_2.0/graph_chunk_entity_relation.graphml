      <data key="d11">1753740472</data>
    </edge>
    <edge source="Brood" target="Swarm Control">
      <data key="d6">7.0</data>
      <data key="d7">Removing brood, either permanently or temporarily, is a measure used for swarm control.</data>
      <data key="d8">management technique,population control</data>
