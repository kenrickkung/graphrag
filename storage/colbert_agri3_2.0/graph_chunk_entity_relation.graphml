      <data key="d0">Sally Eason's Sons' Wives</data>
      <data key="d1">person</data>
      <data key="d2">Family members who are part of the dozen or so staff working at the family-owned Sunburst Trout Farm.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Chef Hudson">
      <data key="d0">Chef Hudson</data>
      <data key="d1">person</data>
      <data key="d2">A chef who creates innovative products from trout, volunteers with the Appalachian Sustainable Agriculture Project to expose children to fresh trout, and was invited to the White House as part of Michelle Obama's Move Chefs to Schools initiative.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Move Chefs to Schools">
      <data key="d0">Move Chefs to Schools</data>
      <data key="d1">event</data>
      <data key="d2">A White House initiative created by Michelle Obama to connect chefs with local schools to help educate children about food and healthy eating. Chef Hudson was a recognized participant.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Australis Aquaculture">
      <data key="d0">Australis Aquaculture</data>
      <data key="d1">organization</data>
      <data key="d2">Australis Aquaculture is an internationally recognized aquaculture company founded by Joshua Goldman in 2004. The company specializes in the sustainable farming of barramundi, for which it is known for its inventive and environmentally friendly technology. This technology utilizes closed-containment systems, which have also been described as an innovative "water filtration system with fish in it." Headquartered in Turners Falls, Massachusetts, Australis Aquaculture also operates facilities in Vietnam and Indonesia. Carol Devine and Josh Goldman are listed as representatives of the organization.</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-16c3fe8c089550fd16987a1c4f301a2e&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Turners Falls, Massachusetts">
      <data key="d0">Turners Falls, Massachusetts</data>
      <data key="d1">geo</data>
      <data key="d2">A village located in the state of Massachusetts, mentioned as a relevant location.&lt;SEP&gt;The town where Australis Aquaculture was founded and established its first barramundi fish farm, which serves as a model of sustainable practices.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Joshua Goldman">
      <data key="d0">Joshua Goldman</data>
      <data key="d1">person</data>
      <data key="d2">Founder and CEO of Australis Aquaculture and a biologist from Hampshire College. He is a key innovator in sustainable fisheries, having selected the barramundi and designed a closed-containment system to address environmental issues in fish farming.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Barramundi">
      <data key="d0">Barramundi</data>
      <data key="d1">category</data>
      <data key="d2">A fish native to Australia, prized for its culinary appeal. It is presented as an ideal fish for sustainable farming due to its durability, efficient protein conversion on a vegetarian diet, and low risk of accumulating toxins.&lt;SEP&gt;Barramundi is a type of fish selected for sustainable farming by Australis Aquaculture. It is noted for its ability to convert feed to protein efficiently, produce omega-3 fatty acids on a vegetarian diet, and its low risk of accumulating toxins.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Worldwatch Institute">
      <data key="d0">Worldwatch Institute</data>
      <data key="d1">organization</data>
      <data key="d2">A research institute cited in the text for providing data on the waste produced by traditional salmon farms, which is used to contrast with the benefits of sustainable, closed-containment systems.&lt;SEP&gt;A research institute that published a piece questioning whether farmed fish can be a sustainable food source for the world's population.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e&lt;SEP&gt;chunk-8d6381862167ee0d108723409eae36d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Indonesia">
      <data key="d0">Indonesia</data>
      <data key="d1">geo</data>
      <data key="d2">A country where Australis Aquaculture has expanded its operations, raising barramundi in modern ocean pens.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Sunburst Trout">
      <data key="d0">Sunburst Trout</data>
      <data key="d1">category</data>
      <data key="d2">The specific brand or type of trout that Sally Eason raises and sells from her land-based farm. She educates customers about its sustainable qualities.</data>
      <data key="d3">chunk-16c3fe8c089550fd16987a1c4f301a2e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Josh Goldman">
      <data key="d0">Josh Goldman</data>
      <data key="d1">person</data>
      <data key="d2">A representative of Australis Aquaculture.&lt;SEP&gt;Josh Goldman is the co-founder and CEO of Australis Aquaculture. He traveled the world to find a fish that could be farmed sustainably, ultimately choosing barramundi for its favorable characteristics.</data>
      <data key="d3">chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Chipotle Mexican Grill">
      <data key="d0">Chipotle Mexican Grill</data>
      <data key="d1">organization</data>
      <data key="d2">Based on the information provided, Chipotle Mexican Grill is a national chain of fast-casual restaurants that operates under the motto "Food with Integrity." The company is a customer of Polyface Farm, having formed a partnership in 2008 to source its pasture-raised pork. This collaboration required significant effort to integrate a local farm's product into a national supply system, including overcoming logistical challenges and adapting Chipotle's recipes and cooking methods. This relationship reflects the company's broader interest in sourcing from local farms, although it finds it difficult to work with many small, individual suppliers due to its large volume requirements, and therefore prefers aggregated models such as co-ops.</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-8d6381862167ee0d108723409eae36d3&lt;SEP&gt;chunk-07373ff8a8e2c42149614780aa736a26&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Omnivore's Dilemma">
      <data key="d0">Omnivore's Dilemma</data>
      <data key="d1">event</data>
      <data key="d2">Omnivore's Dilemma is a highly influential book by Michael Pollan, published in 2007, which served as a major event in popularizing Joel Salatin's farming methods to a national audience.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Virginia Association of Biological Farming">
      <data key="d0">Virginia Association of Biological Farming</data>
      <data key="d1">organization</data>
      <data key="d2">The Virginia Association of Biological Farming is an organization that hosted the conference where Joel Salatin first publicly presented his Eggmobile invention.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Charlottesville, Virginia">
      <data key="d0">Charlottesville, Virginia</data>
      <data key="d1">geo</data>
      <data key="d2">Charlottesville, Virginia is the city where the Virginia Association of Biological Farming held the conference at which Joel Salatin debuted his Eggmobile.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Eggmobile">
      <data key="d0">Eggmobile</data>
      <data key="d1">category</data>
      <data key="d2">The Eggmobile is an innovative portable henhouse invented by Joel Salatin. It is a key example of his successful, labor-saving, and systems-based approach to pastured poultry at Polyface Farm.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Mark Neuzil">
      <data key="d0">Mark Neuzil</data>
      <data key="d1">person</data>
      <data key="d2">A writer for MinnPost.com who authored a piece about Joel Salatin, describing him as an 'Old-Time Innovator' running the successful Polyface Farm.&lt;SEP&gt;Mark Neuzil is a journalist who has reported on Joel Salatin's farming activities.&lt;SEP&gt;Mark Neuzil is a journalist who reported on Joel Salatin's farming experiments, including some that were not successful, such as those with sheep and ducks.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-8d6381862167ee0d108723409eae36d3&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740869</data>
    </node>
    <node id="Pastured Poultry System">
      <data key="d0">Pastured Poultry System</data>
      <data key="d1">category</data>
      <data key="d2">The Pastured Poultry System is a farming method developed by Joel Salatin at Polyface Farm. It involves raising chickens for meat and eggs on pasture using portable henhouses, and was first presented at a Virginia Association of Biological Farming conference.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Feathernet">
      <data key="d0">Feathernet</data>
      <data key="d1">category</data>
      <data key="d2">The Feathernet is a portable commercial henhouse and an improved version of the Eggmobile, developed by Joel Salatin to provide chickens with better protection and to be more space-efficient.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Millennium Feathernet">
      <data key="d0">Millennium Feathernet</data>
      <data key="d1">category</data>
      <data key="d2">The Millennium Feathernet is a further innovation by Joel Salatin, succeeding the Feathernet. It is a portable henhouse that features a self-watering and feeding system to reduce daily labor.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Cows">
      <data key="d0">Cows</data>
      <data key="d1">category</data>
      <data key="d2">Cows are an integral part of the Polyface Farm's rotational grazing system. They graze the pasture first, after which chickens are brought in to clean the area by eating insects from the cow manure.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Pigs">
      <data key="d0">Pigs</data>
      <data key="d1">category</data>
      <data key="d2">A type of livestock that the Model A farmer switched to raising in her third year, finding them physically less demanding than broilers, although yielding slightly less income.&lt;SEP&gt;Pigs are utilized at Polyface Farm within its integrated system. Their natural compulsion for rooting is harnessed to turn the farm's compost pile, reducing labor and machinery needs.&lt;SEP&gt;Pigs at Polyface farm are used in an integrated system to turn the farm's compost. They are also rotated through pasture and finished on acorns in a forested area, a process that is key to the farm's economic model and the quality of its pork.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-3699752bc52dee1358ad76a26a9c6fb9&lt;SEP&gt;chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Ducks">
      <data key="d0">Ducks</data>
      <data key="d1">category</data>
      <data key="d2">Ducks were part of a failed experiment by Joel Salatin at Polyface Farm. They were intended to control flies on cows but were unsuccessful as they spent too much time in the ponds.</data>
      <data key="d3">chunk-dd285deff310269197e8718b28f6076b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface">
      <data key="d0">Polyface</data>
      <data key="d1">organization</data>
      <data key="d2">Polyface is a 550-acre, family-run farm, led by Joel Salatin, that is known for its "beyond organic" and sustainable agricultural practices. With a core mission of "land healing," the farm utilizes an ecological, multi-culture system with intertwined, natural processes to raise a variety of animals, including cows, hogs, chickens, turkeys, and rabbits.

Polyface produces and sells a range of products such as milk, eggs, broilers, beef, and a specialty high-fat, acorn-finished pork. While its primary business model is local-focused, selling directly to consumers through on-farm sales and a Buying Club, the farm has also engaged in significant supply partnerships. Notably, it supplies pork to Chipotle Mexican Grill's Charlottesville restaurant, a venture that required overcoming challenges in transportation and packaging.

To expand its operations beyond its physical limits, Polyface has developed innovative business models (referred to as Model C and Model D) that involve partnering with and leasing other farms. It functions as a central hub for these new farmers, providing them with infrastructure, marketing, and financing, and selling their products under the Polyface brand. The farm is also dedicated to education, offering intensive internship and apprenticeship programs, including a summer program called the "Real Farm Experience," to train the next generation of farmers.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9&lt;SEP&gt;chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Sheri Salatin">
      <data key="d0">Sheri Salatin</data>
      <data key="d1">person</data>
      <data key="d2">Based on the information provided, Sheri Salatin is a key figure and representative for Polyface Farm, associated with Joel Salatin and likely a family member involved in the farm's operations. She serves as the manager of the Polyface Buying Club, where she plays a crucial role in the farm's direct-to-consumer sales model by handling customer communications and orders. Sheri Salatin provides detailed insights into the club's operations, including its customer rewards, packing logistics involving thermal bags and sheep tags, cooler labeling systems, and the transition to electronic invoicing. Furthermore, she helps convey the farm's philosophy of supporting other local farmers. In addition to her managerial duties, she offers commentary on the farm's immersive, year-round apprenticeship and internship program, describing the high expectations for participants who become part of the farm family and learn all aspects of the business.</data>
      <data key="d3">chunk-81005569d65546868c017fed474ad248&lt;SEP&gt;chunk-60121fd34d6b068a55f53ef625e1f266&lt;SEP&gt;chunk-3e930a3eb466e9bb1dfa38b0df50bfd3&lt;SEP&gt;chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Buying Club">
      <data key="d0">Polyface Buying Club</data>
      <data key="d1">category</data>
      <data key="d2">The Polyface Buying Club is a direct-to-consumer sales and delivery program initiated by Polyface Farm in 2001, which originated from a customer suggestion. Managed by Sheri Salatin, the club grew to account for 45% of the farm's sales by 2010, serving thousands of customers.

Operationally, the club delivers farm products to a network of drop-off points; as of 2009, it served 29 drop sites on a five-week rotation using refined logistics that include thermal bags and an efficient labeling system for coolers. The program is a key part of the farm's business model, as its direct demand for specific cuts like ribs and bacon helps Polyface sell the "whole hog." To enhance the economic viability of its delivery runs, the Polyface Buying Club also aggregates and sells products from other farms, such as Golden Acres Orchard. For customer engagement and communication, the club utilizes a private blog and a system that rewards customers for referrals.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8&lt;SEP&gt;chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-3e930a3eb466e9bb1dfa38b0df50bfd3&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Acorn Finishing">
      <data key="d0">Acorn Finishing</data>
      <data key="d1">category</data>
      <data key="d2">Acorn finishing is an innovative, cost-saving farming technique used by Polyface where pigs are raised in a forested area to forage for acorns. This method is noted to improve the quality of the pork, save the farm money on grain, and be beneficial for the forest ecosystem.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Real Farm Experience">
      <data key="d0">Real Farm Experience</data>
      <data key="d1">event</data>
      <data key="d2">The 'Real Farm Experience' is a summer internship program offered by Polyface farm. It provides eight interns with hands-on experience in sustainable agriculture, focusing on poultry operations, and includes workshops on farming practices.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="_Stockman Grass Farmer_">
      <data key="d0">_Stockman Grass Farmer_</data>
      <data key="d1">organization</data>
      <data key="d2">The _Stockman Grass Farmer_ is a publication in which Joel Salatin was interviewed about his methods for raising healthy pigs.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="The Forest">
      <data key="d0">The Forest</data>
      <data key="d1">geo</data>
      <data key="d2">A forested area that is an integral part of the Polyface farm ecosystem. It provides a perennial, free food source (acorns) for the pigs' finishing phase, and benefits from the periodic soil disturbance caused by the pigs.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Customers">
      <data key="d0">Polyface Customers</data>
      <data key="d1">category</data>
      <data key="d2">The consumer base for Polyface products, reported in 2010 to include over 3,000 families, 50 restaurants, and 10 retail outlets. They are also the target market for products from partner farmers, like the Model B farmer's milk.&lt;SEP&gt;The customer base of Polyface farm, described as loyal 'cheerleaders'. They are the sole reason for the farm's growth and engage directly through on-farm sales and the Buying Club, often responding to specific requests to purchase certain products.&lt;SEP&gt;The direct consumer base for Polyface farm's products. Customers who come to the farm to purchase specific items, like milk, are often exposed to and purchase other Polyface products, creating a synergistic marketing effect.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe&lt;SEP&gt;chunk-3699752bc52dee1358ad76a26a9c6fb9&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Loyal Customers From Maryland">
      <data key="d0">Loyal Customers From Maryland</data>
      <data key="d1">category</data>
      <data key="d2">A pair of dedicated customers from Maryland who initiated the concept of the Polyface Buying Club by asking Joel Salatin to make a delivery to them and successfully gathering a $3,000 order in 2001.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Summer Interns">
      <data key="d0">Summer Interns</data>
      <data key="d1">category</data>
      <data key="d2">A group of eight people who participate in Polyface's 'Real Farm Experience' each summer. They receive housing, a stipend, and intensive, hands-on training in sustainable agriculture, with a primary focus on raising poultry.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="A Church">
      <data key="d0">A Church</data>
      <data key="d1">organization</data>
      <data key="d2">A church group that became an early participant in the Polyface Buying Club. Their involvement led to the addition of a new delivery stop, contributing to the club's organic growth.</data>
      <data key="d3">chunk-ab7679e841cce082d6f5f864896c9afe</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Appalachian Sustainable Development">
      <data key="d0">Appalachian Sustainable Development</data>
      <data key="d1">organization</data>
      <data key="d2">Appalachian Sustainable Development (ASD) is a non-profit organization founded in 1995 by Anthony Flaccovento. Based in Abingdon in southwestern Virginia, its mission is to promote sustainable development in Appalachia by building a robust local food system. ASD functions as a distributor for a network of small-scale farmers, providing them with farmer education, market development, and distribution services. The organization helps farmers, including former tobacco growers, transition to growing ordinary organic foods.

A key part of its strategy involves working with supermarkets. ASD exemplifies a successful "start small" approach, having initially worked with smaller grocery stores to learn the business before approaching larger chains. Through this work, it found that buyers value reliability and predictability more than huge quantities or a year-round supply.

Appalachian Sustainable Development has developed its own distribution business and a successful regional brand called "Appalachian Harvest," which is considered an example of Joel Salatin's food cluster concept in action. The organization is also noted for creating innovative markets, such as developing outlets for 'seconds' through programs like the Healthy Families program.</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab&lt;SEP&gt;chunk-ad0d4e7d44014acab56e26cbaa12a896&lt;SEP&gt;chunk-3b16258e5de8192443e482a18e2beeb8&lt;SEP&gt;chunk-07373ff8a8e2c42149614780aa736a26&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Golden Acres Orchard">
      <data key="d0">Golden Acres Orchard</data>
      <data key="d1">organization</data>
      <data key="d2">An orchard that partners with Polyface farm. Polyface sells thousands of gallons of its apple juice, making it the orchard's top outlet and demonstrating the economic benefits of product aggregation for distribution.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Cracker Barrel">
      <data key="d0">Cracker Barrel</data>
      <data key="d1">organization</data>
      <data key="d2">A restaurant and retail chain whose business model of combining a dining space with a consignment market is used by Joel Salatin as an analogy for his vision of a local food system storefront.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Bioregional Food Clusters">
      <data key="d0">Bioregional Food Clusters</data>
      <data key="d1">category</data>
      <data key="d2">A conceptual model developed by Joel Salatin for creating sustainable local food systems. The model is based on six essential components: production, processing, distribution, marketing, accounting, and a customer base, designed to build economies of scale and support small farms.&lt;SEP&gt;Bioregional Food Clusters is a visionary concept promoted by Joel Salatin for a future food system. This model involves localized, interconnected food hubs that support regional economies, environments, and communities, becoming more viable as global resource dynamics shift.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Family of Farms">
      <data key="d0">Family of Farms</data>
      <data key="d1">category</data>
      <data key="d2">The term Polyface uses to describe its expansion model, which involves creating a network of partner farms. This approach is designed to support new farmers who lack capital and experience, allowing them to become full-time farmers.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Beyond Organic Food">
      <data key="d0">Beyond Organic Food</data>
      <data key="d1">category</data>
      <data key="d2">A category of food produced by Polyface farm, characterized by practices that aim to be superior to standard organic methods, focusing on ecological healing and high quality. The rising demand for this food is a primary challenge for Joel Salatin.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Apprenticeship Program">
      <data key="d0">Polyface Apprenticeship Program</data>
      <data key="d1">category</data>
      <data key="d2">A year-round program at Polyface farm where two or three young men are hired and intensively trained in all aspects of the farm's operation, from raising animals to business planning. The program is described as highly selective and immersive.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Internship Program">
      <data key="d0">Polyface Internship Program</data>
      <data key="d1">category</data>
      <data key="d2">A seasonal program at Polyface farm where interns learn primarily about raising poultry. It is designed for people who are interested in farming but not yet ready to make a full commitment, offering them a taste of farm life.</data>
      <data key="d3">chunk-74e3df5ce7be88ffd8bdf29e5b896da3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Appalachian Harvest">
      <data key="d0">Appalachian Harvest</data>
      <data key="d1">category</data>
      <data key="d2">Appalachian Harvest is a certified local and regional food brand created and used by the organization Appalachian Sustainable Development (ASD) in southwest Virginia. It serves as an umbrella brand and trade name for small-scale producers who distribute their local and organic produce through ASD. The brand's identity is described as "hometown, not too slick but credible," with an emphasis on its local and organic offerings. To promote the producers and their products, ASD provides marketing materials, such as farmer profiles, for Appalachian Harvest displays in supermarkets. The brand is considered a success story, similar to ASAP's "Appalachian Grown," and is cited as a real-world example of the regional branding model envisioned in Joel Salatin's "Bioregional Food Clusters."</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec&lt;SEP&gt;chunk-efae0d6c5dabc751b9ceb56518857dff&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Appalachian Grown">
      <data key="d0">Appalachian Grown</data>
      <data key="d1">category</data>
      <data key="d2">Appalachian Grown is a trademarked and certified regional brand name created and initiated by the Appalachian Sustainable Agriculture Project (ASAP) for farms in its region, specifically within a 100-mile radius of Asheville, North Carolina. The program is designed to assure buyers of high quality and local provenance, build consumer trust, and verify that products are "truly local." By doing so, Appalachian Grown helps facilitate transactions between farmers and distributors. It is cited as a successful example of a regional branding strategy, comparable to the 'Appalachian Harvest' brand and the food cluster concept by Joel Salatin. Sales under the Appalachian Grown brand grew to $28 million by 2009.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579&lt;SEP&gt;chunk-b26f04bc8df6a747ead835cc8d210eec&lt;SEP&gt;chunk-74e3df5ce7be88ffd8bdf29e5b896da3&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Food Clusters">
      <data key="d0">Food Clusters</data>
      <data key="d1">category</data>
      <data key="d2">A 'food cluster' is a conceptual model proposed by Joel Salatin for a centralized local food hub. It would provide shared marketing, accounting, and retail/dining services for multiple small farmers to reduce their overhead and allow them to focus on farming.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model A">
      <data key="d0">Model A</data>
      <data key="d1">category</data>
      <data key="d2">Model A is a debt-free partnership model created by Polyface. In this arrangement, Polyface provides the land, infrastructure (like Eggmobiles), and livestock, while a contract farmer manages operations and is paid 'by the piece' for salable products, bearing no capital investment or risk.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model B">
      <data key="d0">Model B</data>
      <data key="d1">category</data>
      <data key="d2">Model B is a partnership model from Polyface involving a lump-sum payment and royalties. A new farmer receives a guaranteed payment for managing Polyface's cattle and can also run their own private dairy herd on the land, paying a small royalty to Polyface on their milk sales.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Eggmobiles">
      <data key="d0">Eggmobiles</data>
      <data key="d1">category</data>
      <data key="d2">A type of portable infrastructure used in the Polyface farming system, specifically mobile hen houses. They are a key component for farmers building their own egg businesses within the Polyface models.&lt;SEP&gt;Eggmobiles are a type of mobile infrastructure used in the Polyface farming system, specifically mentioned in Model A for housing 1,800 layer hens. They are owned by Polyface in this partnership.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model A Farmer">
      <data key="d0">Model A Farmer</data>
      <data key="d1">person</data>
      <data key="d2">A female contract farmer who partners with Polyface under Model A. She lives rent-free on a leased farm and earns income by raising Polyface's layer hens and broilers. She later switched from broilers to pigs. She has no debt and is paid per piece, earning $30 per hour in her first year.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model B Farmer">
      <data key="d0">Model B Farmer</data>
      <data key="d1">person</data>
      <data key="d2">A former Polyface apprentice who partners with Polyface under Model B. He lives rent-free in exchange for lawn maintenance and receives a lump-sum payment for managing Polyface's cow herd daily. He also establishes his own private dairy herd, selling milk to Polyface customers and paying royalties.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Industrial-size Chicken Contract Growers">
      <data key="d0">Industrial-size Chicken Contract Growers</data>
      <data key="d1">category</data>
      <data key="d2">A category of conventional farmers used as a point of contrast with Polyface's models. They typically incur massive debt to pay for buildings and infrastructure, while the integrating company owns the birds, placing enormous financial risk on the farmer.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Farm Owner (Model B)">
      <data key="d0">Farm Owner (Model B)</data>
      <data key="d1">person</data>
      <data key="d2">The owner of the farm where the Model B farmer lives and operates. The farm owner receives a small royalty from the Model B farmer for every gallon of milk sold.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Cow Herd">
      <data key="d0">Polyface Cow Herd</data>
      <data key="d1">category</data>
      <data key="d2">The herd of beef cows owned by Polyface. Under Model B, this herd is managed by a new farmer on leased land, with daily rotations improving biomass efficiency and carbon sequestration.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Layer Hens">
      <data key="d0">Layer Hens</data>
      <data key="d1">category</data>
      <data key="d2">A type of livestock (1,800 hens) owned by Polyface and managed by the Model A farmer using Eggmobiles to produce salable eggs.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Private 10-cow Dairy Herd">
      <data key="d0">Private 10-cow Dairy Herd</data>
      <data key="d1">category</data>
      <data key="d2">A private business established by the Model B farmer on land leased by Polyface. The herd, which grew to 12 cows in the second year, produces milk that the farmer sells to Polyface customers.</data>
      <data key="d3">chunk-3699752bc52dee1358ad76a26a9c6fb9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model C: Own Brand">
      <data key="d0">Model C: Own Brand</data>
      <data key="d1">category</data>
      <data key="d2">A business model developed by Polyface where a subcontract farmer invests their own capital to start their own branded business on land leased by Polyface. The farmer utilizes Polyface's portable infrastructure, and Polyface markets the products, paying the farmer on a per-piece-sold basis.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Model D: Lease to Own">
      <data key="d0">Model D: Lease to Own</data>
      <data key="d1">category</data>
      <data key="d2">A business model by Polyface for former apprentices, where a new farmer lives rent-free on a leased farm in exchange for managing Polyface's cattle. Polyface provides initial financing for infrastructure, which the farmer pays back over a five-year period to gain full ownership, thus building equity and an independent business.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Steve Ells">
      <data key="d0">Steve Ells</data>
      <data key="d1">person</data>
      <data key="d2">The CEO and founder of Chipotle Mexican Grill. He initiated the partnership with Polyface, believing the farm was a perfect fit for his restaurant's ethical commitment to how its food is raised.&lt;SEP&gt;The leader of Chipotle, whose 'relentless commitment' to sourcing high-quality food was described as the crucial factor in making the partnership with Polyface possible. He empowered his team to overcome obstacles.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Joel Holland">
      <data key="d0">Joel Holland</data>
      <data key="d1">person</data>
      <data key="d2">The head chef for Chipotle Mexican Grill. He was responsible for adapting the company's original pork recipe to suit the unique characteristics of Polyface's juicy, pasture-raised pork, traveling to Charlottesville multiple times to perfect it.&lt;SEP&gt;The head chef for Chipotle. He was responsible for adjusting Steve Ells's original carnitas recipe to suit the unique qualities of Polyface's pork, developing a new oven-braising method for the Charlottesville restaurant.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Charlottesville">
      <data key="d0">Charlottesville</data>
      <data key="d1">geo</data>
      <data key="d2">A location mentioned as the destination for Chipotle's head chef, Joel Holland, during his work to adjust the pork recipe for the Polyface partnership.&lt;SEP&gt;The city in which the specific Chipotle restaurant that partnered with Polyface is located. This restaurant had to replace its stovetop with an oven to accommodate the new cooking method for Polyface pork and became one of the chain's top sellers of pork.&lt;SEP&gt;The city where the Chipotle restaurant that first trialed Polyface Farm's pork is located. It was the setting for the experiment in local sourcing between the farm and the restaurant chain.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Land Healing">
      <data key="d0">Land Healing</data>
      <data key="d1">category</data>
      <data key="d2">The core philosophical goal and primary motivation for Polyface farm's operations, as stated by Joel Salatin. It is achieved through synergistic, multi-species farming practices, such as running chickens behind cows, with the business models designed as a profitable means to this end.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Intern/Apprentice">
      <data key="d0">Polyface Intern/Apprentice</data>
      <data key="d1">category</data>
      <data key="d2">A role for individuals training at Polyface farm. These former apprentices are the primary candidates for starting new farm businesses under Polyface's innovative models, such as the 'Lease to Own' program.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Subcontract Farmer">
      <data key="d0">Polyface Subcontract Farmer</data>
      <data key="d1">category</data>
      <data key="d2">A type of farmer operating under Polyface's 'Model C'. This farmer starts their own branded business on land leased by Polyface, using the farm's infrastructure but owning their own animals and paying for feed. They grow products according to Polyface standards.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="New Farmer (Model D)">
      <data key="d0">New Farmer (Model D)</data>
      <data key="d1">category</data>
      <data key="d2">A former Polyface apprentice who participates in the 'Model D: Lease to Own' program. This farmer lives rent-free on a Polyface-leased farm in exchange for managing cattle, while simultaneously building their own egg business with financing and infrastructure support from Polyface.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface Protocols and Standards">
      <data key="d0">Polyface Protocols and Standards</data>
      <data key="d1">category</data>
      <data key="d2">A set of rules and quality guidelines established by Polyface farm. Subcontract farmers operating under Polyface's models are required to adhere to these standards, ensuring product consistency and alignment with the farm's ethos.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Buying Club">
      <data key="d0">Buying Club</data>
      <data key="d1">category</data>
      <data key="d2">A direct-to-consumer business model where a farm delivers pre-ordered goods to centralized community drop-off locations. The text provides several lessons on how to run one successfully, based on the experience of Polyface Farm.&lt;SEP&gt;A group of customers that purchases specific cuts of pork from Polyface, including ribs, sausage, and bacon. The club's purchases are crucial as they allow Polyface to sell the 'whole animal,' complementing the cuts sold to large partners like Chipotle.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3&lt;SEP&gt;chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Chipotle-Polyface relationship">
      <data key="d0">Chipotle-Polyface relationship</data>
      <data key="d1">category</data>
      <data key="d2">The formal partnership between the fast-food chain and the local farm, initiated in 2008. The relationship is characterized by logistical challenges and a high degree of collaboration, focused on integrating pasture-raised pork into a national supply chain.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="RECIPE ADJUSTMENTS">
      <data key="d0">RECIPE ADJUSTMENTS</data>
      <data key="d1">category</data>
      <data key="d2">A specific challenge and required solution within the Chipotle-Polyface partnership. Chipotle had to alter its standard pork recipe to include both shoulder and ham cuts to accommodate Polyface's need to sell the whole animal.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="COOKING METHODS">
      <data key="d0">COOKING METHODS</data>
      <data key="d1">category</data>
      <data key="d2">A challenge that arose in the Chipotle-Polyface partnership. The unique qualities of Polyface's juicy pork required Chipotle to adapt its standard cooking procedures to achieve the best results.</data>
      <data key="d3">chunk-77562613f0c5d12383f7ffab65ce2e45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Salatin">
      <data key="d0">Salatin</data>
      <data key="d1">person</data>
      <data key="d2">A farmer from Polyface Farm who emphasizes working with biological timelines and the necessity of a 'symbiotic patron chain' to sell the whole animal. He collaborated with Chipotle to supply pork and other meats.&lt;SEP&gt;The farmer and owner of Polyface farm. He worked closely with Chipotle to make the partnership succeed, adapting his packaging methods and expressing admiration for Chipotle's collaborative efforts. His full name is likely Joel Salatin, as the text mentions 'Joel Holland' separately.&lt;SEP&gt;The spokesperson and philosophical leader of Polyface Farm. He champions the farm's unconventional business practices, such as no advertising and incentivized labor over hourly wages. His refusal to ship a steak to Michael Pollan led to the farm being featured in 'The Omnivore's Dilemma'.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622&lt;SEP&gt;chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Heidi Wederquist">
      <data key="d0">Heidi Wederquist</data>
      <data key="d1">person</data>
      <data key="d2">An employee in Chipotle's purchasing department who solved the critical transportation and refrigeration challenge by suggesting the use of 'temperature log' microchip thermometers to ensure the cold chain was maintained.&lt;SEP&gt;An individual named in the text.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Petrilli">
      <data key="d0">Petrilli</data>
      <data key="d1">person</data>
      <data key="d2">A representative from Chipotle who managed the partnership with Polyface Farm. He advocated for starting with a small trial to work out system kinks and learned the importance of telling the story of the farmer partnership to customers.&lt;SEP&gt;An employee at Chipotle involved in the Polyface partnership. Petrilli emphasizes the importance of Steve Ells's leadership and discusses the practical challenges of the deal, such as packaging and the difficulty of sourcing beef.&lt;SEP&gt;Petrilli is a person mentioned in the text who expresses admiration and wonder at the positive relationship between restaurant employees and their farmer, specifically referencing Polyface Farm.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8&lt;SEP&gt;chunk-3e930a3eb466e9bb1dfa38b0df50bfd3&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Carnitas">
      <data key="d0">Carnitas</data>
      <data key="d1">category</data>
      <data key="d2">A pork dish sold by Chipotle. The partnership with Polyface was initiated to supply high-quality, tasty pork for the carnitas at the Charlottesville location.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Cascadian Farm">
      <data key="d0">Cascadian Farm</data>
      <data key="d1">organization</data>
      <data key="d2">Cascadian Farm is an organic food brand that was started by Kahn and later sold, first to Welch's and eventually becoming part of General Mills. Its trajectory symbolizes the debate over the corporate takeover of the organic movement.&lt;SEP&gt;Originally a small organic farm founded by Gene Kahn in 1972. It grew into a major corporate organic food producer and was eventually sold to Welch's, a move that drew criticism for losing touch with core organic values.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Gene Kahn">
      <data key="d0">Gene Kahn</data>
      <data key="d1">person</data>
      <data key="d2">Gene Kahn is an individual mentioned in the text.&lt;SEP&gt;The founder of Cascadian Farm. He sold his farm and later became the vice president and global sustainability officer for General Mills. He was criticized by figures like Michael Pollan for the corporatization of his farm.</data>
      <data key="d3">chunk-8c9669112f71f37c0273243e8cc59e05&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="General Mills">
      <data key="d0">General Mills</data>
      <data key="d1">organization</data>
      <data key="d2">A major food corporation that now employs Gene Kahn as its vice president and global sustainability officer. It represents the 'agribusiness' side of the food industry.&lt;SEP&gt;General Mills is a major food corporation that now owns the Cascadian Farm brand. It represents the 'agribusiness' side of the organic movement that figures like Joel Salatin are wary of.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Welch's">
      <data key="d0">Welch's</data>
      <data key="d1">organization</data>
      <data key="d2">The company to which Gene Kahn sold Cascadian Farm. This sale was a key step in Cascadian Farm's transition from a small farm to a corporate entity.&lt;SEP&gt;Welch's is a food company mentioned as the initial buyer of Cascadian Farm from its founder, Kahn.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Washington's Cascade Mountains">
      <data key="d0">Washington's Cascade Mountains</data>
      <data key="d1">geo</data>
      <data key="d2">The geographic location where Cascadian Farm was originally founded in 1972.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Industrial Organic">
      <data key="d0">Industrial Organic</data>
      <data key="d1">category</data>
      <data key="d2">A term describing the large-scale, corporate approach to organic farming. The evolution of Cascadian Farm is used as an example of the growth of industrial organic, which some activists see as a departure from the movement's original principles.&lt;SEP&gt;Industrial Organic refers to a large-scale, conglomerated approach to organic farming that mirrors conventional agribusiness. It is criticized for being unsustainable and socially unjust, but defended for increasing access to organic food.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b&lt;SEP&gt;chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Temperature Log Microchip Thermometers">
      <data key="d0">Temperature Log Microchip Thermometers</data>
      <data key="d1">category</data>
      <data key="d2">A specific type of microchip thermometer used in the food industry to audit and record time and temperature during food transport. This technology was proposed by Heidi Wederquist and was the key solution that enabled the safe transportation of meat from Polyface to Chipotle, ensuring the 'cold chain' was maintained.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Polyface's Buying Club">
      <data key="d0">Polyface's Buying Club</data>
      <data key="d1">organization</data>
      <data key="d2">A direct-to-consumer sales channel run by Polyface farm. It serves as a competing market for Polyface's beef, as the farm can fetch a higher price through the club than what Chipotle can offer, creating a supply challenge for expanding the partnership to include beef.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="The Cold Chain">
      <data key="d0">The Cold Chain</data>
      <data key="d1">category</data>
      <data key="d2">A concept referring to the temperature-controlled supply chain required for perishable goods like meat. Maintaining the integrity of the 'cold chain' was a critical, non-negotiable requirement for Chipotle to ensure food safety in their partnership with Polyface.</data>
      <data key="d3">chunk-63208f55f5e282db2dc1514f989da622</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Kahn">
      <data key="d0">Kahn</data>
      <data key="d1">person</data>
      <data key="d2">Kahn is the vice president and global sustainability officer for General Mills and the former owner of Cascadian Farm. He is a proponent of 'industrial organic' agriculture, arguing that selling his farm to a larger corporation increased access to organic food for more people.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Pollan">
      <data key="d0">Pollan</data>
      <data key="d1">person</data>
      <data key="d2">Pollan is a writer or journalist who interviewed Kahn about the evolution of Cascadian Farm and the organic movement.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Walmart">
      <data key="d0">Walmart</data>
      <data key="d1">organization</data>
      <data key="d2">Walmart is a major retail corporation that sells organic food on a large scale. The text uses 'Walmart organics' to represent the industrial, low-price model of organic food distribution, which is contrasted with the local food model.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Wall Street">
      <data key="d0">Wall Street</data>
      <data key="d1">category</data>
      <data key="d2">Wall Street is used as a symbol for a profit-driven, scale-obsessed, and morally-neutral business ethos. Polyface Farm has developed specific 'anti-Wall Street' principles to avoid this model.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="The Omnivore's Dilemma">
      <data key="d0">The Omnivore's Dilemma</data>
      <data key="d1">event</data>
      <data key="d2">A best-selling book by Michael Pollan in which Polyface Farm and Salatin are featured as stars, highlighting their sustainable and ethical farming practices. This feature was the catalyst for the farm's national recognition.&lt;SEP&gt;The Omnivore's Dilemma becoming a bestseller was a key event that brought widespread fame and attention to Joel Salatin and Polyface Farm, forcing them to formally define their principles to avoid compromising their values amid new pressures.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1&lt;SEP&gt;chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Agribusiness">
      <data key="d0">Agribusiness</data>
      <data key="d1">category</data>
      <data key="d2">Agribusiness refers to the large-scale, corporate-driven sector of agriculture and food production. In the text, it is portrayed as the force behind the 'takeover' of the organic movement, prioritizing scale and efficiency, often at the expense of small farmers and the movement's original values.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Regulation">
      <data key="d0">Regulation</data>
      <data key="d1">category</data>
      <data key="d2">Regulation refers to the governmental rules and the overall regulatory climate affecting the food industry, particularly processing. Joel Salatin argues that these regulations are scaled for industrial-sized operations, creating a prejudicial cost structure that penalizes small producers.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Summer of 2009">
      <data key="d0">Summer of 2009</data>
      <data key="d1">event</data>
      <data key="d2">The Summer of 2009 was a specific period when soaring oil prices caused a tipping point. This event increased the cost of trucking in non-local food, making locally produced food, like that from Polyface Farm, more price-competitive in comparison.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Ethics-Based Anti–Wall Street Contrarian Business Practices">
      <data key="d0">Ethics-Based Anti–Wall Street Contrarian Business Practices</data>
      <data key="d1">category</data>
      <data key="d2">This is the formal name for the set of guiding principles developed by Polyface Farm. These rules, such as having no sales targets, are designed to protect the farm's core values of healing land, food, economy, and culture from the pressures of growth and conventional business wisdom.</data>
      <data key="d3">chunk-0d31a2f89a77b64e0ae04120df1fdb3b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="U.S. Marketplace">
      <data key="d0">U.S. Marketplace</data>
      <data key="d1">geo</data>
      <data key="d2">The conventional economic environment in the United States, which is contrasted with Polyface Farm's alternative business model. Salatin suggests that the 'big companies' in the U.S. marketplace would not be so large if they adopted Polyface's open and transparent attitude.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Concentrated Animal Feeding Operations (CAFOs)">
      <data key="d0">Concentrated Animal Feeding Operations (CAFOs)</data>
      <data key="d1">category</data>
      <data key="d2">"A type of large-scale, industrial agricultural facility where animals are raised in confinement. They are a subject of ethical and environmental debate and regulation."&gt;&lt;SEP&gt;A model of industrial agriculture that Salatin and Polyface Farm stand in opposition to. CAFOs are criticized for violating the principle of ecological carrying capacity by generating more waste than their land can absorb.&lt;SEP&gt;A type of large-scale industrial animal agriculture facility.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-7b79b32f16bacae95e48f2f51ab5dee0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Guiding Principles Of Polyface Farm">
      <data key="d0">Guiding Principles Of Polyface Farm</data>
      <data key="d1">category</data>
      <data key="d2">A set of unconventional business rules developed by Polyface Farm, including no sales targets, no patents, defined market boundaries, no IPOs, no advertising, and operating within ecological limits. These principles prioritize values, sustainability, and quality over conventional growth metrics.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Autonomous Workforce">
      <data key="d0">Autonomous Workforce</data>
      <data key="d1">category</data>
      <data key="d2">The team model used by Polyface Farm, described by Salatin as a group of incentivized, autonomous collaborators. It emphasizes production-based earnings over salaries or hourly wages, allowing individuals to choose their level of work and income.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Initial Public Offerings (IPOs)">
      <data key="d0">Initial Public Offerings (IPOs)</data>
      <data key="d1">category</data>
      <data key="d2">A method of business financing through large cash infusions that Polyface Farm and Salatin explicitly reject. They believe it can compromise quality, innovation, and core values, leading to unsustainable, 'meteoric' growth.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Word Of Mouth">
      <data key="d0">Word Of Mouth</data>
      <data key="d1">category</data>
      <data key="d2">The sole method of promotion and customer acquisition relied upon by Polyface Farm. The farm 'walks by faith' that satisfied customers will 'evangelize' for them, which serves as a built-in mechanism for ensuring quality.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Ecological Carrying Capacity">
      <data key="d0">Ecological Carrying Capacity</data>
      <data key="d1">category</data>
      <data key="d2">A core principle for Polyface Farm, defining the farm's sustainable limits. It means the farm must be able to manage its own waste productively on-site and support the ecological health of the local community, rather than externalizing costs.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Healing The Land">
      <data key="d0">Healing The Land</data>
      <data key="d1">category</data>
      <data key="d2">A stated mission of Polyface Farm that is linked to the principle of sustainability and ecological carrying capacity. It involves managing the farm in a way that improves the health of the soil and ecosystem.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Industrial Processing Plants">
      <data key="d0">Industrial Processing Plants</data>
      <data key="d1">organization</data>
      <data key="d2">A type of industrial facility that Salatin believes 'destroy[s] the community ecology' due to poor working conditions and low pay. This model is contrasted with Polyface's community-supportive approach.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Hourly Wages">
      <data key="d0">Hourly Wages</data>
      <data key="d1">category</data>
      <data key="d2">A form of payment that Salatin dislikes because he finds it subjective and a poor measure of performance or success. It is contrasted with the 'incentivized' piece-rate system he prefers.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Local Copper Fittings Manufacturing Plant">
      <data key="d0">Local Copper Fittings Manufacturing Plant</data>
      <data key="d1">organization</data>
      <data key="d2">A plant mentioned by Salatin in an anecdote about an incentivized worker. An employee there was paid by the piece and earning a very high income, serving as Salatin's example of a successful incentivized system.</data>
      <data key="d3">chunk-c8b5f0f35b6bfccad911410ecdcdb7c1</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Tyson">
      <data key="d0">Tyson</data>
      <data key="d1">organization</data>
      <data key="d2">A large-scale poultry producer used as an example of the industrial, year-round 'treadmill' model of agriculture that Polyface Farm actively seeks to avoid becoming.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740870</data>
    </node>
    <node id="Niman Ranch">
      <data key="d0">Niman Ranch</data>
      <data key="d1">organization</data>
      <data key="d2">A co-op model, recommended by Phil Petrilli, where small-scale, independent farmers raise livestock sustainably and market their products under a unified brand to access larger markets.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Coleman Natural">
      <data key="d0">Coleman Natural</data>
      <data key="d1">organization</data>
      <data key="d2">An organization mentioned as another example of a co-op model, similar to Niman Ranch, that aggregates products from small, sustainable farms.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Country Natural Beef">
      <data key="d0">Country Natural Beef</data>
      <data key="d1">organization</data>
      <data key="d2">Country Natural Beef (CNB) is a for-profit cooperative of nearly 100 small-scale family ranches across the western United States, with a base in Vale, Oregon. It was founded in 1986 by fourteen members to help small ranches thrive independently by providing a year-round supply of naturally raised, humanely treated cattle. Key representatives associated with the organization include Doc and Connie Hatfield, and Mary and Lowell Forman.

The cooperative follows a commodity-based model where it aggregates beef from its member ranches, then collects, finishes, and distributes its own branded boxed beef products. This approach is guided by its "Raise Well" and "Graze Well" initiatives, which emphasize sustainable and humane practices. To ensure quality control, CNB documents all cattle from birth through slaughter. It is often cited as a successful model for aggregation and as a for-profit entity with a social conscience, similar to Organic Valley.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-09e000817f207794412f1a62763dda17&lt;SEP&gt;chunk-07373ff8a8e2c42149614780aa736a26&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Anthony Flaccovento">
      <data key="d0">Anthony Flaccovento</data>
      <data key="d1">person</data>
      <data key="d2">Anthony Flaccovento is the founder and former executive director of Appalachian Sustainable Development (ASD). With a background in social justice from his work with the Catholic Diocese, he established ASD with the mission to create jobs and protect the environment in Appalachia. As a key voice on local food systems, Flaccovento provides insights on marketing strategies, distribution challenges, and the benefits of a nonprofit model. He played a crucial role in brokering contracts with grocery chains to build markets for local farmers, explaining that the organization "cut its teeth" by starting with smaller, more manageable stores. He also notes that supermarkets are often willing to work with the limited but reliable quantities of products that small suppliers can provide. Additionally, Flaccovento emphasizes the high volume of 'seconds' in farming and strongly advocates for creating paid markets for this produce to ensure farmer profitability, arguing that farmers should not be expected to donate it.</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-ad0d4e7d44014acab56e26cbaa12a896&lt;SEP&gt;chunk-3b16258e5de8192443e482a18e2beeb8&lt;SEP&gt;chunk-07373ff8a8e2c42149614780aa736a26&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Scaling Up To Meet Large-Volume Demand">
      <data key="d0">Scaling Up To Meet Large-Volume Demand</data>
      <data key="d1">category</data>
      <data key="d2">A central business challenge and theme discussed in the text. It involves strategies for small-scale suppliers to increase their production to serve larger clients like restaurants and supermarkets, while navigating issues of quality, cost, and infrastructure.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Westerners">
      <data key="d0">Westerners</data>
      <data key="d1">category</data>
      <data key="d2">A cultural group that Joel Salatin believes is 'starved for human contact,' which is a core reason behind Polyface Farm's commitment to personal customer service over automated systems.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Supermarkets">
      <data key="d0">Supermarkets</data>
      <data key="d1">category</data>
      <data key="d2">"A category of retail market that typically rejects produce ('seconds') based on cosmetic imperfections rather than quality. They are identified as a major reason farmers have a large volume of unsold produce."&gt;&lt;SEP&gt;A type of large-volume buyer that Appalachian Sustainable Development works with. The text notes that they may value reliability and predictability over sheer volume or year-round supply.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26&lt;SEP&gt;chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Local Growers">
      <data key="d0">Local Growers</data>
      <data key="d1">category</data>
      <data key="d2">A term used interchangeably with small farmers, referring to producers who often cannot meet the large quantity demands of restaurants and other food-service companies on their own.</data>
      <data key="d3">chunk-07373ff8a8e2c42149614780aa736a26</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Whole Animal Sales">
      <data key="d0">Whole Animal Sales</data>
      <data key="d1">category</data>
      <data key="d2">A business strategy for livestock producers that involves finding buyers for every part of an animal to ensure profitability. Salatin highlights this as critical for success, contrasting Polyface's model with the failure of Buffalo Ridge.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740871</data>
    </node>
    <node id="Buffalo Ridge">
      <data key="d0">Buffalo Ridge</data>
      <data key="d1">organization</data>
      <data key="d2">An artisanal beef producer in Virginia cited by Salatin as a cautionary tale. The company went bankrupt because it could not sell its less desirable cuts, leading to a massive surplus of ground beef in cold storage.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Richmond">
      <data key="d0">Richmond</data>
      <data key="d1">geo</data>
      <data key="d2">A city in Virginia where the bankrupt producer Buffalo Ridge had a million pounds of unsold ground beef in cold storage.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Small To Medium-Sized Grocery Stores">
      <data key="d0">Small To Medium-Sized Grocery Stores</data>
      <data key="d1">category</data>
      <data key="d2">The initial customers for Appalachian Sustainable Development. They are characterized as having more manageable standards, which allowed the new distribution system to learn and grow.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Larger Grocery Chains">
      <data key="d0">Larger Grocery Chains</data>
      <data key="d1">category</data>
      <data key="d2">A category of major retailers with stringent regulations and standards. Appalachian Sustainable Development successfully negotiated partnerships with them after gaining experience with smaller stores.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="White-Tablecloth Restaurants">
      <data key="d0">White-Tablecloth Restaurants</data>
      <data key="d1">category</data>
      <data key="d2">A customer segment for Polyface Farm that purchases specific, high-value cuts like pork loin, playing a role in the farm's diversified 'patron portfolio' for selling the whole animal.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Charlottesville Customers">
      <data key="d0">Charlottesville Customers</data>
      <data key="d1">category</data>
      <data key="d2">The patrons of the Charlottesville Chipotle who noticed the superior quality of Polyface pork. Their positive feedback and subsequent confusion about its inconsistent availability taught Chipotle and Salatin a major lesson about customer communication and transparency.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="University Dining Service">
      <data key="d0">University Dining Service</data>
      <data key="d1">category</data>
      <data key="d2">Mentioned by Salatin as an example of a large institutional outlet, similar to Chipotle, that a farm might partner with, requiring a readiness for consistent supply.</data>
      <data key="d3">chunk-3b16258e5de8192443e482a18e2beeb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Annapolis">
      <data key="d0">Annapolis</data>
      <data key="d1">geo</data>
      <data key="d2">Annapolis is a city that serves as the northernmost drop-off point for the Polyface Buying Club, defining the boundary of its delivery radius.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Williamsburg">
      <data key="d0">Williamsburg</data>
      <data key="d1">geo</data>
      <data key="d2">Williamsburg is a city that serves as the easternmost drop-off point for the Polyface Buying Club, defining the boundary of its delivery radius.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Jamie Ager">
      <data key="d0">Jamie Ager</data>
      <data key="d1">person</data>
      <data key="d2">Jamie Ager is a fourth-generation farmer who, along with his wife Amy Ager, co-founded, co-owns, and operates the family-owned Hickory Nut Gap Farm. As a descendant of the original owners, Jim and Elizabeth McClure, he leases the property and is working to transform it into an environmentally and economically sustainable enterprise. Ager is also a representative for the farm and runs the associated business, Hickory Nut Gap Meats.

Described as the "big-picture thinker," Jamie Ager makes strategic decisions for the farm, such as changing cattle breeds and establishing partnerships with other farmers. He is a proponent of a sustainable, whole-system approach to agriculture, often referred to as "post-industrial agriculture," which he contrasts with the industrial model's reliance on oil and lack of human connection. His philosophy as a "grass farmer" was heavily inspired by a visit to Joel Salatin's Polyface Farm, which encouraged him to view farming as a profitable livelihood. Ager has also observed large-scale farming practices in Brazil. Alongside Amy, he is a key figure in managing the visitor experience on the farm, emphasizing education to ensure safety and enjoyment.</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0&lt;SEP&gt;chunk-f188db350c6a6f2fdb22a9e9283e4dc3&lt;SEP&gt;chunk-f712d3550c8612228f9fb4dc999ba9b7&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab&lt;SEP&gt;chunk-062d9ac74f75199c91576d982ab5a9f4&lt;SEP&gt;chunk-14c8f3e81fd6708a9852f46f0d4ac0a0&lt;SEP&gt;chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Jim Mcclure">
      <data key="d0">Jim Mcclure</data>
      <data key="d1">person</data>
      <data key="d2">Jim McClure was a Presbyterian minister who, with his wife Elizabeth, purchased the Hickory Nut Gap Farm property in 1916, establishing the family's connection to the land.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Elizabeth Mcclure">
      <data key="d0">Elizabeth Mcclure</data>
      <data key="d1">person</data>
      <data key="d2">Elizabeth McClure was a visual artist who, along with her husband Jim, purchased the Hickory Nut Gap Farm property in 1916.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Annie Ager">
      <data key="d0">Annie Ager</data>
      <data key="d1">person</data>
      <data key="d2">Annie Ager is Jamie Ager's mother and one of six siblings who own Hickory Nut Gap Farm. Together, she and her siblings lease the farm to Jamie and Amy. Annie Ager also runs the Hickory Nut Gap Farm Camp with her sister, Susie. She is listed as an individual in the document's index.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3&lt;SEP&gt;chunk-062d9ac74f75199c91576d982ab5a9f4&lt;SEP&gt;chunk-f712d3550c8612228f9fb4dc999ba9b7&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Sustainable Farm Business">
      <data key="d0">Sustainable Farm Business</data>
      <data key="d1">category</data>
      <data key="d2">A farming enterprise model that aims to be both environmentally and economically sustainable while also supporting the local community. Hickory Nut Gap Farm is presented as an example of this model.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Farm Products">
      <data key="d0">Farm Products</data>
      <data key="d1">category</data>
      <data key="d2">Refers to the goods produced by the farms, such as the pastured beef, lamb, pork, poultry, eggs, fruits, and vegetables produced by Hickory Nut Gap Farm, and the unspecified products delivered by the Polyface Buying Club.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Conservation Easement">
      <data key="d0">Conservation Easement</data>
      <data key="d1">category</data>
      <data key="d2">A legal agreement that protects land from future development to preserve its value as a natural or agricultural area. Hickory Nut Gap Farm's 350 acres are protected by a permanent conservation easement.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Online Order System">
      <data key="d0">Online Order System</data>
      <data key="d1">category</data>
      <data key="d2">A software system that allows customers to place orders over the internet. Polyface Farm adopted this system in 2007 to streamline its Buying Club's invoicing process and reduce manual errors.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Local Food Sources">
      <data key="d0">Local Food Sources</data>
      <data key="d1">category</data>
      <data key="d2">A concept referring to food producers that are geographically closer to consumers than a competing farm. Polyface Farm's Buying Club has a policy to support and not compete with these more local sources.</data>
      <data key="d3">chunk-3e930a3eb466e9bb1dfa38b0df50bfd3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Elizabeth McClure">
      <data key="d0">Elizabeth McClure</data>
      <data key="d1">person</data>
      <data key="d2">Elizabeth McClure was a Presbyterian minister who, along with his visual-artist wife, purchased the property that would become Hickory Nut Gap Farm in 1916 and initiated its restoration.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Norman Borlaug">
      <data key="d0">Norman Borlaug</data>
      <data key="d1">person</data>
      <data key="d2">An influential figure, likely in agriculture, mentioned in the index.&lt;SEP&gt;Norman Borlaug was a plant breeder who led the Green Revolution after World War II, a movement that dramatically increased crop yields through the use of new hybrids, fertilizers, and pesticides.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="John And Nancy Todd">
      <data key="d0">John And Nancy Todd</data>
      <data key="d1">person</data>
      <data key="d2">John and Nancy Todd were pioneering thinkers who founded the New Alchemy Institute in 1969 on Cape Cod. Their work focused on developing self-sustaining systems for growing food without harming the environment.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Robert And Ardath Rodale">
      <data key="d0">Robert And Ardath Rodale</data>
      <data key="d1">person</data>
      <data key="d2">Robert and Ardath Rodale were pioneers in sustainable agriculture who bought a farm in Pennsylvania in 1971 to develop organic practices for maintaining soil and environmental health.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Amory And Hunter Lovins">
      <data key="d0">Amory And Hunter Lovins</data>
      <data key="d1">person</data>
      <data key="d2">Amory and Hunter Lovins founded the Rocky Mountain Institute in Colorado in 1982. They are known for developing practical whole-system, energy-efficient solutions.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Hickory Nut Gap Meats">
      <data key="d0">Hickory Nut Gap Meats</data>
      <data key="d1">organization</data>
      <data key="d2">Hickory Nut Gap Meats is the business run by Jamie and Amy Ager, based on the animals raised sustainably at Hickory Nut Gap Farm.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Jefferson Institute For Agriculture And Trade Policy">
      <data key="d0">Jefferson Institute For Agriculture And Trade Policy</data>
      <data key="d1">organization</data>
      <data key="d2">The Jefferson Institute for Agriculture and Trade Policy is an organization where one of Jamie Ager's relatives is a Kellogg Food &amp; Society Fellow, indicating the family's deep and intellectual involvement in agriculture.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="New Alchemy Institute">
      <data key="d0">New Alchemy Institute</data>
      <data key="d1">organization</data>
      <data key="d2">Founded in 1969 by John and Nancy Todd, the New Alchemy Institute was an organization dedicated to developing self-sustaining food production systems with minimal environmental impact.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Rocky Mountain Institute">
      <data key="d0">Rocky Mountain Institute</data>
      <data key="d1">organization</data>
      <data key="d2">Founded in 1982 by Amory and Hunter Lovins, the Rocky Mountain Institute is an organization that develops whole-system, energy-efficient solutions for various sectors, including building design and transportation.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Whole-System Natural Efficiencies">
      <data key="d0">Whole-System Natural Efficiencies</data>
      <data key="d1">category</data>
      <data key="d2">A concept, likely related to ecology or agriculture, focusing on the overall efficiency of a complex natural system.&lt;SEP&gt;This is a concept described as the foundation of the Agers' farming method. It refers to efficiencies gained by supporting the health of an entire natural system, such as using livestock diversity to improve soil health and reduce parasites, which benefits the entire farm ecosystem.</data>
      <data key="d3">chunk-38c9174dd4002f6529026fc7fd3c23f0&lt;SEP&gt;chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Susie">
      <data key="d0">Susie</data>
      <data key="d1">person</data>
      <data key="d2">Susie is the sister of Annie Ager and aunt of Jamie Ager. She co-runs the Hickory Nut Gap Farm Camp with her sister Annie.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Hickory Nut Gap Farm Camp">
      <data key="d0">Hickory Nut Gap Farm Camp</data>
      <data key="d1">organization</data>
      <data key="d2">A camp located at Hickory Nut Gap Farm, run by Annie Ager and her sister Susie. It represents a diversification of the farm's family-run activities.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="North Carolina Organic Grain Project">
      <data key="d0">North Carolina Organic Grain Project</data>
      <data key="d1">organization</data>
      <data key="d2">An agricultural project operated by the wife of one of Jamie Ager's cousins. Its existence highlights the deep and varied involvement of the extended family in organic and sustainable agriculture.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Grass Farmers">
      <data key="d0">Grass Farmers</data>
      <data key="d1">category</data>
      <data key="d2">A category describing a new generation of farmers, including Jamie and Amy Ager, who reject industrial monocultures in favor of raising animals in pastures on natural diets, emphasizing land stewardship and whole-system health.</data>
      <data key="d3">chunk-f712d3550c8612228f9fb4dc999ba9b7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Sam Dobson">
      <data key="d0">Sam Dobson</data>
      <data key="d1">person</data>
      <data key="d2">A sixth-generation dairy farmer who partners with Hickory Nut Gap Farm by raising and supplying them with sustainably raised, grass-fed beef, allowing him to diversify his own operation.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Fairview">
      <data key="d0">Fairview</data>
      <data key="d1">geo</data>
      <data key="d2">A small community near Asheville where the Agers first started their business in 2000 by selling products at a local farmers' market.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Sustainable Farming Practices">
      <data key="d0">Sustainable Farming Practices</data>
      <data key="d1">category</data>
      <data key="d2">The core philosophy and methods used by Hickory Nut Gap Farm, focusing on grass-fed livestock and holistic system management. The farm actively helps its partners transition to these practices.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Industrial Agricultural System">
      <data key="d0">Industrial Agricultural System</data>
      <data key="d1">category</data>
      <data key="d2">The Industrial Agricultural System is mentioned as having hidden costs and negative impacts on public health. Community food projects like Growing Power are presented as a positive alternative that can address these issues.&lt;SEP&gt;The Industrial Agricultural System is the dominant, large-scale food production model, described as being efficient but dependent on nonrenewable resources like oil. The text criticizes it for lacking a 'human touch,' having a built-in mortality, and posing food safety risks due to its centralized nature.&lt;SEP&gt;The conventional, large-scale farming model that Jamie Ager sees as a failure. It is characterized as being based on cheap, oil-dependent food production, which Hickory Nut Gap Farm's model stands in contrast to.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab&lt;SEP&gt;chunk-e0adcf3a18e5a064a6ed2b9d46dff75f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="South Polls">
      <data key="d0">South Polls</data>
      <data key="d1">category</data>
      <data key="d2">A moderate-frame breed of cattle that thrives on a grass-based diet (fescue). Jamie Ager specifically selected this breed for Hickory Nut Gap Farm to produce high-quality, grass-fed beef.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Jamie Ager's Mother">
      <data key="d0">Jamie Ager's Mother</data>
      <data key="d1">person</data>
      <data key="d2">The previous operator of the Ager family farm whose business records were analyzed by Jamie and Amy Ager. She initially paid Jamie for his labor before he acquired ownership of the cow herd from her.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Ager Family">
      <data key="d0">Ager Family</data>
      <data key="d1">organization</data>
      <data key="d2">A family with a multi-generational legacy of farming. Jamie Ager's decision to continue farming was aimed at transforming this legacy into a profitable, modern enterprise.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Farmers' Market In Fairview">
      <data key="d0">Farmers' Market In Fairview</data>
      <data key="d1">organization</data>
      <data key="d2">The local market where Amy and Jamie Ager began their business in 2000, serving as their initial entry point for direct-to-consumer sales.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Wholesale Outlets">
      <data key="d0">Wholesale Outlets</data>
      <data key="d1">category</data>
      <data key="d2">A key market for Hickory Nut Gap Farm, consisting of restaurants and groceries. The need to supply these outlets in sufficient quantity drove the farm's decision to partner with other growers.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Pastured Poultry Operation">
      <data key="d0">Pastured Poultry Operation</data>
      <data key="d1">category</data>
      <data key="d2">The first business venture established by the Agers at Hickory Nut Gap Farm, directly inspired by Joel Salatin's profitable farming model.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Family Apple Orchard">
      <data key="d0">Family Apple Orchard</data>
      <data key="d1">category</data>
      <data key="d2">An existing part of the Ager family farm that provided essential immediate income for Jamie and Amy when they first launched their new farming business.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Dairy Operation">
      <data key="d0">Dairy Operation</data>
      <data key="d1">category</data>
      <data key="d2">The primary, multi-generational family business of farmer Sam Dobson. He diversifies this operation by partnering with Hickory Nut Gap Farm to raise grass-fed beef.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Hickory Nut Gap Processor">
      <data key="d0">Hickory Nut Gap Processor</data>
      <data key="d1">organization</data>
      <data key="d2">The processing facility where partner farmers, such as Sam Dobson, deliver their cattle. Hickory Nut Gap Farm then markets the meat from this processor.</data>
      <data key="d3">chunk-14c8f3e81fd6708a9852f46f0d4ac0a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Post-Industrial Agriculture">
      <data key="d0">Post-Industrial Agriculture</data>
      <data key="d1">category</data>
      <data key="d2">Post-Industrial Agriculture is a concept for a future farming system that the Agers are working to develop. It is characterized by local markets, stewardship of land and animals, and creating community networks to reconnect people with their food sources.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="India">
      <data key="d0">India</data>
      <data key="d1">geo</data>
      <data key="d2">India is a country mentioned alongside Brazil as an example of a nation implementing ultra-large-scale industrial agricultural production.&lt;SEP&gt;India is a country whose proposed rule on labeling genetically modified food was the subject of an academic article.</data>
      <data key="d3">chunk-8c575c019780e689390cd685c690159f&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Grass-Fed Beef">
      <data key="d0">Grass-Fed Beef</data>
      <data key="d1">category</data>
      <data key="d2">Beef from cattle that have been raised on a diet of grass. The index links this category to Country Natural Beef.&lt;SEP&gt;Grass-Fed Beef is a type of meat from pastured cattle, presented as a healthier alternative to grain-fed beef. It is cited as having less fat and significantly more vitamins A and E, omega-3 fatty acids, and conjugated linoleic acid (CLA).</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Country Natural Beef Cooperative">
      <data key="d0">Country Natural Beef Cooperative</data>
      <data key="d1">organization</data>
      <data key="d2">The Country Natural Beef Cooperative is cited as a successful example of small-scale farmers pooling their products to market them under a single brand name to access larger markets.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Rainbow Farmers' Cooperative of Milwaukee">
      <data key="d0">Rainbow Farmers' Cooperative of Milwaukee</data>
      <data key="d1">organization</data>
      <data key="d2">The Rainbow Farmers' Cooperative of Milwaukee is mentioned as another example of a cooperative that handles logistical details like marketing and transportation for its member farmers.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Centralized Food System">
      <data key="d0">Centralized Food System</data>
      <data key="d1">category</data>
      <data key="d2">The Centralized Food System is a concept criticized in the text for presenting significant food safety risks and being a vulnerable target for intentional contamination, such as terrorism. It is contrasted with the safer, smaller-scale local food systems.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Local Markets">
      <data key="d0">Local Markets</data>
      <data key="d1">category</data>
      <data key="d2">Local Markets are presented as the ideal outlet for a post-industrial agricultural system. They are part of the solution to reconnect people with food, support farmers, and reduce food supply risks. Hickory Nut Gap Farm utilizes them as part of their business strategy.&lt;SEP&gt;Local Markets are the economic venues where new farmers can sell their products, thereby strengthening local economies. Building these markets is a core goal of ASAP.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Threat of Terrorism">
      <data key="d0">Threat of Terrorism</data>
      <data key="d1">category</data>
      <data key="d2">The Threat of Terrorism is mentioned as a contemporary risk that makes over-reliance on a centralized food system unwise. The text suggests that decentralized, local food systems are a 'common sense' defense against this threat.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Diversified Business Plan">
      <data key="d0">Diversified Business Plan</data>
      <data key="d1">category</data>
      <data key="d2">A Diversified Business Plan is a strategy highlighted as a 'Lesson Learned' for farm success and stability. It involves using multiple revenue streams, such as the 'three-legged stool' model of wholesale, restaurant sales, and direct marketing used by Hickory Nut Gap Farm.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Wholesale Distributor">
      <data key="d0">Wholesale Distributor</data>
      <data key="d1">category</data>
      <data key="d2">"A business model that involves aggregating products from multiple growers for sale to larger clients like institutions or food-service programs. The text highlights it as a promising opportunity for building local food systems."&gt;&lt;SEP&gt;A Wholesale Distributor is an aggregation model where a central entity (which can be a farm or a non-profit) markets and sells products for a network of other farms. This is presented as an alternative to the cooperative model.</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896&lt;SEP&gt;chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Farm Store">
      <data key="d0">Farm Store</data>
      <data key="d1">category</data>
      <data key="d2">A Farm Store is a direct sales outlet, located on the farm premises, used by Hickory Nut Gap Farm to sell their products and connect personally with customers.</data>
      <data key="d3">chunk-e970626c7a63b367949cb5600957bcab</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Seconds">
      <data key="d0">Seconds</data>
      <data key="d1">category</data>
      <data key="d2">"Produce that does not meet the top cosmetic standards for supermarkets but is otherwise of good quality. The text identifies creating paid markets for 'seconds' as a critical strategy for improving farmer profitability."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Healthy Families Program">
      <data key="d0">Healthy Families Program</data>
      <data key="d1">category</data>
      <data key="d2">"An initiative developed by Appalachian Sustainable Development to create a market for 'seconds'. Under this program, civic groups purchase the produce at reduced rates and donate it to services that feed the hungry."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Large Multinational Industrial Manufacturer">
      <data key="d0">Large Multinational Industrial Manufacturer</data>
      <data key="d1">organization</data>
      <data key="d2">"An unnamed company whose employees were offered a discounted Community-Supported Agriculture (CSA) share by Gladheart Farms, which provided weekly deliveries to the company's lobby."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="The Local Hospital">
      <data key="d0">The Local Hospital</data>
      <data key="d1">organization</data>
      <data key="d2">"An unnamed local institution mentioned as being interested in a corporate CSA deal with Gladheart Farms, similar to the one offered to the manufacturer."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Philadelphia Horticulture Clubs">
      <data key="d0">Philadelphia Horticulture Clubs</data>
      <data key="d1">organization</data>
      <data key="d2">"Influential clubs in Philadelphia whose business and attention Greensgrow Farm sought to gain by expanding its operations into a full-fledged nursery."&gt;&lt;SEP&gt;"Influential gardening groups in Philadelphia whose attention and business Greensgrow Farm sought to gain by transforming its greenhouses into a full-fledged nursery."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0&lt;SEP&gt;chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Aggregation Model">
      <data key="d0">Aggregation Model</data>
      <data key="d1">category</data>
      <data key="d2">"A business strategy where products from multiple small-scale producers are gathered (aggregated) to be marketed and sold collectively. The text presents cooperatives and wholesale distributors as examples."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Food-Service Programs">
      <data key="d0">Food-Service Programs</data>
      <data key="d1">category</data>
      <data key="d2">"Institutional kitchens, such as those in colleges, universities, and hospitals, that require large, consistent supplies of food. They are identified as a key market for both regular produce and 'seconds'."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Nursery Business">
      <data key="d0">Nursery Business</data>
      <data key="d1">category</data>
      <data key="d2">"A business that cultivates and sells plants, such as flowers, fruit trees, and vegetable starts. It is presented as a strategy for farms to diversify and extend year-round income."&gt;</data>
      <data key="d3">chunk-ad0d4e7d44014acab56e26cbaa12a896</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Earl Butz">
      <data key="d0">Earl Butz</data>
      <data key="d1">person</data>
      <data key="d2">"Earl Butz was the secretary of agriculture under President Nixon. He is cited for his famous advice to farmers to 'get big or get out,' a philosophy that is presented as a contrast to the creative, small-farm success model advocated by Amy Ager."&gt;&lt;SEP&gt;An individual, likely a public figure related to agriculture policy, mentioned in the index.</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Unfair Advantage">
      <data key="d0">Unfair Advantage</data>
      <data key="d1">category</data>
      <data key="d2">"'Unfair Advantage' is a business concept, articulated by Amy Ager, which refers to a farm's unique characteristic, heritage, or name recognition that can be leveraged as a platform for marketing and growth. Hickory Nut Gap Farm is used as a prime example of this concept."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Grass-fed Meats">
      <data key="d0">Grass-fed Meats</data>
      <data key="d1">category</data>
      <data key="d2">"Grass-fed meats are a product category that Hickory Nut Gap Farm specializes in marketing. The high demand for this product led the farm to partner with other local farmers to increase their supply."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Agers">
      <data key="d0">Agers</data>
      <data key="d1">person</data>
      <data key="d2">"The family, including Amy and Jamie Ager, that runs Hickory Nut Gap Farm. They capitalized on the farm's heritage, partnered with other farmers to expand, and are strong proponents of agritourism, developing detailed practices for visitor safety and education."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Salatin Family">
      <data key="d0">Salatin Family</data>
      <data key="d1">person</data>
      <data key="d2">"The family that runs Polyface Farm in Virginia. They have developed a specific set of guidelines to manage an 'explosion of public interest' and continue operating their farm while valuing customers."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="President Nixon">
      <data key="d0">President Nixon</data>
      <data key="d1">person</data>
      <data key="d2">"A former U.S. President under whom Earl Butz served as secretary of agriculture."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="Nursery">
      <data key="d0">Nursery</data>
      <data key="d1">category</data>
      <data key="d2">"A business component of Greensgrow Farm focused on cultivating and selling flowers and plants. It generates up to 30% of the farm's revenue in early spring and attracts customers to other farm offerings like the CSA."&gt;</data>
      <data key="d3">chunk-4d53cc613c52fd5080e556f9abb248a0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="The Agers">
      <data key="d0">The Agers</data>
      <data key="d1">organization</data>
      <data key="d2">The Agers are described as farmers who focus on growing grass-fed meats for their community, and are also dedicated to being a resource that fosters mental, physical, and spiritual connections.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740875</data>
    </node>
    <node id="The Salatin Family">
      <data key="d0">The Salatin Family</data>
      <data key="d1">organization</data>
      <data key="d2">The Salatin family manages Polyface Farm and has established clear rules for customer visits and tours to balance farm operations with public demand and transparency.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Infrastructure">
      <data key="d0">Infrastructure</data>
      <data key="d1">category</data>
      <data key="d2">Infrastructure is a topic discussed in the text, likely in relation to agriculture or community development.&lt;SEP&gt;Infrastructure refers to the often invisible 'go-betweens'-the people, organizations, and networks-that connect the various parts of a local food system, such as producers and markets. This includes entities like slaughterhouses, mills, and modern food hubs.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b&lt;SEP&gt;chunk-8c9669112f71f37c0273243e8cc59e05</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Kate Collier">
      <data key="d0">Kate Collier</data>
      <data key="d1">person</data>
      <data key="d2">An individual mentioned in the index.&lt;SEP&gt;Kate Collier is an entrepreneur who identified a need to streamline connections between farmers and institutions in her community. She founded the Local Food Hub to solve this problem.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Local Food Hub">
      <data key="d0">Local Food Hub</data>
      <data key="d1">organization</data>
      <data key="d2">The Local Food Hub is a community-supported nonprofit founded by Kate Collier. It aggregates produce from multiple farmers and delivers it to institutions like universities and hospitals, thereby improving the community's access to locally grown food.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="1998 Tobacco Settlement">
      <data key="d0">1998 Tobacco Settlement</data>
      <data key="d1">event</data>
      <data key="d2">The 1998 Tobacco Settlement is a historical agreement that provided grants, which in turn supported organizations like the Appalachian Sustainable Agriculture Project, facilitating the transition from tobacco farming to other forms of agriculture.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Food Conglomerates">
      <data key="d0">Food Conglomerates</data>
      <data key="d1">organization</data>
      <data key="d2">Food Conglomerates are described as national or international corporations that own neighborhood groceries and dominate the industrialized system of food aggregation and distribution, posing a challenge for small, local farmers.</data>
      <data key="d3">chunk-f7ecda741e6aebaebfb4bbcd928bb80b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Helen and Scott Nearing">
      <data key="d0">Helen and Scott Nearing</data>
      <data key="d1">person</data>
      <data key="d2">"Pioneering authors and homesteaders who were central figures in the 20th-century back-to-the-land movement, advocating for simple and self-sufficient living."&gt;&lt;SEP&gt;Authors of the book 'Living the Good Life,' which was influential in the 1970s back-to-the-land movement and served as an inspiration for Charlie Jackson.</data>
      <data key="d3">chunk-60121fd34d6b068a55f53ef625e1f266&lt;SEP&gt;chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Southern Appalachians">
      <data key="d0">Southern Appalachians</data>
      <data key="d1">geo</data>
      <data key="d2">A mountainous region characterized by smaller farms (averaging about 80 acres). ASAP focuses its efforts here to help farmers who cannot rely on high-volume production.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Broccoli Project">
      <data key="d0">Broccoli Project</data>
      <data key="d1">event</data>
      <data key="d2">An early initiative by ASAP to help farmers transition from tobacco to broccoli. The project's failure, due to a lack of markets, caused ASAP to pivot its strategy towards market creation rather than production.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Asheville City Market">
      <data key="d0">Asheville City Market</data>
      <data key="d1">organization</data>
      <data key="d2">A demonstration farmers' market in downtown Asheville that was created and is managed by ASAP. It serves as a model for professionalizing and expanding local markets.&lt;SEP&gt;A demonstration farmers' market located in downtown Asheville that was created and is managed by ASAP. It serves as a model for professionalizing local markets.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01&lt;SEP&gt;chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Back-to-the-land Movement">
      <data key="d0">Back-to-the-land Movement</data>
      <data key="d1">event</data>
      <data key="d2">A social movement from the 1970s, inspired by the Nearings' book, which influenced the work and philosophy of Charlie Jackson.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Industrialized System of Aggregation and Distribution">
      <data key="d0">Industrialized System of Aggregation and Distribution</data>
      <data key="d1">category</data>
      <data key="d2">A large-scale, multinational network for food supply that sources from large farms and distributes to various institutions like grocery stores and hospitals. It is presented as a system that poses significant challenges for small, local farmers.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Tobacco Farming">
      <data key="d0">Tobacco Farming</data>
      <data key="d1">category</data>
      <data key="d2">A form of agriculture with a long heritage in western North Carolina. Its decline, due to shifts in production overseas and to larger farms, created economic hardship and was the catalyst for ASAP's creation.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Local Food Guide">
      <data key="d0">Local Food Guide</data>
      <data key="d1">category</data>
      <data key="d2">A publication by ASAP described as one of the most powerful tools to build awareness and interest in local food, with an expected distribution of its millionth copy in 2011.&lt;SEP&gt;A publication created by ASAP as a primary marketing and educational tool to connect consumers with local food producers. It is funded by advertising and distributed for free, and considered highly effective by farmers.&lt;SEP&gt;The Local Food Guide is described as one of ASAP's most powerful marketing tools for building awareness and interest in local food, with the organization expecting to distribute its millionth copy in 2011.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e&lt;SEP&gt;chunk-5944a88ca415780f3d4838a47d068512&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Food Assistance">
      <data key="d0">Food Assistance</data>
      <data key="d1">category</data>
      <data key="d2">A social support program providing food access. ASAP works to integrate these programs into farmers' markets, for example, by enabling the use of EBT cards, to ensure local food is accessible to everyone.</data>
      <data key="d3">chunk-5944a88ca415780f3d4838a47d068512</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="ASAP (Appalachian Sustainable Agriculture Project)">
      <data key="d0">ASAP (Appalachian Sustainable Agriculture Project)</data>
      <data key="d1">organization</data>
      <data key="d2">A non-profit organization focused on supporting the local food system. It assists farmers with marketing, funding, and business development; helps farmers' markets accept EBT; connects farmers with retailers; and created a local brand to ensure quality.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Food Assistance Programs">
      <data key="d0">Food Assistance Programs</data>
      <data key="d1">category</data>
      <data key="d2">A category of federal and state programs that provide benefits to low-income populations for food purchases. The text focuses on the challenges and solutions for integrating these programs, like EBT, into farmers' markets.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="EBT (Electronic Benefit Transfer)">
      <data key="d0">EBT (Electronic Benefit Transfer)</data>
      <data key="d1">category</data>
      <data key="d2">An electronic system, typically a debit card, used by food assistance programs to distribute benefits. ASAP helps farmers' markets adopt the technology and processes required to accept EBT payments.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Jackson">
      <data key="d0">Jackson</data>
      <data key="d1">person</data>
      <data key="d2">A representative of ASAP who uses change theory to explain the organization's strategy. He advocates for consumer-driven change and working within the existing marketplace rather than creating competing systems.&lt;SEP&gt;An individual associated with ASAP who expresses the organization's philosophy that market demand should be the driving force for change in farming practices, such as shifting to organic methods.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01&lt;SEP&gt;chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Marketing Conference">
      <data key="d0">Marketing Conference</data>
      <data key="d1">event</data>
      <data key="d2">An annual event organized by ASAP where retailers and farmers can meet, network, and establish business relationships directly.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Certified Local Brand">
      <data key="d0">Certified Local Brand</data>
      <data key="d1">category</data>
      <data key="d2">An initiative developed by ASAP to create a brand with annual certification that assures the quality of local farm products, benefiting farmers, retailers, and consumers.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Retailers">
      <data key="d0">Retailers</data>
      <data key="d1">category</data>
      <data key="d2">A category of businesses including groceries, restaurants, and hospitals that sell or could potentially sell local farm products. ASAP acts as a relationship broker for them, addressing their concerns about quality and consistency and connecting them with appropriate farmers.&lt;SEP&gt;A key stakeholder group in the local food system. ASAP's 'Appalachian Grown' brand assures them of consistently high-quality local products. ASAP also works with them, including individual businesses and larger chain groceries, to ensure proper branding.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01&lt;SEP&gt;chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Scrip System">
      <data key="d0">Scrip System</data>
      <data key="d1">category</data>
      <data key="d2">A payment system used at farmers' markets, often involving tokens or certificates, that allows customers to use their EBT benefits. ASAP advises markets on how to implement this system effectively.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Tobacco Settlement Funds">
      <data key="d0">Tobacco Settlement Funds</data>
      <data key="d1">category</data>
      <data key="d2">A source of funding that ASAP utilizes to support its work, specifically mentioned in the context of helping former tobacco farmers become economically viable in other agricultural areas.</data>
      <data key="d3">chunk-9d67ba0430fa075f3a4e6609250b9a01</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="ASAP">
      <data key="d0">ASAP</data>
      <data key="d1">organization</data>
      <data key="d2">ASAP (Appalachian Sustainable Agriculture Project) is an organization focused on promoting local food systems. Its initiatives include distributing bumper stickers, publishing a Local Food Guide and a Regional Food Map, organizing an annual Farm Tour and a 'Get Local' campaign, helping with Harvest Festivals, and developing the 'Appalachian Grown' certified brand. It also acts as a media source and provides resources for teachers and parents.&lt;SEP&gt;An organization that effectively implements the strategy of personalizing products by sharing the stories of farmers and producers through colorful posters provided to sales outlets.&lt;SEP&gt;Stands for Appalachian Sustainable Agriculture Project. It is a non-profit organization that brokers relationships between farmers and retailers, created the 'Appalachian Grown' brand, and fosters the local food movement. It operates on a community-based, facilitative model, focusing on raising consumer awareness rather than distributing food itself.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Southern Appalachian Mountains">
      <data key="d0">Southern Appalachian Mountains</data>
      <data key="d1">geo</data>
      <data key="d2">A mountain range region spanning parts of Virginia, Tennessee, North Carolina, Georgia, and South Carolina. It provides the cultural, agricultural, and geographic identity for ASAP's work and the 'Appalachian Grown' brand.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Foodtopia">
      <data key="d0">Foodtopia</data>
      <data key="d1">category</data>
      <data key="d2">A promotional concept and brand used by the city of Asheville to market itself as a world-class farm and food destination, highlighting its many farmers' markets, independent restaurants, and microbreweries.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Producers">
      <data key="d0">Producers</data>
      <data key="d1">category</data>
      <data key="d2">A term used for those who grow or make food products. The text highlights initial disagreement between producers and consumers over the definition of 'local,' which ASAP worked to resolve.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Chain Groceries">
      <data key="d0">Chain Groceries</data>
      <data key="d1">organization</data>
      <data key="d2">A type of large retailer that ASAP works with to market 'Appalachian Grown' products and to ensure that non-certified items are not improperly mixed in or labeled.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Hospitals">
      <data key="d0">Hospitals</data>
      <data key="d1">organization</data>
      <data key="d2">Institutions that are beginning to join the local food movement in western North Carolina with ASAP's help, by featuring fresh local food.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Farm Tourism Development">
      <data key="d0">Farm Tourism Development</data>
      <data key="d1">category</data>
      <data key="d2">A specific form of economic development mentioned in the text. ASAP facilitates connections between farm tourism, farms, and broader economic development.</data>
      <data key="d3">chunk-ba841e41630d5b5e46b271cb1a11d579</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Project EMMA">
      <data key="d0">Project EMMA</data>
      <data key="d1">category</data>
      <data key="d2">"A collaborative project between ASAP and the Buncombe County Council on Aging, with the motto 'Eat Better, Move More, Age Well'. It aims to bring local, nutritious food and exercise to seniors through initiatives like a rooftop garden, walking trips to markets, and farm visits. It is supported by a grant from Blue Cross Blue Shield."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Buncombe County Council on Aging">
      <data key="d0">Buncombe County Council on Aging</data>
      <data key="d1">organization</data>
      <data key="d2">"An organization that partnered with ASAP to launch Project EMMA, an initiative focused on improving the health and wellness of seniors through better nutrition and exercise."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740876</data>
    </node>
    <node id="Blue Cross Blue Shield">
      <data key="d0">Blue Cross Blue Shield</data>
      <data key="d1">organization</data>
      <data key="d2">"A company that provided a grant to support Project EMMA, enabling the creation of a rooftop garden for seniors."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="USDA Senior Farmers Market Nutrition Program">
      <data key="d0">USDA Senior Farmers Market Nutrition Program</data>
      <data key="d1">organization</data>
      <data key="d2">"A government program that provides vouchers to qualifying seniors, allowing them to purchase fresh fruits and vegetables at local markets. This program is utilized as part of Project EMMA."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Farm-to-hospital Program">
      <data key="d0">Farm-to-hospital Program</data>
      <data key="d1">category</data>
      <data key="d2">"An initiative run by ASAP that connects regional hospitals with local farms. The program facilitates CSA pickups for employees, farmers' markets in hospitals, and the integration of fresh, local food into cafeteria and patient meals."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Growing New Farmers">
      <data key="d0">Growing New Farmers</data>
      <data key="d1">category</data>
      <data key="d2">"A strategic initiative and the next phase of work for the Appalachian Sustainable Agriculture Project (ASAP), as identified by director Charlie Jackson. The program aims to increase the supply of farmers by encouraging farm heirs with new business models and access to local markets to return to family farms."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Farm Credit">
      <data key="d0">Farm Credit</data>
      <data key="d1">organization</data>
      <data key="d2">"A long-standing farm-support group mentioned by Peter Marks. Its work in supporting farmers is seen as a foundation upon which ASAP's new strategies are built."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Farm Bureau">
      <data key="d0">Farm Bureau</data>
      <data key="d1">organization</data>
      <data key="d2">"A long-standing farm-support group mentioned by Peter Marks. Its work in supporting farmers is seen as a foundation upon which ASAP's new strategies are built."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Future Farmers of America">
      <data key="d0">Future Farmers of America</data>
      <data key="d1">organization</data>
      <data key="d2">"A long-standing farm-support group mentioned by Peter Marks, noted for working to encourage and recognize the younger generation who choose farming careers."&gt;</data>
      <data key="d3">chunk-30c38b37fe24e15bfa43a713c9e38509</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Next Generation of Farmers">
      <data key="d0">Next Generation of Farmers</data>
      <data key="d1">category</data>
      <data key="d2">The Next Generation of Farmers is a key focus group for ASAP. The organization aims to develop creative and proven models to encourage young people to enter farming, overcoming discouragement and creating pathways to land ownership.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local Food Economies">
      <data key="d0">Local Food Economies</data>
      <data key="d1">category</data>
      <data key="d2">Local Food Economies are the economic systems built around locally produced and sold food. ASAP's primary goal is to build and expand these economies, which in turn supports local farms, communities, and provides fresh food to institutions.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Discouraged Farm Heirs">
      <data key="d0">Discouraged Farm Heirs</data>
      <data key="d1">category</data>
      <data key="d2">Discouraged Farm Heirs are young people from farming families who are discouraged from staying in agriculture, often by their own parents. They are a target audience for ASAP's messaging and outreach efforts.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Owners of Large Farms">
      <data key="d0">Owners of Large Farms</data>
      <data key="d1">category</data>
      <data key="d2">Owners of Large Farms are landowners in the region who no longer wish to farm but want to keep their land in agriculture. They are seen by ASAP as a potential source of land for new farmers through long-term leases and other arrangements.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Communities Throughout The Nation">
      <data key="d0">Communities Throughout The Nation</data>
      <data key="d1">geo</data>
      <data key="d2">Communities Throughout The Nation are other regions in the U.S. that could benefit from adopting the successful models developed by ASAP for creating a new generation of farmers and strengthening local food economies.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Community Schools And Institutions">
      <data key="d0">Community Schools And Institutions</data>
      <data key="d1">organization</data>
      <data key="d2">Community Schools and Institutions are organizations, including hospitals, that are potential large-scale buyers of local food. Connecting farmers to these institutions is a key strategy for growing the local food economy.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food Distributor">
      <data key="d0">Food Distributor</data>
      <data key="d1">organization</data>
      <data key="d2">A Food Distributor is a key intermediary in the food system that ASAP engages with. They connect local farms to larger institutional clients like hospitals and schools, and their cooperation is crucial for expanding the local food market.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Hospital">
      <data key="d0">Hospital</data>
      <data key="d1">organization</data>
      <data key="d2">A Hospital is used as a prime example of an institutional client whose interest in local food can trigger a chain of new relationships and connections within the food system, often facilitated by ASAP.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Community Food System Assessment">
      <data key="d0">Community Food System Assessment</data>
      <data key="d1">event</data>
      <data key="d2">A Community Food System Assessment is a service offered by ASAP to other regions. It is a practical study designed to identify community needs and assets to develop markets for local farmers and expand local food economies.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local Food: Thousands of Miles Fresher">
      <data key="d0">Local Food: Thousands of Miles Fresher</data>
      <data key="d1">category</data>
      <data key="d2">'Local Food: Thousands of Miles Fresher' is the central marketing slogan, or 'gateway message,' used by the Appalachian Sustainable Agriculture Project (ASAP) to build awareness and commitment to local food.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Bumper Stickers">
      <data key="d0">Bumper Stickers</data>
      <data key="d1">category</data>
      <data key="d2">An affordable branding and messaging tool used by ASAP, featuring the slogan 'Local Food: Thousands of Miles Fresher'. Hundreds of thousands have been distributed as an affordable branding method.&lt;SEP&gt;Bumper Stickers are an affordable and effective marketing tool used by ASAP to spread their 'Local Food: Thousands of Miles Fresher' message widely, with hundreds of thousands given out.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Regional Food Map">
      <data key="d0">Regional Food Map</data>
      <data key="d1">category</data>
      <data key="d2">The Regional Food Map is a marketing tool developed by the Appalachian Sustainable Agriculture Project (ASAP) to help consumers find and connect with local food sources.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Social and Digital Media">
      <data key="d0">Social and Digital Media</data>
      <data key="d1">category</data>
      <data key="d2">Social and Digital Media, including Twitter, Facebook, blogs, listserves, and newsletters, are the various channels ASAP uses to consistently repeat its message and engage with the community.</data>
      <data key="d3">chunk-9fee18f76430d121ab613984069f209e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Southern Appalachia">
      <data key="d0">Southern Appalachia</data>
      <data key="d1">geo</data>
      <data key="d2">A geographic region in the United States that is the focus of ASAP's activities. ASAP's Regional Food Map and Trip Planner specifically covers this area.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="The Appalachian Center for Economic Networks">
      <data key="d0">The Appalachian Center for Economic Networks</data>
      <data key="d1">organization</data>
      <data key="d2">Referred to as ACEnet, this is an organization in Ohio that runs a program similar to ASAP's. It uses the 'Food We Love' umbrella brand to help small-scale producers access retail markets.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Farm Tour">
      <data key="d0">Farm Tour</data>
      <data key="d1">event</data>
      <data key="d2">An annual event organized by ASAP over a weekend, allowing the public to visit over 40 farms across six counties. It is designed to connect consumers with local producers of vegetables, meats, cheeses, and other farm products.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Harvest Festivals">
      <data key="d0">Harvest Festivals</data>
      <data key="d1">event</data>
      <data key="d2">Seasonal events celebrating crops like apples and pumpkins. ASAP helps regional farmers to organize and promote these festivals.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="'Get Local' Campaign">
      <data key="d0">'Get Local' Campaign</data>
      <data key="d1">event</data>
      <data key="d2">A monthly marketing campaign run by ASAP that focuses on one specific seasonal food each month. The campaign coordinates with farms, distributors, and restaurants to promote the featured food.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food We Love">
      <data key="d0">Food We Love</data>
      <data key="d1">category</data>
      <data key="d2">"'Food We Love' is an umbrella brand created by ACEnet to market and distribute products from its client businesses. This brand helps small producers gain access to larger retail markets and assures retailers of the products' local provenance."&gt;&lt;SEP&gt;An umbrella brand created by The Appalachian Center for Economic Networks (ACEnet). It is used to market a variety of local products from small-scale producers, giving them access to retail markets.&lt;SEP&gt;An umbrella brand under which a variety of local products are sold. The program guarantees local provenance and is distributed by ACEnet.</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010&lt;SEP&gt;chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Regional Food Map and Trip Planner">
      <data key="d0">Regional Food Map and Trip Planner</data>
      <data key="d1">category</data>
      <data key="d2">A free map produced and distributed by ASAP that covers southern Appalachia. It identifies various local food points of interest such as tailgate markets, farm stores, restaurants serving local food, and you-pick farms.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Hayride">
      <data key="d0">Hayride</data>
      <data key="d1">category</data>
      <data key="d2">A specific guide to farm field trips produced by ASAP as a resource for teachers.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local Food Guide for Kids">
      <data key="d0">Local Food Guide for Kids</data>
      <data key="d1">category</data>
      <data key="d2">A publication by ASAP designed for children, which includes accompanying lesson plans and a 'kid-size' bumper sticker to engage younger audiences.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Certified Brand Name">
      <data key="d0">Certified Brand Name</data>
      <data key="d1">category</data>
      <data key="d2">A strategic concept for marketing a region's local food. It provides buyers with assurance of local origin and high quality, facilitates transactions between farmers and distributors, and builds a customer base.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Farmer Profiles">
      <data key="d0">Farmer Profiles</data>
      <data key="d1">category</data>
      <data key="d2">A type of marketing material used as part of a certified brand strategy. These profiles personalize products by sharing stories and photos of the farm, farm family, and their operations.</data>
      <data key="d3">chunk-a2d3545603e988fef215052ef7f681c4</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="ACEnet">
      <data key="d0">ACEnet</data>
      <data key="d1">organization</data>
      <data key="d2">"ACEnet is a business incubator focused on food entrepreneurship in Appalachian Ohio. It provides shared-use facilities, including a commercial kitchen, storage, and a packing room, along with technical support and marketing assistance to its clients. It aims to foster economic development, create jobs, and support the region's low-income population."&gt;&lt;SEP&gt;An organization that distributes and maintains retail displays for the 'Food We Love' brand, helping small-scale local producers gain access to retail markets.&lt;SEP&gt;An organization that supports an underserved population in a 32-county region by offering a 50 percent discount on kitchen-facility rent, which aids in building local food infrastructure.</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-497b3487d00eabefe426a10fa32f8010&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Nonprofit Distribution Model">
      <data key="d0">Nonprofit Distribution Model</data>
      <data key="d1">category</data>
      <data key="d2">A business model for local food distribution, exemplified by ASD. It prioritizes a social and environmental mission, such as farmer education and community support, over pure profit, and is contrasted with for-profit cooperative models.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Organic Valley">
      <data key="d0">Organic Valley</data>
      <data key="d1">organization</data>
      <data key="d2">A for-profit cooperative with a social conscience, cited as a successful alternative to the nonprofit distribution model.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Small-Scale Producers">
      <data key="d0">Small-Scale Producers</data>
      <data key="d1">category</data>
      <data key="d2">A group of food producers operating on a small scale. The text describes how programs like the one from ACEnet provide them with crucial access to larger retail markets.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local, Organic Food">
      <data key="d0">Local, Organic Food</data>
      <data key="d1">category</data>
      <data key="d2">A specific category of food whose market reputation is vulnerable to poor handling and display in stores. Anthony Flaccovento warns that poor presentation can create negative misconceptions about this food type.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Supermarket Chains">
      <data key="d0">Supermarket Chains</data>
      <data key="d1">category</data>
      <data key="d2">Large retail customers for organizations like Appalachian Sustainable Development (ASD). The text notes that selling to them is economically efficient for distribution.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Smaller Grocers">
      <data key="d0">Smaller Grocers</data>
      <data key="d1">category</data>
      <data key="d2">A customer segment for Appalachian Sustainable Development (ASD). Selling to them is described as an important community service and a way to build local support, even if it is less economically efficient than serving larger chains.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="CSAs (Community Supported Agriculture)">
      <data key="d0">CSAs (Community Supported Agriculture)</data>
      <data key="d1">category</data>
      <data key="d2">A type of customer base for Appalachian Sustainable Development (ASD). ASD forms mutually beneficial partnerships with CSAs, such as Lynchburg Grows, which are located along its delivery routes.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="For-Profit Cooperative Model">
      <data key="d0">For-Profit Cooperative Model</data>
      <data key="d1">category</data>
      <data key="d2">A business model for food distribution that is contrasted with the nonprofit model. It is characterized as potentially being faster and more efficient at capitalization but at risk of abandoning its social mission if it becomes unprofitable.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Cooperative Extension">
      <data key="d0">Cooperative Extension</data>
      <data key="d1">organization</data>
      <data key="d2">An institution that traditionally provides services like farmer education. The text notes that Appalachian Sustainable Development (ASD) performs many of these same functions within its nonprofit framework.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Rural Economies">
      <data key="d0">Rural Economies</data>
      <data key="d1">category</data>
      <data key="d2">The economic systems in rural areas, such as the Appalachian region. Appalachian Sustainable Development (ASD) has a core mission to facilitate the revitalization of these economies.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food and Forestry">
      <data key="d0">Food and Forestry</data>
      <data key="d1">category</data>
      <data key="d2">The two primary sectors through which Appalachian Sustainable Development (ASD) works to achieve its mission of revitalizing rural economies in an ecologically sustainable way.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Ordinary Food">
      <data key="d0">Ordinary Food</data>
      <data key="d1">category</data>
      <data key="d2">A category of food that Anthony Flaccovento advocates for as the foundation of a successful local food system, contrasting it with niche or specialty items.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Ordinary People">
      <data key="d0">Ordinary People</data>
      <data key="d1">category</data>
      <data key="d2">The target consumer group for a local food system, as identified by Anthony Flaccovento. He suggests that the system should focus on growing ordinary food for this group.</data>
      <data key="d3">chunk-497b3487d00eabefe426a10fa32f8010</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Appalachia">
      <data key="d0">Appalachia</data>
      <data key="d1">geo</data>
      <data key="d2">"Appalachia is a region in the U.S., specifically mentioned in the context of Virginia and Tennessee, characterized by both natural beauty and poverty. ASD's work is focused on revitalizing this region's economy in a post-coal and post-tobacco era."&gt;&lt;SEP&gt;A rural region in the United States where needy families receive aid from SoSA's Seed Potato Program.</data>
      <data key="d3">chunk-347d33c4b812366f78a72782c922f5f8&lt;SEP&gt;chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Catholic Diocese">
      <data key="d0">Catholic Diocese</data>
      <data key="d1">organization</data>
      <data key="d2">"The Catholic Diocese is a religious organization where Anthony Flaccovento ran the office of social justice in eastern Kentucky after college. This experience was foundational to his commitment to social justice, which led to the creation of ASD."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Eastern Kentucky">
      <data key="d0">Eastern Kentucky</data>
      <data key="d1">geo</data>
      <data key="d2">"Eastern Kentucky is the location where Anthony Flaccovento worked for the Catholic Diocese's office of social justice, shaping his views on economic and environmental issues."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="PBS">
      <data key="d0">PBS</data>
      <data key="d1">organization</data>
      <data key="d2">"PBS is a media organization to which Anthony Flaccovento gave an interview in 2007, explaining ASD's goal of redefining what a healthy economy and economic development mean."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food City">
      <data key="d0">Food City</data>
      <data key="d1">organization</data>
      <data key="d2">"A large regional grocery chain that ASD approached to sell its produce. Food City's interest was contingent on the produce being certified organic, which motivated ASD's farmer transition program."&gt;&lt;SEP&gt;"Food City is a regional grocery chain that Appalachian Sustainable Development (ASD) approached to secure contracts for selling produce from its Appalachian Harvest brand."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff&lt;SEP&gt;chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Ukrops">
      <data key="d0">Ukrops</data>
      <data key="d1">organization</data>
      <data key="d2">"A regional grocery chain, along with Food City and Whole Foods, that ASD approached. Their demand for certified organic produce was a key factor in ASD's strategy."&gt;&lt;SEP&gt;"Ukrops is a regional grocery chain that Appalachian Sustainable Development (ASD) approached to sell locally grown produce."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff&lt;SEP&gt;chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Whole Foods">
      <data key="d0">Whole Foods</data>
      <data key="d1">organization</data>
      <data key="d2">"A major regional grocery chain that expressed interest in Appalachian Harvest produce but required it to be certified organic, influencing ASD's focus on organic transition for local farmers."&gt;&lt;SEP&gt;"Whole Foods is a regional grocery chain that Appalachian Sustainable Development (ASD) approached as a potential market for its farmers' produce."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff&lt;SEP&gt;chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="&quot;Jobs Or The Environment&quot; Debate">
      <data key="d0">"Jobs Or The Environment" Debate</data>
      <data key="d1">category</data>
      <data key="d2">"A concept described as a 'chronic lose-lose proposition' that pits economic development against environmental protection. Appalachian Sustainable Development was founded specifically to challenge this false dichotomy by creating jobs while also protecting the environment."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Northwest Spotted Owl">
      <data key="d0">Northwest Spotted Owl</data>
      <data key="d1">event</data>
      <data key="d2">"A national debate concerning the Northwest spotted owl that is used in the text as the epitomizing example of the 'jobs or the environment' conflict, highlighting the clash between economic interests (like logging) and environmental protection."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Post-Coal and Post-Tobacco Era">
      <data key="d0">Post-Coal and Post-Tobacco Era</data>
      <data key="d1">category</data>
      <data key="d2">"An economic and social period defining the challenges faced by rural Appalachia. The region needed to reinvent its economy following the decline of these two key industries, a context which directly prompted the work of organizations like ASD."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Sustainable Farming and Forestry">
      <data key="d0">Sustainable Farming and Forestry</data>
      <data key="d1">category</data>
      <data key="d2">"The two economic arenas that Appalachian Sustainable Development chose to focus on for regional revitalization. They were selected because they build on the Appalachian region's existing strengths and offer a path for sustainable economic growth."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Tobacco Industry">
      <data key="d0">Tobacco Industry</data>
      <data key="d1">category</data>
      <data key="d2">"A historically significant agricultural industry in Appalachia. Its decline in the 1990s, as support shifted overseas, created an economic freefall for many local farmers, making them the target audience for ASD's transition programs."&gt;</data>
      <data key="d3">chunk-b26f04bc8df6a747ead835cc8d210eec</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Flaccovento">
      <data key="d0">Flaccovento</data>
      <data key="d1">person</data>
      <data key="d2">"A key figure associated with ASD who provides commentary on the organization's strategy, the challenges of recruiting farmers, the economics of tobacco versus organic farming, and the importance of supporting new farmers."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Tobacco">
      <data key="d0">Tobacco</data>
      <data key="d1">category</data>
      <data key="d2">"A traditional crop that has been the centerpiece of the economy in southwest Virginia. It is presented as a less profitable and less sustainable option compared to organic vegetable farming, which ASD promotes as an alternative."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Organic Production">
      <data key="d0">Organic Production</data>
      <data key="d1">category</data>
      <data key="d2">"A method of farming that ASD encourages farmers to adopt. It is driven by market demand from grocery chains and offers higher potential income than tobacco. ASD provides workshops and support to help farmers transition."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Appalachian Center for Economic Networks (ACEnet)">
      <data key="d0">Appalachian Center for Economic Networks (ACEnet)</data>
      <data key="d1">organization</data>
      <data key="d2">"A nonprofit community development organization founded in 1985 in southeastern Ohio. ACEnet fosters small businesses in various sectors, including food and agriculture, by providing technical assistance, business training, and access to a commercial kitchen facility."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Southeastern Ohio">
      <data key="d0">Southeastern Ohio</data>
      <data key="d1">geo</data>
      <data key="d2">"The Appalachian region in Ohio where the Appalachian Center for Economic Networks (ACEnet) is based and primarily serves."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="ACEnet Ventures">
      <data key="d0">ACEnet Ventures</data>
      <data key="d1">organization</data>
      <data key="d2">"A sister organization to ACEnet that provides access to capital and financing for qualified applicants, supporting the growth of new businesses."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food Manufacturing &amp; Commercial Kitchen Facility">
      <data key="d0">Food Manufacturing &amp; Commercial Kitchen Facility</data>
      <data key="d1">organization</data>
      <data key="d2">"A shared-use facility operated by ACEnet that provides entrepreneurs with access to a commercial kitchen, packing room, and storage. It can be rented hourly to support food ventures."&gt;&lt;SEP&gt;"The Food Manufacturing &amp; Commercial Kitchen Facility is a key asset operated by ACEnet. It is a shared-use facility available 24/7 for rent, featuring a commercial kitchen, packing room, warehouse, and thermal processing room. It serves as the physical infrastructure for food entrepreneurs in the ACEnet program."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="ASD Workshops and Seminars">
      <data key="d0">ASD Workshops and Seminars</data>
      <data key="d1">event</data>
      <data key="d2">"Educational events hosted by ASD to inform farmers about the opportunities in organic production. They are a key part of ASD's recruitment strategy, although it often takes years of interaction after attending for a farmer to commit."&gt;</data>
      <data key="d3">chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Food Entrepreneurship">
      <data key="d0">Food Entrepreneurship</data>
      <data key="d1">category</data>
      <data key="d2">"A key focus area for ACEnet. The organization fosters new food-related small businesses by providing services like business training, product development support, and access to capital and kitchen facilities."&gt;&lt;SEP&gt;"Food entrepreneurship is the core concept and economic activity that ACEnet's programs are designed to support. The text presents it as a viable path for economic development, job creation, and value-added opportunities for agricultural products."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-efae0d6c5dabc751b9ceb56518857dff</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Appalachian Ohio">
      <data key="d0">Appalachian Ohio</data>
      <data key="d1">geo</data>
      <data key="d2">"Appalachian Ohio is a rural region identified as ACEnet's primary service area. It includes 32 counties and has a large low-income population, which ACEnet supports by offering a 50% discount on facility rent to clients from the area."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Leslie Schaller">
      <data key="d0">Leslie Schaller</data>
      <data key="d1">person</data>
      <data key="d2">"Leslie Schaller is the Director of Programming for ACEnet. She is cited as an expert who provides lessons and advice on building a successful business incubator, emphasizing stakeholder involvement, using existing infrastructure, and setting tiered goals."&gt;&lt;SEP&gt;A representative of The Appalachian Center for Economic Networks (ACEnet) located in Athens, OH.</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Nelsonville, Ohio">
      <data key="d0">Nelsonville, Ohio</data>
      <data key="d1">geo</data>
      <data key="d2">"Nelsonville, Ohio, is the city where ACEnet opened a second business incubation center in 2006, expanding its services to include mixed-use space for manufacturing and distribution companies."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Business Incubator">
      <data key="d0">Business Incubator</data>
      <data key="d1">category</data>
      <data key="d2">"A business incubator is a type of organization designed to support startups and new businesses. The text uses ACEnet as a successful case study of a food-focused business incubator, detailing its effective strategies and structure."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Umbrella Brand">
      <data key="d0">Umbrella Brand</data>
      <data key="d1">category</data>
      <data key="d2">"An umbrella brand is a marketing concept where a single brand name is used for a range of products from different small businesses. The text highlights this as a 'Bright Idea' and a creative marketing tool to give small businesses access to larger distribution networks."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Artisan Businesses">
      <data key="d0">Artisan Businesses</data>
      <data key="d1">category</data>
      <data key="d2">"Artisan Businesses are a category of clients served by ACEnet. The text notes that in 2009, the Athens facility hosted 25 such businesses that use the shared kitchen facility to create products."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="State Health Inspectors">
      <data key="d0">State Health Inspectors</data>
      <data key="d1">organization</data>
      <data key="d2">"State Health Inspectors are a regulatory body that ACEnet proactively involved in the design process of its commercial kitchen facility to ensure compliance with health codes from the very beginning."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local Officials">
      <data key="d0">Local Officials</data>
      <data key="d1">category</data>
      <data key="d2">"Local Officials are identified as a key stakeholder group that should be engaged on an ongoing basis regarding policies that could affect a business incubator project."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Investors">
      <data key="d0">Investors</data>
      <data key="d1">category</data>
      <data key="d2">"Investors are identified as a crucial stakeholder group to engage on an ongoing basis. Their connection to national networks can create a larger pool of resources for a project's clients."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="The Grassroots Food Movement">
      <data key="d0">The Grassroots Food Movement</data>
      <data key="d1">category</data>
      <data key="d2">"The Grassroots Food Movement is a national trend focused on local production, milling, and distribution of food, particularly expanding into areas like whole grains."&gt;</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Local Grain Economy">
      <data key="d0">Local Grain Economy</data>
      <data key="d1">category</data>
      <data key="d2">"Rebuilding a Local Grain Economy is presented as an expansion of the grassroots food movement, focusing on the production, milling, and distribution of whole and heritage grains at a local level."&gt;&lt;SEP&gt;A regional food system focused on the local production, milling, and distribution of grains. It is presented as a missing link in many local food systems and requires new infrastructure like growers, millers, and customers.</data>
      <data key="d3">chunk-e6824e03de6d996c4161ce46d959096b&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Southern Willamette Valley Bean and Grain Project">
      <data key="d0">Southern Willamette Valley Bean and Grain Project</data>
      <data key="d1">organization</data>
      <data key="d2">An organization in Oregon founded by Harry MacCormack that works to restore cereal grains as a significant regional crop. It conducts research, holds workshops, and connects buyers with farmers.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Willamette Valley">
      <data key="d0">Willamette Valley</data>
      <data key="d1">geo</data>
      <data key="d2">A region in Oregon where grass seed is the dominant crop, and where the Southern Willamette Valley Bean and Grain Project is working to establish grains as a viable alternative.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Harry Maccormack">
      <data key="d0">Harry Maccormack</data>
      <data key="d1">person</data>
      <data key="d2">The founder of the Southern Willamette Valley Bean and Grain Project, who initiated its work with small, hand-harvested test plots.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Dan Armstrong">
      <data key="d0">Dan Armstrong</data>
      <data key="d1">person</data>
      <data key="d2">"An individual associated with the Southern Willamette Bean and Grain Project who wrote a piece titled 'Why Beans and Grains'."&gt;&lt;SEP&gt;A leader of the Southern Willamette Valley Bean and Grain Project who advocates for growing more local food crops, especially grains, as a substitute for grass seed.&lt;SEP&gt;An individual mentioned in the index.</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Northern Grain Growers Association">
      <data key="d0">Northern Grain Growers Association</data>
      <data key="d1">organization</data>
      <data key="d2">A farmer-grown organization in Vermont that works with the University of Vermont to raise awareness about local grain heritage and identify suitable grain varieties for the region.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="University of Vermont">
      <data key="d0">University of Vermont</data>
      <data key="d1">organization</data>
      <data key="d2">An educational institution that collaborates with the Northern Grain Growers Association to support the local grain movement in Vermont.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Northeast Organic Wheat">
      <data key="d0">Northeast Organic Wheat</data>
      <data key="d1">organization</data>
      <data key="d2">A consortium of heritage wheat teams operating across four states, dedicated to raising awareness about local grain heritage and identifying optimal grain varieties for specific regions.&lt;SEP&gt;A consortium of teams in Vermont, New York, Massachusetts, and Maine that works to restore rare, heritage wheats and educates farmers on cultivation and breeding techniques.</data>
      <data key="d3">chunk-9e716e5bd5f06009e0468b77709b834d&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="North Carolina Organic Bread Flour Project">
      <data key="d0">North Carolina Organic Bread Flour Project</data>
      <data key="d1">organization</data>
      <data key="d2">"A regional initiative focused on developing wheat production in North Carolina, as documented on its blog."&gt;&lt;SEP&gt;An initiative in North Carolina that works to connect farmers and bakers to create a viable local grain market, providing security and sustainability for growers, millers, and bakers.</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Central Virginia Grain Project">
      <data key="d0">Central Virginia Grain Project</data>
      <data key="d1">organization</data>
      <data key="d2">"A local grain initiative in Central Virginia with the mission 'Feed the People'."&gt;&lt;SEP&gt;An initiative in Virginia, inspired by the North Carolina project, that works with local farmers to build a seed bank for heritage wheat varieties.</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Kootenay Grain CSA">
      <data key="d0">Kootenay Grain CSA</data>
      <data key="d1">organization</data>
      <data key="d2">A Community Supported Agriculture (CSA) program founded in British Columbia by farmers and activists to grow grain sustainably for local consumption.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Wheatberry Bakery">
      <data key="d0">Wheatberry Bakery</data>
      <data key="d1">organization</data>
      <data key="d2">"A bakery in western Massachusetts that, in response to a 2008 rise in flour prices, established the region's first grain CSA. It grew to distribute 10,000 pounds of organic local grains by 2010 and provides milling services."&gt;&lt;SEP&gt;A bakery in western Massachusetts that, motivated by rising flour prices in 2008, created the region's first grain CSA to establish an economical local source of grains.</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Grain CSAs">
      <data key="d0">Grain CSAs</data>
      <data key="d1">category</data>
      <data key="d2">A Community Supported Agriculture model specifically for grains. They are identified as a critical step in rebuilding local grain infrastructure by reducing risk for small mills and connecting consumers directly with local farmers and their products.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Kootenay Region">
      <data key="d0">Kootenay Region</data>
      <data key="d1">geo</data>
      <data key="d2">"A region mentioned as the location of a Grain CSA initiative focused on sustainable, local grain production."&gt;&lt;SEP&gt;A region within British Columbia, Canada, where the Kootenay Grain CSA was established to grow grain sustainably for local consumption.</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a&lt;SEP&gt;chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="2008 Catastrophic Rise in Flour Prices">
      <data key="d0">2008 Catastrophic Rise in Flour Prices</data>
      <data key="d1">event</data>
      <data key="d2">A significant economic event in 2008 characterized by a sharp increase in flour costs. This event motivated Wheatberry Bakery to create a more economical local source of grains through a CSA.</data>
      <data key="d3">chunk-5d4150698732f393c235b8b3e1cb2d88</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Grain CSA">
      <data key="d0">Grain CSA</data>
      <data key="d1">category</data>
      <data key="d2">"A model of community-supported agriculture focused on grains, with the goal of growing them sustainably for local consumption. Examples in the text include initiatives offering heritage wheat, corn, beans, spelt, and rye."&gt;</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Huasna Valley Farm">
      <data key="d0">Huasna Valley Farm</data>
      <data key="d1">organization</data>
      <data key="d2">"A farm located in California that grows heirloom wheat sustainably and distributes it as flour through a local CSA."&gt;&lt;SEP&gt;"A farm that organized a Grain CSA for SLO County for the 2010–2011 season."&gt;</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Oklahoma Food Cooperative">
      <data key="d0">Oklahoma Food Cooperative</data>
      <data key="d1">organization</data>
      <data key="d2">"A cooperative that uses a website to connect consumers in Oklahoma with family farms, offering a variety of local products including wheat and barley flours."&gt;&lt;SEP&gt;"A food cooperative in Oklahoma that lists producers and products in its grains and flours sections."&gt;</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Bakers">
      <data key="d0">Bakers</data>
      <data key="d1">category</data>
      <data key="d2">"A professional group identified as natural leaders in the movement to revive regional grains. They create steady demand and raise consumer awareness."&gt;&lt;SEP&gt;A professional category for people who bake, which the index links to the 'local grain economy'.</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="San Francisco Bay Area">
      <data key="d0">San Francisco Bay Area</data>
      <data key="d1">geo</data>
      <data key="d2">"A region in California where bakers are actively working to revive and create demand for regional grains."&gt;</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Berkeley's Saturday Market">
      <data key="d0">Berkeley's Saturday Market</data>
      <data key="d1">event</data>
      <data key="d2">"A local market where 'Local Loaf,' a bread made by Morell's Breads from locally sourced flour, is in high demand."&gt;</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Full Belly Farm">
      <data key="d0">Full Belly Farm</data>
      <data key="d1">organization</data>
      <data key="d2">"A local farm that grows and mills the heirloom whole wheat flour used to make the 'Local Loaf' sold by Morell's Breads."&gt;</data>
      <data key="d3">chunk-104466acc0eb6f55c05f02aa258ea31a</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740878</data>
    </node>
    <node id="Eduardo Morell">
      <data key="d0">Eduardo Morell</data>
      <data key="d1">person</data>
      <data key="d2">"The founder of Morell's Breads, known for creating unique loaves with local grains that appeal to customers, including those with sensitivities to modern wheat."&gt;&lt;SEP&gt;"The individual associated with Morell's Bread, as indicated by the URL for the bakery's website."&gt;</data>
      <data key="d3">chunk-a214f4e9d9f3d3fed74243c9bdf50bf8&lt;SEP&gt;chunk-104466acc0eb6f55c05f02aa258ea31a</data>
