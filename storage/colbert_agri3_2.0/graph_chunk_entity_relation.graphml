    </node>
    <node id="Added-Value Marketing">
      <data key="d0">Added-Value Marketing</data>
      <data key="d1">category</data>
      <data key="d2">A marketing strategy highlighted as a way to significantly increase an enterprise's profitability. It involves processing a raw commodity into a more valuable product (e.g., hogs into sausage) and selling it directly to consumers.</data>
      <data key="d3">chunk-db06dd0bc574d59f7ffa8848b9ae23fd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Commodity Market">
      <data key="d0">Commodity Market</data>
      <data key="d1">category</data>
      <data key="d2">A type of market where raw products, like hogs, are sold. The text contrasts the low profitability of selling on this market with the high profitability of direct, value-added marketing.</data>
      <data key="d3">chunk-db06dd0bc574d59f7ffa8848b9ae23fd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
