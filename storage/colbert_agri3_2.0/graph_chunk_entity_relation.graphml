    <edge source="The Author" target="Agriculture Industry">
      <data key="d6">8.0</data>
      <data key="d7">The author urges every person involved in agriculture to become a spokesperson for the wider agriculture industry to educate the public and politicians.</data>
      <data key="d8">advocacy,industry representation</data>
