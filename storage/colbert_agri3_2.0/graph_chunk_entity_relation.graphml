      <data key="d4">unknown_source</data>
      <data key="d5">1753740851</data>
    </node>
    <node id="University Of Virginia">
      <data key="d0">University Of Virginia</data>
      <data key="d1">organization</data>
      <data key="d2">A university associated with several individuals involved in the book project, including faculty like Frank Dukes, and numerous graduate and undergraduate student researchers.&lt;SEP&gt;A university offering multiple courses on food-related topics, including food systems, food politics, and edible landscape design, indicating a deep integration of the food movement into its curriculum.</data>
      <data key="d3">chunk-4ffa8b612642fa385d2af41e902aa75d&lt;SEP&gt;chunk-a80590371c3ba416132df035a1f48358</data>
      <data key="d4">unknown_source</data>
