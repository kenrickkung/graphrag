      <data key="d11">1753740472</data>
    </edge>
    <edge source="Pollen" target="Fall Requeening">
      <data key="d6">7.0</data>
      <data key="d7">"The new young brood that results from fall requeening requires pollen as a necessary food source, linking the success of requeening to the availability of adequate pollen stores in the hive."&gt;</data>
      <data key="d8">brood rearing,colony nutrition</data>
