    <node id="Smithsonian Magazine">
      <data key="d0">Smithsonian Magazine</data>
      <data key="d1">organization</data>
      <data key="d2">Smithsonian magazine is a media publication that covered Barker's work, helping to spread awareness of his free garden projects.</data>
      <data key="d3">chunk-82372fd5a606e148caa2a0647673892b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740785</data>
