      <data key="d0">Early Childhood Learning Center</data>
      <data key="d1">organization</data>
      <data key="d2">The Early Childhood Learning Center is a planned facility for pre-kindergarten children, envisioned as part of the Gardens of Park Place agricultural center developed by the Jones Valley Urban Farm.</data>
      <data key="d3">chunk-9297eb734555e7b850045590e4fc5cb6</data>
      <data key="d4">unknown_source</data>
