    <node id="University extension offices">
      <data key="d0">University extension offices</data>
      <data key="d1">organization</data>
      <data key="d2">"Educational outreach offices associated with universities that serve as a source of information for farmers. They provide guidance on value-added agriculture, processing techniques, and kitchen requirements."&gt;</data>
      <data key="d3">chunk-5a5deb38ed9dc0a60bcac768fbb7955c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740812</data>
    </node>
    <node id="Value-added food">
      <data key="d0">Value-added food</data>
      <data key="d1">category</data>
      <data key="d2">"A central category in the text, referring to food products that have been processed from raw agricultural commodities to increase their value, convenience, or longevity. Examples include jams, sausages, and salsas. Producing them often requires special permits and approved kitchens."&gt;</data>
      <data key="d3">chunk-5a5deb38ed9dc0a60bcac768fbb7955c</data>
      <data key="d4">unknown_source</data>
