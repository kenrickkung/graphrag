      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Chefs" target="Culinary Schools">
      <data key="d6">7.0</data>
      <data key="d7">The text establishes a causal link where the move away from teaching slow-cooking methods in culinary schools has resulted in chefs being unprepared for whole-animal cuisine.</data>
      <data key="d8">curriculum impact,educational influence,skill gap</data>
