    </node>
    <node id="Seed Savers Exchange">
      <data key="d0">Seed Savers Exchange</data>
      <data key="d1">organization</data>
      <data key="d2">Seed Savers Exchange is a prominent national non-profit organization located in Decorah, Iowa. It is dedicated to conserving and promoting America's culturally diverse but endangered garden and food crop heritage for future generations. The organization achieves its mission by preserving and sharing heirloom seed varieties. It provides resources such as a large catalog of seeds, farmer seed exchange catalogs, and a yearbook. Additionally, individuals can contact Seed Savers Exchange to find existing seed-saving efforts in their area or to receive support and information on how to start their own.</data>
      <data key="d3">chunk-9e716e5bd5f06009e0468b77709b834d&lt;SEP&gt;chunk-60121fd34d6b068a55f53ef625e1f266&lt;SEP&gt;chunk-57c24510274e9c9fcb046e6b604285fd&lt;SEP&gt;chunk-fac6f2d596c9d9fe2bc3b9afda4f10df</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740863</data>
    </node>
    <node id="Stark Brothers">
      <data key="d0">Stark Brothers</data>
      <data key="d1">organization</data>
      <data key="d2">Stark Brothers is a company in Louisiana, Missouri, that sells fruit trees and peppers.</data>
      <data key="d3">chunk-57c24510274e9c9fcb046e6b604285fd</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Farm to School movement">
      <data key="d0">Farm to School movement</data>
      <data key="d1">category</data>
      <data key="d2">"A nationwide social and educational initiative that aims to connect schools with local farms to serve healthy, fresh food in school cafeterias, integrate food education into the curriculum, and support local economies. The movement grew from a few programs in the 1990s to thousands by 2010."&gt;</data>
      <data key="d3">chunk-cc6eed415e2d01ca41ab07d4cac89623</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="National Farm to School Program">
      <data key="d0">National Farm to School Program</data>
      <data key="d1">organization</data>
      <data key="d2">"A national program established in 2000 in response to growing concerns about youth obesity and diabetes. It was created to formalize and support the Farm to School movement across the country."&gt;</data>
      <data key="d3">chunk-cc6eed415e2d01ca41ab07d4cac89623</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Farm to Cafeteria conference">
      <data key="d0">Farm to Cafeteria conference</data>
      <data key="d1">event</data>
      <data key="d2">"A conference for advocates and participants of the Farm to School movement, with the first one taking place in 2002."&gt;</data>
      <data key="d3">chunk-cc6eed415e2d01ca41ab07d4cac89623</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Emily Jackson">
      <data key="d0">Emily Jackson</data>
      <data key="d1">person</data>
      <data key="d2">Emily Jackson is the director of the Growing Minds program at the Appalachian Sustainable Agriculture Project (ASAP). As a representative of these organizations, she is a key advocate for integrating farm-to-school initiatives into school curricula. She has provided testimony before a U.S. Senate committee regarding the Farm Bill Reauthorization, where she spoke about regulatory challenges from the USDA. Jackson provides key insights and lessons learned, emphasizing the critical importance of getting the child nutrition director and food-service staff on board for a successful program. She also stresses that the goal of the Growing Minds program is to integrate with existing teaching requirements rather than adding to teachers' workloads.</data>
      <data key="d3">chunk-f188db350c6a6f2fdb22a9e9283e4dc3&lt;SEP&gt;chunk-8d3d51c80e398fde0d7a70a89888fa0e&lt;SEP&gt;chunk-8c9669112f71f37c0273243e8cc59e05&lt;SEP&gt;chunk-30c38b37fe24e15bfa43a713c9e38509&lt;SEP&gt;chunk-7c0dfef7989eab5ae8b58770f9786cac&lt;SEP&gt;chunk-cc6eed415e2d01ca41ab07d4cac89623&lt;SEP&gt;chunk-59c16ea96bc625614680cc6d8276e6ca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Western Carolina University">
      <data key="d0">Western Carolina University</data>
      <data key="d1">organization</data>
      <data key="d2">"A university that partners with the Growing Minds program to integrate Farm to School instruction into the training for pre-service teachers and dietitians."&gt;</data>
      <data key="d3">chunk-cc6eed415e2d01ca41ab07d4cac89623</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="U.S. Senate's Agriculture, Nutrition, and Forestry Committee">
      <data key="d0">U.S. Senate's Agriculture, Nutrition, and Forestry Committee</data>
      <data key="d1">organization</data>
      <data key="d2">"A U.S. Senate committee before which Emily Jackson testified in 2007. She spoke about the challenges that USDA regulations pose to schools trying to procure local food."&gt;</data>
      <data key="d3">chunk-cc6eed415e2d01ca41ab07d4cac89623</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
    <node id="Carolina Produce">
      <data key="d0">Carolina Produce</data>
      <data key="d1">organization</data>
      <data key="d2">"A food distributor located in South Carolina that partnered with Growing Minds to supply local food to Asheville-area schools, using the Appalachian Grown certification to identify local sources."&gt;&lt;SEP&gt;"Carolina Produce is a local food distributor that had an existing network for delivering to schools. ASAP partnered with them to scale up the distribution of local food to the school market without creating a new system."&gt;&lt;SEP&gt;A business or organization involved in the produce industry.</data>
      <data key="d3">chunk-0809b82d4ca6415545d8263dbdcfcf73&lt;SEP&gt;chunk-cc6eed415e2d01ca41ab07d4cac89623&lt;SEP&gt;chunk-59c16ea96bc625614680cc6d8276e6ca</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740848</data>
    </node>
