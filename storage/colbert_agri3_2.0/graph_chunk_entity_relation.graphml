    </node>
    <node id="Elementary Education Garden Program">
      <data key="d0">Elementary Education Garden Program</data>
      <data key="d1">category</data>
      <data key="d2">A program by Lynchburg Grows that assists in installing gardens at elementary schools, early learning centers, and a camp to serve as outdoor classrooms for learning about plants and healthy eating.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Farm Camp">
      <data key="d0">Farm Camp</data>
      <data key="d1">category</data>
      <data key="d2">An in-depth field trip program offered by Lynchburg Grows where schoolchildren participate in farm chores and learn about specific systems like composting, vermiculture, aquaculture, and animal stewardship.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="The Bucket Brigade">
      <data key="d0">The Bucket Brigade</data>
      <data key="d1">event</data>
      <data key="d2">The name given to the immense, physically demanding volunteer effort to replace all the soil in the greenhouses at Lynchburg Grows, which began in the summer of 2005.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Five Vacant Lots">
      <data key="d0">Five Vacant Lots</data>
      <data key="d1">geo</data>
      <data key="d2">A set of five neglected city lots that Lynchburg Grows purchased. They were eventually transformed into community gardens with direct input and participation from neighborhood residents.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Farming Systems">
      <data key="d0">Farming Systems</data>
      <data key="d1">category</data>
      <data key="d2">A category of agricultural knowledge and practices taught and utilized at Lynchburg Grows. Specific examples mentioned include composting, vermiculture (worm farming), raised beds, aquaculture, renewable resources, and animal stewardship.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="St. John's Episcopal Church">
      <data key="d0">St. John's Episcopal Church</data>
      <data key="d1">organization</data>
      <data key="d2">A religious organization whose congregation partners with Lynchburg Grows by using one of its greenhouses (Greenhouse 8) to grow food specifically for the hungry.</data>
      <data key="d3">chunk-a0ebf31ca8cf0e8a5dbe6d09c3efa272</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="At-risk youth and people with special needs">
      <data key="d0">At-risk youth and people with special needs</data>
      <data key="d1">category</data>
      <data key="d2">The primary demographic group served by Lynchburg Grows. The organization's core mission is to provide this group with life and job skills through various programs, including 'Farmer for a Day' and other job training partnerships.</data>
      <data key="d3">chunk-a0ebf31ca8cf0e8a5dbe6d09c3efa272</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Schenkel historic roses">
      <data key="d0">Schenkel historic roses</data>
      <data key="d1">category</data>
      <data key="d2">A specific variety of historic roses that Lynchburg Grows is restoring and cultivating in its greenhouses. They are used for bouquets donated to nursing homes and are being cloned for eventual sale.</data>
