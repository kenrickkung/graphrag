    <node id="Yale">
      <data key="d0">Yale</data>
      <data key="d1">organization</data>
      <data key="d2">Refers to Yale University, mentioned alongside Brown as a prominent example of a college that is aiming for food sustainability.&lt;SEP&gt;Yale is a university where Berkeley College and its dining hall are located.&lt;SEP&gt;Yale is the university where Sally Eason's father was an honors engineering student before he dropped out to start the Sunburst Trout Farm.</data>
      <data key="d3">chunk-60071a35b7d93bd331a3e0d32f9f3fe4&lt;SEP&gt;chunk-8c575c019780e689390cd685c690159f&lt;SEP&gt;chunk-a80590371c3ba416132df035a1f48358</data>
      <data key="d4">unknown_source</data>
