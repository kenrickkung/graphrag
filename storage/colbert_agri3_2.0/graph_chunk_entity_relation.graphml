    </edge>
    <edge source="University of Minnesota" target="Ojibwe">
      <data key="d6">7.0</data>
      <data key="d7">The Ojibwe tribe viewed the University of Minnesota's mapping of wild rice DNA as a major threat, fearing potential contamination and genetic engineering of their native rice stock.</data>
      <data key="d8">cultural protection,genetic engineering,perceived threat</data>
      <data key="d9">chunk-ef9c9aefa244f3e5e6f50b424cd984c4</data>
