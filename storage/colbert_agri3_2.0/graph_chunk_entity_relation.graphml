    <node id="Underground Market">
      <data key="d0">Underground Market</data>
      <data key="d1">event</data>
      <data key="d2">The Underground Market is a private, members-only market started by Iso Rabins in San Francisco. It functions as an 'incubator' for small-scale food producers to test and sell their products without the regulations of a traditional farmers' market.</data>
      <data key="d3">chunk-d6db795582f52e35a0bb9aea86e66f7f</data>
