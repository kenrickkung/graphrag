    <node id="Virginia Episcopal School">
      <data key="d0">Virginia Episcopal School</data>
      <data key="d1">organization</data>
      <data key="d2">Virginia Episcopal School is an educational institution that sent students to volunteer at Lynchburg Grows on multiple occasions during the soil replacement project.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Soil Replacement Project">
      <data key="d0">Soil Replacement Project</data>
      <data key="d1">event</data>
      <data key="d2">The Soil Replacement Project was a Herculean task undertaken by Lynchburg Grows starting in 2005. It involved replacing 150 tons of soil in each of its nine 200-foot-long greenhouses, a process that required immense volunteer effort over several years.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Neighborhood Garden Groundbreaking">
      <data key="d0">Neighborhood Garden Groundbreaking</data>
      <data key="d1">event</data>
      <data key="d2">The Neighborhood Garden Groundbreaking was a specific event in 2009 that marked the start of the first community garden on a vacant lot. It was a significant multicultural and multigenerational gathering that brought neighbors together and sparked further community improvement projects.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Composting Program">
      <data key="d0">Composting Program</data>
      <data key="d1">category</data>
      <data key="d2">The Composting Program is an initiative Lynchburg Grows started after discovering their purchased soil was of poor quality. They now create their own soil by composting about 2,000 tons of leaves and wood chips from the city and food waste from a local college.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="CSA (Community-Supported Agriculture)">
      <data key="d0">CSA (Community-Supported Agriculture)</data>
      <data key="d1">category</data>
      <data key="d2">The CSA program is a key part of Lynchburg Grows' model for financial stability. It provides members with weekly baskets of freshly grown food, connecting the farm directly with consumers.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Farmer For A Day">
      <data key="d0">Farmer For A Day</data>
      <data key="d1">category</data>
      <data key="d2">A program run by Lynchburg Grows in partnership with the local high school and community college. It brings 'transitional' youth (ages 18-21) to the farm once a week to participate in chores, build life skills, and prepare for the workforce.&lt;SEP&gt;An innovative youth program run by Lynchburg Grows where school classes are invited to the farm to learn about food sources, healthy eating, and participate in farm chores.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64&lt;SEP&gt;chunk-a0ebf31ca8cf0e8a5dbe6d09c3efa272</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Roots and Shoots">
      <data key="d0">Roots and Shoots</data>
      <data key="d1">category</data>
      <data key="d2">An intergenerational gardening program created by Lynchburg Grows that brings together elderly community members and youth to share in the joys and knowledge of gardening.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Grasshopper Bus">
      <data key="d0">Grasshopper Bus</data>
      <data key="d1">category</data>
      <data key="d2">A colorful mobile learning center, operated by Lynchburg Grows, that functions as a hands-on laboratory for youths, helping schools meet curriculum requirements by integrating agriculture.</data>
      <data key="d3">chunk-2cee86d7056c73fbe7bdaa432b2abe64</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
