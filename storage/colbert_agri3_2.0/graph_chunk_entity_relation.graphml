    </node>
    <node id="Halloween">
      <data key="d0">Halloween</data>
      <data key="d1">event</data>
      <data key="d2">Halloween is a seasonal holiday that presents a market opportunity for selling decorative agricultural items like cornstalks, miniature corn, and carved pumpkins.</data>
      <data key="d3">chunk-c1923a02fc73ab559e6ae4a61b5e1218</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Valentine's Day">
      <data key="d0">Valentine's Day</data>
      <data key="d1">event</data>
      <data key="d2">Valentine's Day is a key seasonal event with high sales potential for the cut-flower market.</data>
      <data key="d3">chunk-c1923a02fc73ab559e6ae4a61b5e1218</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740819</data>
    </node>
    <node id="Easter">
      <data key="d0">Easter</data>
      <data key="d1">event</data>
      <data key="d2">Easter is mentioned as a seasonal event that offers sales potential for flowers and floral arrangements.</data>
      <data key="d3">chunk-c1923a02fc73ab559e6ae4a61b5e1218</data>
      <data key="d4">unknown_source</data>
