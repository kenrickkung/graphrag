    <node id="Job Training">
      <data key="d0">Job Training</data>
      <data key="d1">category</data>
      <data key="d2">A key program component offered by Gateway Greening's City Seeds Urban Farm. It provides at-risk populations with practical skills in farming, gardening, and landscaping to help them secure employment.</data>
      <data key="d3">chunk-aab30ee2b8630558ddd6575d42c69264</data>
