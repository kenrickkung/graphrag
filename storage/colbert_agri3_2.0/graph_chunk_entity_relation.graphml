    <node id="Abernethy">
      <data key="d0">Abernethy</data>
      <data key="d1">organization</data>
      <data key="d2">"Abernethy is a school that has initiated a pilot kitchen program for its district, focusing on fresh, local foods. It features a daily salad bar, a 'Harvest of the Month' program, an integrated garden curriculum, and is supported by a very active PTA."&gt;</data>
      <data key="d3">chunk-5a81765c57d711272f41bff8f406f472</data>
      <data key="d4">unknown_source</data>
