      <data key="d1">category</data>
      <data key="d2">"A specific product derived from alternative livestock (elk or deer) that has a built-in market, serving as an example of a niche product."&gt;</data>
      <data key="d3">chunk-df880ab4353881f2fe1a61ec533c5679</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740810</data>
    </node>
