    <node id="Community-supported agriculture (CSA) project">
      <data key="d0">Community-supported agriculture (CSA) project</data>
      <data key="d1">category</data>
      <data key="d2">A community-supported agriculture (CSA) project is a food production and distribution model where community members become shareholders in a farm's harvest. Troy Community Farm is organized as a CSA.</data>
      <data key="d3">chunk-aaa683758c365cd82a3b03895da095e8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740814</data>
