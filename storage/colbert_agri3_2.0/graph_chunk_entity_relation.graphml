    <node id="Apistan/Fluvalinate">
      <data key="d0">Apistan/Fluvalinate</data>
      <data key="d1">category</data>
      <data key="d2">A chemical treatment (miticide) used by beekeepers to control Varroa mite infestations in honey bee colonies.</data>
      <data key="d3">chunk-6550c1217ac242a6cb1c3d9a5de5ee35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
