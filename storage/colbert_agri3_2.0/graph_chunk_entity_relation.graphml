    <node id="Dig Deep Farms">
      <data key="d0">Dig Deep Farms</data>
      <data key="d1">organization</data>
      <data key="d2">A Bay Area enterprise focused on converting blighted land for agricultural use and employing local residents. It partners with People's Grocery for the Grub Box CSA program.</data>
      <data key="d3">chunk-bb8186cf72c91110756ec67bcc379a67</data>
      <data key="d4">unknown_source</data>
