      <data key="d10">unknown_source</data>
      <data key="d11">1753740880</data>
    </edge>
    <edge source="Neighbors" target="Economics Of Machinery">
      <data key="d6">8.0</data>
      <data key="d7">Engaging with neighbors through bartering, trading, or hiring for custom work is presented as a key economic strategy to gain access to machinery without purchasing it.</data>
