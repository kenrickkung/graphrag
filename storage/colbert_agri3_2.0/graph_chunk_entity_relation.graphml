      <data key="d0">The Samuel Roberts Noble Foundation</data>
      <data key="d1">organization</data>
      <data key="d2">An organization that publishes the 'Ag News &amp; Views' newsletter and provides general farm information through its website.&lt;SEP&gt;The publisher of the 'Ag News &amp; Views' newsletter, inferred from the name 'The Samuel Roberts Noble'.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690&lt;SEP&gt;chunk-5aeb69db517fc797c325acc9dcb88413</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740838</data>
    </node>
    <node id="Ag News &amp; Views">
      <data key="d0">Ag News &amp; Views</data>
      <data key="d1">organization</data>
      <data key="d2">A monthly newsletter from The Samuel Roberts Noble Foundation that provides general farm information.&lt;SEP&gt;A newsletter published by The Samuel Roberts Noble Foundation.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690&lt;SEP&gt;chunk-5aeb69db517fc797c325acc9dcb88413</data>
