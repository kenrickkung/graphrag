    <node id="Beekeeping, History Of">
      <data key="d0">Beekeeping, History Of</data>
      <data key="d1">event</data>
      <data key="d2">The evolution of beekeeping practices, described in the text as occurring in three major eras, with the discovery of 'bee space' marking the start of the second era.</data>
      <data key="d3">chunk-6550c1217ac242a6cb1c3d9a5de5ee35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Bees, How To Acquire">
      <data key="d0">Bees, How To Acquire</data>
      <data key="d1">category</data>
      <data key="d2">The various methods available for a beekeeper to start a colony, including purchasing a package or nucleus hive, or capturing a wild swarm or colony.</data>
      <data key="d3">chunk-6550c1217ac242a6cb1c3d9a5de5ee35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Colony Cycle">
      <data key="d0">Colony Cycle</data>
      <data key="d1">category</data>
      <data key="d2">The annual progression of a honey bee colony's population and activities, including brood rearing, honey production, and winter survival.</data>
      <data key="d3">chunk-6550c1217ac242a6cb1c3d9a5de5ee35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Equipment and Supplies">
      <data key="d0">Equipment and Supplies</data>
      <data key="d1">category</data>
      <data key="d2">A general term for the various tools, gear, and hive components required for the practice of beekeeping, such as feeders, extractors, and protective clothing.</data>
      <data key="d3">chunk-6550c1217ac242a6cb1c3d9a5de5ee35</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740472</data>
    </node>
    <node id="Extractors/Extracting Method">
      <data key="d0">Extractors/Extracting Method</data>
      <data key="d1">category</data>
      <data key="d2">Equipment (extractors) and the process used to remove liquid honey from the honeycomb by centrifugal force, without destroying the comb.</data>
