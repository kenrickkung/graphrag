      <data key="d0">Juvenile Sex Offenders</data>
      <data key="d1">category</data>
      <data key="d2">A specific high-risk group served by Janus Youth through residential programs designed to support them before and after their time at the state training school.</data>
      <data key="d3">chunk-05be2e4c27c7eabe9de8d2ff56b840a5</data>
