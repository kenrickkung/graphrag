    </edge>
    <edge source="Sun" target="Crops">
      <data key="d6">10.0</data>
      <data key="d7">The sun is essential for growing crops through the process of photosynthesis, which is listed as the sun's first and primary benefit.</data>
      <data key="d8">dependency,photosynthesis,plant growth</data>
      <data key="d9">chunk-2f3d99de4967b60e7e74b3639abc430c</data>
