      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Bottom Board" target="Hive Stand">
      <data key="d6">10.0</data>
      <data key="d7">The primary and essential function of the hive stand is to keep the wooden bottom board off the damp ground, thereby protecting it from moisture and rot.</data>
      <data key="d8">protective function,structural support</data>
      <data key="d9">chunk-2a7084302d57591ff02e89969b4c3abd</data>
