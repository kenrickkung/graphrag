    </node>
    <node id="Centro Agricola">
      <data key="d0">Centro Agricola</data>
      <data key="d1">organization</data>
      <data key="d2">The Centro Agricola is a business incubator and meeting space created by Nuestras Raíces from an abandoned building in Holyoke. It houses various small businesses, including a restaurant, bakery, and Marine Reef Habitat.</data>
      <data key="d3">chunk-7ee782c1d8a631cff4fafc639994eb42</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
    </node>
    <node id="Marine Reef Habitat">
      <data key="d0">Marine Reef Habitat</data>
      <data key="d1">organization</data>
      <data key="d2">Marine Reef Habitat is a business incubated by Nuestras Raíces at the Centro Agricola. Founded by Gerard Ramos, it specializes in saltwater fish tanks and the cultivation of tropical corals, with a mission to help restore reefs in Puerto Rico.</data>
      <data key="d3">chunk-7ee782c1d8a631cff4fafc639994eb42</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740836</data>
