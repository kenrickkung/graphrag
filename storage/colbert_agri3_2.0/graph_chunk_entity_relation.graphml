    </edge>
    <edge source="Crops" target="Heirloom Apples">
      <data key="d6">7.0</data>
      <data key="d7">Heirloom apples are highlighted as a specific, high-demand example of a crop enterprise one could choose to pursue.</data>
      <data key="d8">crop example,market demand</data>
      <data key="d9">chunk-766988b011c2a15c7312ce3e9bb55cf7</data>
