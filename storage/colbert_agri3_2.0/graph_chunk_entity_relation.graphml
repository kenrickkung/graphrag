      <data key="d3">chunk-df880ab4353881f2fe1a61ec533c5679&lt;SEP&gt;chunk-66bbc17b9fd4fb132a3a76abd2df0690</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740810</data>
    </node>
    <node id="Painted Gourds">
      <data key="d0">Painted Gourds</data>
      <data key="d1">category</data>
      <data key="d2">"An example of a value-added product where a raw commodity (gourds) is turned into a different product for a different market, increasing its value."&gt;</data>
      <data key="d3">chunk-df880ab4353881f2fe1a61ec533c5679</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740810</data>
