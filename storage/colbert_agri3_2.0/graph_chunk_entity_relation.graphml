    <node id="Christmas Tree And Firewood Sales">
      <data key="d0">Christmas Tree And Firewood Sales</data>
      <data key="d1">event</data>
      <data key="d2">A seasonal commercial activity at Greensgrow farm during the winter. This is part of Corboy's strategy to attract people to the farm year-round and is an example of 'agri-edu-tainment'.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Blanche's Farm Tour">
      <data key="d0">Blanche's Farm Tour</data>
      <data key="d1">event</data>
      <data key="d2">A fun, educational tour for children at Greensgrow farm. The tour is guided by hand-painted interpretive signs ostensibly authored by Blanche, the farm cat, and covers topics like soil, bugs, and the green roof.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Beehives">
      <data key="d0">Beehives</data>
      <data key="d1">category</data>
      <data key="d2">A set of four beehives located at Greensgrow farm, tucked behind the biodiesel shed. They are managed by Corboy and represent another element of the farm's diverse, sustainable ecosystem.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Philadelphia Restaurant">
      <data key="d0">Philadelphia Restaurant</data>
      <data key="d1">organization</data>
      <data key="d2">An unnamed Philadelphia restaurant known for having the 'best French fries in the city'. This restaurant provides exceptionally high-quality used cooking oil (with a hydration rate of 0.5) to Richter for his biodiesel production.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
    </node>
    <node id="Sustainable Farm Features">
      <data key="d0">Sustainable Farm Features</data>
      <data key="d1">category</data>
      <data key="d2">Educational points of interest on the Greensgrow farm tour, such as the green roof and the composting toilet. These features are highlighted on signs to teach visitors about sustainable practices.</data>
      <data key="d3">chunk-82a428e9ecd2ac447a8293c4680becb2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1753740830</data>
