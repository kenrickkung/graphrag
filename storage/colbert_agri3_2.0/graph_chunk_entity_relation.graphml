      <data key="d10">unknown_source</data>
      <data key="d11">1753740472</data>
    </edge>
    <edge source="Neighbors" target="The Farmer">
      <data key="d6">6.0</data>
      <data key="d7">The farmer is advised to check with neighbors to see what machinery is available to barter for or rent, presenting a cost-effective alternative to purchasing.</data>
