    <node id="The Stockman Grass Farmer">
      <data key="d0">The Stockman Grass Farmer</data>
      <data key="d1">organization</data>
      <data key="d2">A monthly publication providing information on intensive rotational grazing.&lt;SEP&gt;A monthly publication that provides information specifically on intensive rotational grazing.&lt;SEP&gt;An agricultural publication that features articles on farming techniques, such as the articles by Allan Nation about Joel Salatin's methods for pastured egg and pig production.</data>
      <data key="d3">chunk-66bbc17b9fd4fb132a3a76abd2df0690&lt;SEP&gt;chunk-8d6381862167ee0d108723409eae36d3&lt;SEP&gt;chunk-5aeb69db517fc797c325acc9dcb88413</data>
