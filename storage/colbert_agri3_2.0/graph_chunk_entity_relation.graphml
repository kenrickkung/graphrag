      <data key="d10">unknown_source</data>
      <data key="d11">1753740511</data>
    </edge>
    <edge source="Honey Bee" target="Acarapis Woodii">
      <data key="d6">10.0</data>
      <data key="d7">Acarapis woodii, the tracheal mite, is a pest that infests the honey bee.</data>
      <data key="d8">parasitism,pest-host</data>
