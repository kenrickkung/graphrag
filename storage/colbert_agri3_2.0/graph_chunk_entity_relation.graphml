      <data key="d11">1753740886</data>
    </edge>
    <edge source="Diablo Burger" target="Diablo Trust">
      <data key="d6">9.0</data>
      <data key="d7">Diablo Burger was created as a direct strategic outcome of the challenges and goals identified by the Diablo Trust, serving as a market-based solution for the Trust's conservation mission.</data>
      <data key="d8">mission alignment,strategic outcome</data>
      <data key="d9">chunk-e1fa8277818b65f8d3d6665242021ad9</data>
      <data key="d10">unknown_source</data>
      <data key="d11">1753740886</data>
    </edge>
    <edge source="Diablo Burger" target="Widmark">
      <data key="d6">10.0</data>
      <data key="d7">Widmark is the founder and visionary behind Diablo Burger, using the restaurant as a practical application of his philosophy on local food, sustainability, and community.</data>
