    </edge>
    <edge source="Honey Bee" target="Parthenogenesis">
      <data key="d6">10.0</data>
      <data key="d7">Parthenogenesis is the specific reproductive event through which male honey bees develop.</data>
      <data key="d8">biology,reproduction</data>
