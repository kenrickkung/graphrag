    <edge source="The Africanized Bee" target="_Apis mellifera scutellata_">
      <data key="d6">10.0</data>
      <data key="d7">The Africanized bee is a hybrid descendant of the _Apis mellifera scutellata_ subspecies, which escaped and interbred with local bee populations in the Americas.</data>
      <data key="d8">genetic origin,hybridization,progenitor</data>
      <data key="d9">chunk-ee734f0540c7fd5dab112e837ae5a36b</data>
      <data key="d10">unknown_source</data>
