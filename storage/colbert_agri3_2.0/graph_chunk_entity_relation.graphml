    </edge>
    <edge source="Honey Bee" target="Nosema">
      <data key="d6">9.0</data>
      <data key="d7">Nosema is described as an infection of the mid-gut of adult honey bees.</data>
      <data key="d8">host-pathogen,pathology</data>
